CONVERGENCE ()
{ 
  local funo=$fun; fun='CONVERGENCE'; local title=$script': => '\'$fun\'
  local i=$1; local monosep="$2"

  detsigma[i]=`cat $monosep'/'${detectionclone[i]}'.sigma'`; chk_rc

# Constant level is set to 10*SIGMA to ensure that relative corrections at TOLERANCE level (= 1%)
# correspond to the absolute corrections at levels << SIGMA (for small pixel VALUE < 10*SIGMA):
# RELCORR = DELTA / max ( VALUE, 10*SIGMA ) < 0.01 ~=> DELTA < 0.01 * 10*SIGMA ~=> DELTA < 0.1*SIGMA

  'CALCULATE' sigmalevel "10*${detsigma[i]}" 20
  if [[ $istr -le 2 || $istep -eq 1 ]]
  then 
    if [[ ${mfimagemin[i]} == 'undef' ]]
    then 'ERROR' 'Undefind image minimum in convergence checks...'
    fi
    'CALCULATE' subtractvalue "1*${mfimagemin[i]}" 20
  fi
  image=$monosep'/'${detectionclone[i]}'.bg.'$zitcf

# Minimum value of the original detection image must be subtracted, not to affect relative corrections.
# The largest scales must be replaced with a constant level derived from standard deviations outside structures of interest.

  if [[ $istr -le 2 || $istep -eq 1 ]]
  then ($path'/modfits' subtract $subtractvalue $image -o $image'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  else \cp -f $image'.fits' $image'.m.fits' #2>$hell
  fi
  ($path'/modfits' add $sigmalevel $image'.m' -o $image'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'

  if [[ $itcf -gt 1 ]]
  then 
    imageo=$monosep'/'${detectionclone[i]}'.bg.'$zitcfm1
    original=$monosep'/'${detectionclone[i]}

# Minimum value of the original detection image must be subtracted to not affect relative corrections.
# The largest scales must be replaced with a constant level derived from standard deviations outside structures of interest.

    if [[ $istr -le 2 || $istep -eq 1 ]]
    then 
      ($path'/modfits' subtract $subtractvalue $imageo -o $imageo'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/modfits' subtract $subtractvalue $original -o $original'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
    else 
      \cp -f $imageo'.fits' $imageo'.m.fits' #2>$hell
      \cp -f $original'.fits' $original'.m.fits' #2>$hell
    fi
    ($path'/modfits' add $sigmalevel $imageo'.m' -o $imageo'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
    ($path'/modfits' add $sigmalevel $original'.m' -o $original'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'

# Compute relative corrections in pixel values between two consequitive iterations.

    ($path'/operate' $imageo'.m' - $image'.m' -o $image'.r' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
    ($path'/operate' $image'.r' % $original'.m' -o $image'.r' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
    ($path'/operate' $image'.r' x ${imageomask[i]} -o $image'.r' $verb; echo $? > '.rc'$cwavenum) | 'tehi'

# Evaluate maximum value of relative differences over all pixels.
# NOTE that the median filtering does not use obsmask to make sure the sliding window does not shrink at the omask edges.
# Pixels near omask edges are noisy (unimportant anyway) and it's better to underestimate relative differences there.

    'CALCULATE' radiusmed "2*${beam[i]}/$dxas" 20
    ($path'/imgstat' median $radiusmed $image'.r' -o $image'.r' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
    ($path'/imgstat' savein -nomed $image'.r' ${imageomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
    read -r min imgmaxdif mea med totsum sig skew kurt nonzmin edgem < '.+imgstat2'$cwavenum; chk_rc

    maxcorr=$tolerance
    'COMPARE_FLOATS' $imgmaxdif '<' $maxcorr rcsmall
    if [[ $rcsmall -eq 1 ]]
    then iterationsdone='yes'
    else iterationsdone='no'
    fi
    'ROUND_FLOAT' 4 $imgmaxdif imgmaxdif
  else
    imgmaxdif=0
    maxcorr=0
  fi
  
  if [[ $savespace -eq 2 ]]
  then
    \rm -f $imageo'.m.fits' 2>$hell
    \rm -f $imageo'.r.fits' 2>$hell
    \rm -f $original'.m.fits' 2>$hell
  fi

  fun=$funo
}

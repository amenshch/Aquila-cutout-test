CALCULATE ()  #<~ Not this function should be able to use both scientific and fixed notation
{
  local funo=$fun; fun='CALCULATE'
  if [[ $3 == "" ]]
  then 'ERROR' 'Too few parameters: "'$1'" "'$2'" "'$3'"'
  fi
  local expression=$2; local ndigits=$3; local result; local y

  expression="${expression// /}"  #<~ remove (illegal) empty spaces that may be present in the input expression

# Find and replace all scientific notation tokens within an arbitrary expression string:

  expression=$(echo "$expression" | awk '{
      while (match($0, /[0-9]*\.?[0-9]+[eE][+-]?[0-9]+/)) {
          printf "%s", substr($0, 1, RSTART-1)
          val = substr($0, RSTART, RLENGTH)
          printf "%.42f", val+0
          $0 = substr($0, RSTART+RLENGTH)
      }
      print
  }')
  'POSITION' 'e(' $expression nexp
  'POSITION' 'l(' $expression nlog
  'POSITION' 's(' $expression nsin
  'POSITION' 'c(' $expression ncos

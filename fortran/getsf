MEASURE_DETECTIONS ()
{                          
  local funo=$fun; fun='MEASURE_DETECTIONS'; local title=$script': => ('$istep') '\'$fun\'
  local i; local j; local k; local kk; local l; local kp1; local sign1=''; local sign2=''; local sign3=''
  local signsm=''; local sign1old=''; local sign2old=''; local sign3old=''; local iterlimit1=0; local iterlimit2=0
  local whatmea="$1"

  if [[ $measure == "no" || ($sources == 'no' && $filaments == 'no') || \
       ($sources == 'no' && $whatmea == 'sources') || ($filaments == 'no' && $whatmea == 'filaments') ]]
  then 
    if [[ $sources == 'yes' && $whatmea == 'sources' || $sources == 'no' && $whatmea == 'filaments' ]]
    then printlh; printlh ' '"$title"' ~~> skipping...'
    fi
    fun=$funo; return 0
  else printlh; printlh ' '"$title"' '$whatmea
  fi
  measure_beg=`date +%s`; cdate=`date +%d\ %b\ %Y\ %a\ %H:%M:%S\ %Z`

  for (( i=1; i <= $nwaves; i++ ))
  do
    'CALCULATE' npradmf[i] "1*${beam[i]}/$dxas" 20
##    npradmf[i]='0'
  done

# Measure sources.

  if [[ $whatmea == "sources" ]]
  then
    logfootit='+log.FOOTS.iter'
    logfootnew='+log.FOOTS.new.iter'
    logfootbak='+log.FOOTS.bak.iter'
  
    'LEADZEROS' 1 $itermax zitermax
    allwaves=''; allsrcmaxsizes=''
##    printlh

    for (( i=1; i <= $nwaves; i++ ))
    do
      if [[ "${imagetype[i]}" == "Herschel" ]]
      then allwaves=$allwaves' +'${wave[i]}
      else allwaves=$allwaves' '${wave[i]}
      fi
      allsrcmaxsizes=$allsrcmaxsizes' '${srcmaxsize[i]}
      if [[ -e '+wave.'${wave[i]}'.done' ]]
      then \rm -f '+wave.'${wave[i]}'.done' 2>$hell
      fi
##      printlh ' Processing …/'${separated/$currentroot\//}'/'${detectionclone[i]}'.'$whatmea'.fits...'
    done

# Measurements are done on these images.
# Special image can be used in measurements for testing and improving.

    for (( i=1; i <= $nwaves; i++ ))
    do
      if [[ -e ${imagepath[i]}'/'${obsimage[i]}'.special.fits' ]]
      then
        printlh ' WARNING: Using for measurements: '${obsimage[i]}'.special.fits...'
        \cp -f ${imagepath[i]}'/'${obsimage[i]}'.special.fits' ${measuremtclone[i]}'.fits' #2>$hell
      else
        imageformeasurements=${imagepath[i]}'/'${obsimage[i]}
##        imageformeasurements=${measuremtclone[i]}'.sources.n'
        \cp -f $imageformeasurements'.fits' ${measuremtclone[i]}'.fits' #2>$hell
      fi
      cleanback[i]=${measuremtclone[i]}'.cb'
      bgsubtrac[i]=${measuremtclone[i]}'.bs'
      cleanbacksrcn[i]=${measuremtclone[i]}'.sources.n.cb'
      \cp -f $separated'/'${measuremtclone[i]}'.sources.n'${zsrcmaxsize[i]}'.fits' . #2>$hell
    done
    
# Decompose detection images of the source component to evaluate (in SMEASURE) monochromatic significances of detected sources.

    for (( i=1; i <= $nwaves; i++ ))
    do
      justname=`basename "${separateso[i]}"`
      filesep[i]=${dirmono[i]}'/'$justname
      nsbeamsd=$nsbeams

      'READ_SEPARATION_FILE' ${filesep[i]}
      'READ_DECOMPOSE_FILE' ${decompose[i]}

      if [[ $istepo -ne $istep || $whato != $whatmea || $nsbeams -lt $nsbeamsd || $filesexist == 'no' ]]
      then
        nsbeams=$nsbeamsd
        processimage=$separated'/'${detectionclone[i]}'.'$whatmea''${zsrcmaxsize[i]}'.fits'
        \cp -f $processimage ${detectionclone[i]}'.fits' #2>$hell

        'DECOMPOSE_IMAGES' $i 'sources' ${detectionclone[i]}; chk_rc
      fi
    done
  
    for (( i=1; i <= $nwaves; i++ ))
    do
      if [[ $nwaves -eq 1 ]]; then iw=''; else iw=$i; fi
      image=${detectionclone[i]}

      'READ_SEPARATION_FILE' ${filesep[i]}

      for (( j=$nsbeg; j <= $nsbeams; j++ ))
      do
        if [[ $verb == "-verb0" ]]
        then 
          outsameline='yes'
          'PROGRESS_BAR' "PREPARING SRCIMAGE $iw" $j $nsbeg $nsbeams 79 "·"
        fi 
        'CALCULATE' thresh "1.001*$nsigmacombos*${onesigma[j]}" 20
        sscimagej=${dirmono[i]}'/'${detectionclone[i]}'.'${nscbeam[j]}
        ($path'/modfits' minimum $thresh y $sscimagej -o $sscimagej $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      done

      if [[ $verb == "-verb0" ]]
      then 
        'PROGRESS_BAR' 'complete' $nsbeams $nsbeg $nsbeams 79 "·"; outsameline='no'
      fi
    done

    unrotated='sm.'$prefix$dotsw'.det.unrotated.fits'
    accufoots='sm.'$prefix$dotsw'.det.footprints.fits'
    swcatname='sm.'$prefix$dotsw'.det.cat'
    coordfile='sm.'$prefix$dotsw'.det.wcs'
    filecombo=$prefix$dotsw'.det.combined'

    if [[ ! -e $swcatname ]]
    then visualizing='no'
       printlh; printlh ' WARNING: Detection catalog not found; no source measurements...'; fun=$funo; return 0
    fi
  
# Compute real WCS coordinates using the XY2SKY utility from WCSTOOLS.
    
    if [[ $wcstools == "yes" ]]
    then 'xy2sky' -dj -k 8 -n 7 $unrotated '@'$swcatname > $coordfile; chk_rc
    else \rm -f $coordfile 2>$hell
    fi
    if [[ $sproima == "yes" ]]
    then
      \rm -f -R $sprofiles 2>$hell; \mkdir -p $sprofiles 2>$hell
      \rm -f -R $srcimages 2>$hell; \mkdir -p $srcimages 2>$hell
    fi
    if [[ $savespace -eq 0 ]]
    then \rm -f -R $annuli 2>$hell; \mkdir -p $annuli 2>$hell
    fi
    catsallwaves=''
    beamallwaves=''
    allfootexpanded='no'
    
    for (( i=1; i <= $nwaves; i++ ))
    do
      catsallwaves=$catsallwaves' '${smfcatname[i]}
      beamallwaves=$beamallwaves' '${beam[i]}
      'CLEAR_IMAGE_BORDERS' border 2 ${imageomask[i]} ${imagebsomask[i]}; chk_rc

      if [[ -e ${monobkups[i]}'/'${obsfootprints[i]} ]]
      then
        if [[ $verb != "-verb0" ]]
        then printlh; printlh ' Restoring '${obsfootprints[i]}'...'
        fi
        \cp -f ${monobkups[i]}'/'${obsfootprints[i]}'.fits' ${obsfootprints[i]}'.fits' #2>$hell
      fi
      if [[ -e ${monobkups[i]}'/'${measuremtclone[i]}'.fits' ]]
      then
        if [[ $verb != "-verb0" ]]
        then printlh; printlh ' Restoring '${measuremtclone[i]}'.fits...'
        fi
        \cp -f ${monobkups[i]}'/'${measuremtclone[i]}'.fits' ${measuremtclone[i]}'.fits' #2>$hell
      fi
      if [[ -e ${monobkups[i]}'/'${detectionclone[i]}'.fits' ]]
      then
        if [[ $verb != "-verb0" ]]
        then printlh; printlh ' Restoring '${detectionclone[i]}'.fits...'
        fi
        \cp -f ${monobkups[i]}'/'${detectionclone[i]}'.fits' ${detectionclone[i]}'.fits' #2>$hell
      fi
      if [[ -e ${monobkups[i]}'/'${smfcatname[i]} ]]
      then
        if [[ $verb != "-verb0" ]]
        then printlh; printlh ' Restoring '${smfcatname[i]}'...'
        fi
        \cp -f ${monobkups[i]}'/'${smfcatname[i]} ${smfcatname[i]} #2>$hell
      fi
      \rm -f '+wave.'${wave[i]}'.foot' 2>$hell
      \rm ${smfcatname[i]/.cat/.previous.cat} 2>$hell
    done
    
# Create background-subtracted image from the measurement image using footprints and compute fluxes and sizes.
# Starting brand new iterations from scratch (iterbeg=1).
  
    'CALCULATE' reldiffx "$reldiffmax*2" 2
    
    if [[ $iterbeg -eq 1 ]]
    then
      sign1='+'; iter=1; 'LEADZEROS' 1 $iter ziter
  
      if [[ $verb == "-verb0" ]]
      then 'PROGRESS_BAR' "MEASURING SOURCES" $iter 1 $itermax 79 "·"; outsameline='yes'
      fi
      if [[ $verb != "-verb0" ]]
      then
        printlh ' _______________________________________________'
        printlh
        printlh ' '$script': '$fun': ITERATION 01/'$zitermax
        printlh ' _______________________________________________'
      fi
      
      for (( i=1; i <= $nwaves; i++ ))
      do
        \rm -f $srciterate'/'*'.'${wave[i]}'.'* 2>$hell
        ($path'/operate' ${imagebsomask[i]} x $accufoots -o ${detfootprints[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'

# The images below will be used in measurements.

        if [[ $bgclean == 'yes' ]]
        then
          ($path'/expanda' 1 ${measuremtclone[i]} ${imageomask[i]} -o ${cleanback[i]}'.ea' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/cleanbg' ${npradmf[i]} ${cleanback[i]}'.ea' ${detfootprints[i]} -o ${cleanback[i]} \
                           $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/expanda' 1 ${measuremtclone[i]}'.sources.n'${zsrcmaxsize[i]} ${imageomask[i]} -o ${cleanback[i]}'.ea' \
                           $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/cleanbg' ${npradmf[i]} ${cleanback[i]}'.ea' ${detfootprints[i]} -o ${cleanbacksrcn[i]} \
                           $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        else
          'CREATE_BG_MASKS' ${detfootprints[i]} ${detfootprints[i]}'.b' ${imageomask[i]}; chk_rc
          ($path'/operate' ${measuremtclone[i]} x ${detfootprints[i]}'.b' -o ${cleanback[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        fi
        ($path'/operate' ${measuremtclone[i]} - ${cleanback[i]} -o ${bgsubtrac[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/operate' ${imageomask[i]} x ${cleanback[i]} -o ${cleanback[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/operate' ${imageomask[i]} x ${bgsubtrac[i]} -o ${bgsubtrac[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'

        \rm -f ${cleanback[i]}'.ea.fits' 2>$hell
      
        ($path'/smeasure' $distancepc $smp${wave[i]} ${beam[i]} ${apcorrect[i]} $sign1$nsigmacombos $nsigmacombos $nwavesdetect \
                          $factortotal $extractiondir ${dirmono[i]} ${measuremtclone[i]} $swcatname -o ${smfcatname[i]} \
                          $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      done

# Produce semifinal and final source catalogs for all waves and correct footprints.

      ($path'/finalcat' $sign1$nsigmacombos $goodmin $snratio1min $snratio2min "0$nwavesdetect" $factortotal $reldiffx \
                        $extractiondir $catsallwaves $allwaves $beamallwaves $allsrcmaxsizes -o $finalcatalog \
                        $verb; echo $? > '.rc'$cwavenum) | 'tehi' nocheck; rc=$?

      rcfinalcat=$rc; chk_rc $rcfinalcat; if [[ -e '.converged' ]]; then rcfinalcat=9; \rm '.converged'; fi
      
# Store iterations.

      for (( i=1; i <= $nwaves; i++ ))
      do
        \mkdir -p $srciterate 2>$hell
        \cp -f ${smfcatname[i]} $srciterate'/sm.'$prefix$dotsw'.'${wave[i]}'.obs.smf.'$ziter'.cat' #2>$hell
        if [[ -e ${detectionclone[i]}'.fpeak.deblending.dat' ]]
        then \mv -f ${detectionclone[i]}'.fpeak.deblending.dat' $srciterate'/'${detectionclone[i]}'.fpeak.deblending.'$ziter'.dat' #2>$hell
        fi
##        \mv -f ${dirmono[i]}'/'${detectionclone[i]}'.fpeak.deblending.dat' $srciterate #2>$hell
        finalcatalogok=${finalcatalog/.cat/.ok.cat}
        \cp -f $finalcatalog $srciterate'/'${finalcatalog/.cat/.$ziter.cat} #2>$hell
        \cp -f $finalcatalogok $srciterate'/'${finalcatalogok/.cat/.$ziter.cat} #2>$hell
##        \cp -f ${obsfootprints[i]}'.fits' $srciterate'/'${obsfootprints[i]}'.'$ziter'.fits' #2>$hell
      done
    else
      if [[ $iterbeg -gt 1 && ! -e $logfootit ]]
      then 'ERROR' 'Logfile for measurements not found: '$logfootit \
                   'Verify that the restart iteration '$iterbeg' has been completed.'
      fi
      iterbegx=$(( iterbeg - 1 ))
      l=0
      {
      while read -r logfootitline
      do
        read -r -a words <<< "$logfootitline"
        footprintsiter=${words[0]}
        literphase=${words[3]}
        l=$(( l + 1 ))
        if [[ ${footprintsiter:0:1} == "#" ]]
        then
          if [[ $l -eq 1 ]]
          then print "$logfootitline" >  $logfootnew
          else print "$logfootitline" >> $logfootnew
          fi
        else
          iterbeg=${footprintsiter:0:2}
          if [[ $iterbeg -le 9 ]]
          then print "   $logfootitline" >> $logfootnew
          else print  "  $logfootitline" >> $logfootnew
          fi                             
          if [[ $iterbeg -eq $iterbegx ]]
          then 
            read -r logfootitline
            read -r -a words <<< "$logfootitline"
            literphase=${words[3]}
            if [[ $literphase == "2" && $iterlimit1 -eq 0 ]]
            then iterlimit1=$iterbeg
            fi
            if [[ $literphase == "3" && $iterlimit2 -eq 0 ]]
            then iterlimit2=$iterbeg
            fi
            break
          fi
        fi
      done
      } < $logfootit
      \mv -f $logfootit $logfootbak #2>$hell
      \mv -f $logfootnew $logfootit #2>$hell
      \mkdir -p ${monobkups[i]} 2>$hell
      backtimestamp=`date +%y%m%d.%H%M%S`
      \mv -f ${monobkups[i]}'/'$logfootbak ${monobkups[i]}'/'$logfootbak'.'$backtimestamp #2>$hell
      \mv -f $logfootbak ${monobkups[i]} #2>$hell
  
# Continue measurements from some intermediate iteration 'iterbeg' > 1. Restore some necessary files.
                         
      for (( iter=1; iter <= $iterbeg; iter++ ))
      do
        if [[ $verb == "-verb0" ]]
        then 'PROGRESS_BAR' "MEASURING SOURCES" $iter 1 $itermax 79 "·"
        fi
      done
      
      if [[ $verb != "-verb0" ]]
      then printlh
      fi
      iter=$iterbeg
      iterm1=$(( iter - 1 ))
      'LEADZEROS' 1 $iter ziter
      'LEADZEROS' 1 $iterm1 ziterm1
  
      for (( i=1; i <= $nwaves; i++ ))
      do
##        if [[ ${aperture[i]:0:1} == "+" || ${aperture[i]:0:1} == "-" ]]
##        then obsfootprintsiter=${obsfootprinta[i]}'.'$ziter'.fits'
        obsfootprintsiter=${obsfootprints[i]}'.'$ziter'.fits'
##        fi
        if [[ ! -e $srciterate'/'$obsfootprintsiter ]]
        then 'ERROR' 'Restart file for measurements not found: '$srciterate'/'$obsfootprintsiter \
                     'Verify that the iteration '$iterbeg' has been completed.'
        fi
##        if [[ ${aperture[i]:0:1} == "+" || ${aperture[i]:0:1} == "-" ]]
##        then 
##          if [[ $verb != "-verb0" ]]
##          then printlh ' Restoring '$obsfootprintsiter' => '${obsfootprinta[i]}'.fits...'
##          fi
##          \cp -f $srciterate'/'$obsfootprintsiter ${obsfootprinta[i]}'.fits' #2>$hell
##        else 
        if [[ $verb != "-verb0" ]]
        then printlh ' Restoring '$obsfootprintsiter' => '${obsfootprints[i]}'.fits...'
        fi
        \cp -f $srciterate'/'$obsfootprintsiter ${obsfootprints[i]}'.fits' #2>$hell
##        fi
      done
      if [[ $verb != "-verb0" ]]
      then printlh
      fi
      for (( i=1; i <= $nwaves; i++ ))
      do
        smfcatalogiter=${smfcatname[i]/.cat/.$ziter.cat}
        smfcatalogiterm1=${smfcatname[i]/.cat/.$ziterm1.cat}
        if [[ ! -e $srciterate'/'$smfcatalogiter ]]
        then 'ERROR' 'Restart file for measurements not found: '$srciterate'/'$smfcatalogiter \
                     'Verify that the iteration '$iterbeg' has been completed.'
        fi
        if [[ $verb != "-verb0" ]]
        then printlh ' Restoring '$smfcatalogiter' => '${smfcatname[i]}'...'
        fi
        \cp -f $srciterate'/'$smfcatalogiter ${smfcatname[i]} #2>$hell
        if [[ $verb != "-verb0" ]]
        then printlh ' Restoring '$smfcatalogiterm1' => '${smfcatname[i]/.cat/.previous.cat}'...'
        fi
        \cp -f $srciterate'/'$smfcatalogiterm1 ${smfcatname[i]/.cat/.previous} #2>$hell
      done
      rcfinalcat=0
    fi
  
    iterbeg=$(( iterbeg + 1 ))
    if [[ $iterlimit1 -eq 0 ]]
    then 
      'CALCULATE' iterlimit1 "(1/3)*$itermax+1" 2
      'ROUND_FLOAT' 0 $iterlimit1 iterlimit1
    fi
    if [[ $iterlimit2 -eq 0 ]]
    then 
      'CALCULATE' iterlimit2 "(2/3)*$itermax+1" 2
      'ROUND_FLOAT' 0 $iterlimit2 iterlimit2
    fi
    iterlimit1p2=$(( iterlimit1 + 2 ))
    iterlimit2p2=$(( iterlimit2 + 2 ))
    'CALCULATE' reldiffx "2*$reldiffmax" 2
    
    for (( iter=$iterbeg; iter <= $itermax; iter++ ))
    do
      if [[ $verb == "-verb0" ]]
      then 'PROGRESS_BAR' "MEASURING SOURCES" $iter 1 $itermax 79 "·"
      fi
      iterm1=$(( iter - 1 ))
      'LEADZEROS' 1 $iter ziter
      'LEADZEROS' 1 $iterm1 ziterm1
  
      if [[ $verb != "-verb0" ]]
      then
        printlh ' _______________________________________________'
        printlh
        printlh ' '$script': '$fun': ITERATION '$ziter'/'$zitermax
        printlh ' _______________________________________________'
      fi

      allfootexpanded='yes'
      for (( i=1; i <= $nwaves; i++ ))
      do 
        if [[ ! -e '+wave.'${wave[i]}'.foot' ]]
        then 
          allfootexpanded='no'
        else
          nlines=$(echo $(wc -l < '+wave.'${wave[i]}'.foot'))
          if [[ $nlines -eq 1 ]]
          then print 'on the measurement iteration #'$ziterm1 >> '+wave.'${wave[i]}'.foot'
          fi
        fi
      done
      
# Parameters telling FINALCAT what to do.
                             
      if [[ $iter -le $iterlimit1 ]]      #!<== PHASE 1 === (sign1='+')
      then
        sign1='+'
        if [[ $rcfinalcat -eq 9 ]]
        then sign1='-'; sign2='+'; iterlimit1=$iter; iterlimit1p2=$(( iterlimit1 + 2 ))
        fi
      else
        if [[ $iter -le $iterlimit2 ]]    #!<== PHASE 2 === (sign2='+')
        then
          sign1='-'; sign2='+'
          if [[ ($rcfinalcat -eq 9 && $iter -gt $iterlimit1p2) ]]
          then sign2='-'; sign3='+'; iterlimit2=$iter; iterlimit2p2=$(( iterlimit2 + 2 )); reldiffx=$reldiffmax
          fi
        else                              #!<== PHASE 3 === (sign3='+')
          sign1='-'; sign2='-'; sign3='+'
          if [[ ($rcfinalcat -eq 9 && $iter -gt $iterlimit2p2 && $allfootexpanded == 'yes') || $iter -eq $itermax ]]
          then sign3='-'
          fi                  
          reldiffx=$reldiffmax
        fi
      fi
      signsm=$sign2
      if [[ $sign3 == "-" ]]
      then
        if [[ $sproima == "yes" ]]; then sign2='+'; fi
        if [[ $savespace -eq 0  ]]; then signsm='+'; fi
      fi
      if [[ ($sign1 == "+" && $sign1old != "+") || ($sign2 == "+" && $sign2old != "+") || ($sign3 == "+" && $sign3old != "+") ]]
      then
        for (( i=1; i <= $nwaves; i++ ))
        do 
          \rm -f '+wave.'${wave[i]}'.done' 2>$hell
        done
      fi
      
# Background subtraction (and measurements) under apertures is now possible.
    
      for (( i=1; i <= $nwaves; i++ ))
      do
        if [[ ! -e '+wave.'${wave[i]}'.done' || $sign3 == "-" ]]  # sign3 = '-' means finishing mode (very last pass in PHASE 3)
        then
##          if [[ $sign3 == "-" && ${aperture[i]:0:1} == "+" ]]
##          then obsfoots=${obsfootprinta[i]}
          obsfoots=${obsfootprints[i]}
##          fi
##          if [[ ${aperture[i]:0:1} == "+" || ${aperture[i]:0:1} == "-" ]]
##          then ($path'/operate' ${imagebsomask[i]} x ${obsfootprinta[i]} -o ${obsfootprinta[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
##          fi
          ($path'/operate' ${imagebsomask[i]} x ${obsfootprints[i]} -o ${obsfootprints[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'

# The images below will be used in measurements.

          if [[ $bgclean == 'yes' ]]
          then
            ($path'/expanda' 1 ${measuremtclone[i]} ${imageomask[i]} -o ${cleanback[i]}'.ea' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
            ($path'/cleanbg' ${npradmf[i]} ${cleanback[i]}'.ea' $obsfoots -o ${cleanback[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
            ($path'/expanda' 1 ${measuremtclone[i]}'.sources.n'${zsrcmaxsize[i]} ${imageomask[i]} -o ${cleanback[i]}'.ea' \
                             $verb; echo $? > '.rc'$cwavenum) | 'tehi'
            ($path'/cleanbg' ${npradmf[i]} ${cleanback[i]}'.ea' $obsfoots -o ${cleanbacksrcn[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          else
            'CREATE_BG_MASKS' $obsfoots $obsfoots'.b' ${imageomask[i]}; chk_rc
            ($path'/operate' ${measuremtclone[i]} x $obsfoots'.b' -o ${cleanback[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          fi
          ($path'/operate' ${measuremtclone[i]} - ${cleanback[i]} -o ${bgsubtrac[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/operate' ${imageomask[i]} x ${cleanback[i]} -o ${cleanback[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/operate' ${imageomask[i]} x ${bgsubtrac[i]} -o ${bgsubtrac[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'

          \rm -f ${cleanback[i]}'.ea.fits' 2>$hell
      
          ($path'/smeasure' $distancepc $smp${wave[i]} ${beam[i]} ${apcorrect[i]} $sign1$nsigmacombos $signsm$nsigmacombos \
                            $sign3$nwavesdetect $factortotal $extractiondir ${dirmono[i]} ${measuremtclone[i]} ${smfcatname[i]} \
                            -o ${smfcatname[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'

# Do the next block only in a finishing mode.

          if [[ $sign3 == '-' ]]
          then
            'CALCULATE' smoobm2 "$beammax*$beammax-${beam[i]}*${beam[i]}" 20
            'COMPARE_FLOATS' $smoobm2 '<=' '0' rslt
            if [[ $rslt -eq 1 ]]
            then
              if [[ $verb != "-verb0" ]]
              then printlh; printlh ' Copying '${cleanback[i]}'.fits to '${cleanback[i]}'.smo.fits...'
              fi
              \cp -f ${cleanback[i]}'.fits' ${cleanback[i]}'.smo.fits' #2>$hell
            else
              'CALCULATE' smoobm "sqrt($smoobm2)" 20
              'CALCULATE' addpx "2*$smoobm/$dxas" 20
              'ROUND_FLOAT' 0 $addpx addpx
              'CONVOLVE_IMAGE' expand border 0 $addpx $smoobm ${cleanback[i]} ${cleanback[i]}'.smo' ${imageomask[i]}; chk_rc
            fi
            ($path'/operate' ${imageomask[i]} x ${cleanback[i]}'.smo' -o ${cleanback[i]}'.smo' $verb; echo $? > .rc) | 'tehi'
          fi
        fi
      done
  
      ($path'/finalcat' $sign1$nsigmacombos $sign2$goodmin $sign3$snratio1min $snratio2min $nwavesdetect $factortotal $reldiffx \
                        $extractiondir $catsallwaves $allwaves $beamallwaves $allsrcmaxsizes -o $finalcatalog \
                        $verb; echo $? > '.rc'$cwavenum) | 'tehi' nocheck; rc=$?

      rcfinalcat=$rc; chk_rc $rcfinalcat; if [[ -e '.converged' ]]; then rcfinalcat=9; \rm -f '.converged' 2>$hell; fi
  
# Store iterations.
  
      for (( i=1; i <= $nwaves; i++ ))
      do
        \mkdir -p $srciterate 2>$hell
        finalcatalogok=${finalcatalog/.cat/.ok.cat}
        \cp -f $finalcatalog $srciterate'/'${finalcatalog/.cat/.$ziter.cat} #2>$hell
        \cp -f $finalcatalogok $srciterate'/'${finalcatalogok/.cat/.$ziter.cat} #2>$hell
        \cp -f ${smfcatname[i]} $srciterate'/sm.'$prefix$dotsw'.'${wave[i]}'.obs.smf.'$ziter'.cat' #2>$hell
##        \cp -f ${smfcatname[i]} $srciterate'/'${smfcatname[i]/.cat/.$ziter.cat} 2>$hell
        if [[ -e 'sm.'${wave[i]}'.foot.expansion.dat' ]]
        then \mv -f 'sm.'${wave[i]}'.foot.expansion.dat' $srciterate'/sm'$dotsw'.'${wave[i]}'.foot.expansion.'$ziter'.dat' #2>$hell
        fi
        if [[ -e 'sm.'${wave[i]}'.fpeak.deblending.dat' ]]
        then \mv -f 'sm.'${wave[i]}'.fpeak.deblending.dat' $srciterate'/sm'$dotsw'.'${wave[i]}'.fpeak.deblending.'$ziter'.dat' #2>$hell
        fi
        if [[ -e ${dirmono[i]}'/'*'.fpeak.deblending.dat' ]]
        then \mv -f ${dirmono[i]}'/'*'.fpeak.deblending.dat' $srciterate #2>$hell
        fi
        \cp -f $srciterate'/sm.'$prefix$dotsw'.'${wave[i]}'.obs.smf.'$ziterm1'.cat' ${smfcatname[i]/.cat/.previous.cat} #2>$hell
        \cp -f ${obsfootprints[i]}'.fits' $srciterate'/'${obsfootprints[i]}'.'$ziter'.fits' #2>$hell
        \rm -f $srciterate'/'${obsfootprints[i]}'.'$ziterm1'.fits' 2>$hell
      done
  
      if [[ $iter -lt $itermax || $rcfinalcat -eq 9 ]]
      then 
        if [[ $sign3 == "-" ]]
        then 
          if [[ $verb != "-verb0" ]]
          then
            printlh ' __________________________________________________________'; printlh
            if [[ $iter -eq 1 ]]
            then printlh ' '$script': '$fun': CONVERGED IN '$ziter' ITERATION'
            else printlh ' '$script': '$fun': CONVERGED IN '$ziter' ITERATIONS'; fi
            printlh ' __________________________________________________________'
          fi
          break
        fi
      else
        if [[ $verb != "-verb0" ]]
        then
          printlh ' __________________________________________________________________'
          printlh
          printlh ' '$script': '$fun': NO CONVERGENCE AFTER '$ziter' ITERATIONS'
          printlh ' __________________________________________________________________'
        fi
      fi
      sign1old=$sign1
      sign2old=$sign2
      sign3old=$sign3
    done
  
    if [[ $verb == "-verb0" ]]
    then 'PROGRESS_BAR' 'complete' $iter 1 $itermax 79 "·"; outsameline='no'
    fi

    \mkdir -p $components 2>$hell
    \mkdir -p $srcvisuals 2>$hell

    for (( i=1; i <= $nwaves; i++ ))
    do
      \cp -f ${imagepath[i]}'/'${obsimage[i]}'.fits' $components'/'${measuremtclone[i]}'.fits' #2>$hell
      \cp -f ${measuremtclone[i]}'.bs.fits' $components'/'${measuremtclone[i]}'.obs.sources'${zsrcmaxsize[i]}'.fits' #2>$hell
      \cp -f ${measuremtclone[i]}'.cb.fits' $components'/'${measuremtclone[i]}'.sbackground'${zsrcmaxsize[i]}'.fits' #2>$hell
##      ($path'/operate' ${measuremtclone[i]}'.cb' + $separated'/'${measuremtclone[i]}'.sbackground.n' \
##                    -o $components'/'${measuremtclone[i]}'.sbackground' $verb; echo $? > '.rc'$cwavenum) | 'tehi'

      \cp -f ${measuremtclone[i]}'.fits' $srcvisuals'/'$prefix$dotsw'.'${wave[i]}'.obs.fits' #2>$hell
##      \cp -f ${measuremtclone[i]}'.fits' $srcvisuals'/'$prefix$dotsw'.'${wave[i]}'.obs.foo.fits' 2>$hell
    done

# Move extraction results in a directory.
  
    \mkdir -p $catalogs 2>$hell
    \mv -f $prefix$dotsw'.sources.cat'        $catalogs #2>$hell
    \mv -f $prefix$dotsw'.sources.ok.cat'     $catalogs #2>$hell
    \mv -f $prefix$dotsw'.sources.ok.add.cat' $catalogs #2>$hell
##    \mv -f $prefix$dotsw'.sources.col.cat'    $catalogs #2>$hell
    \cp -f 'sm.'$prefix$dotsw'.det.cat'       $catalogs #2>$hell

    for (( i=1; i <= $nwaves; i++ ))
    do
      \mv -f $prefix'.'${wave[i]}'.obs.chisq.dat' $catalogs'/'$prefix$dotsw'.obs.'${wave[i]}'.chisq.dat' #2>$hell
      \mv -f $prefix'.'${wave[i]}'.fitshapes.bground.fits' $srcvisuals'/'$prefix$dotsw'.'${wave[i]}'.fitshapes.bground.fits' #2>$hell
      \mv -f $prefix'.'${wave[i]}'.fitshapes.sources.fits' $srcvisuals'/'$prefix$dotsw'.'${wave[i]}'.fitshapes.sources.fits' #2>$hell
      \mv -f $prefix'.'${wave[i]}'.fitshapes.res.mean.fits' $srcvisuals'/'$prefix$dotsw'.'${wave[i]}'.fitshapes.res.mean.fits' #2>$hell
      \mv -f $prefix'.'${wave[i]}'.fitshapes.res.true.fits' $srcvisuals'/'$prefix$dotsw'.'${wave[i]}'.fitshapes.res.true.fits' #2>$hell
##      \mv -f $prefix'.'${wave[i]}'.det.cb.fits' $srcvisuals'/'$prefix$dotsw'.'${wave[i]}'.det.cb.fits' #2>$hell
      \mv -f $prefix'.'${wave[i]}'.obs.cb.fits' $srcvisuals'/'$prefix$dotsw'.'${wave[i]}'.obs.cb.fits' #2>$hell
##      \mv -f $prefix'.'${wave[i]}'.det.bs.fits' $srcvisuals'/'$prefix$dotsw'.'${wave[i]}'.det.bs.fits' #2>$hell
      \mv -f $prefix'.'${wave[i]}'.obs.bs.fits' $srcvisuals'/'$prefix$dotsw'.'${wave[i]}'.obs.bs.fits' #2>$hell
##      \mv -f $prefix'.'${wave[i]}'.det.cb.smo.fits' $srcvisuals'/'$prefix$dotsw'.'${wave[i]}'.det.cb.smo.fits' #2>$hell
      \mv -f $prefix'.'${wave[i]}'.obs.cb.smo.fits' $srcvisuals'/'$prefix$dotsw'.'${wave[i]}'.obs.cb.smo.fits' #2>$hell
      \mv -f 'sm.'$prefix'.'${wave[i]}'.det.foots.fits' $srcvisuals'/sm.'$prefix$dotsw'.'${wave[i]}'.det.foots.fits' #2>$hell
      \mv -f 'sm.'$prefix'.'${wave[i]}'.obs.foots.fits' $srcvisuals'/sm.'$prefix$dotsw'.'${wave[i]}'.obs.foots.fits' #2>$hell
      \cp -f 'sm.'$prefix'.'${wave[i]}'.obs'*'smf'*'.cat' $srciterate #2>$hell
      \rm -f ${dirmono[i]}'/'*'.c'??????'as.fits' 2>$hell
    done
  fi
  
# Measure filaments.

  if [[ $whatmea == "filaments" ]]
  then
    cleansk1='12'
    'SKELETON_LEVELS'
    'FILAMENT_SCALES' $beammincombofil $filmaxsizemax

    'CALCULATE' imgmaxsizex "${sbeam[nsbeams]}/2" 20
    'COMPARE_FLOATS' $imgmaxsizex '<=' $beammincombofil rslt
    if [[ $rslt -eq 1 ]]
    then imgmaxsizex=$beammincombofil
    fi
    \mkdir -p $components 2>$hell
    
    for (( i=1; i <= $nwaves; i++ ))
    do
##      \mkdir -p $skeletons'/+globals/'${zfilmaxsize[i]/.s/max} 2>$hell
      \mkdir -p ${filmeasure[i]} 2>$hell

      'READ_DECOMPOSE_FILE' ${decompose[i]}

      if [[ -e ${monofback[i]}'/'${detectionclone[i]}'.filmaxsize' ]]
      then 
        { read -r estfilmaxsize[i] 
        } < ${monofback[i]}'/'${detectionclone[i]}'.filmaxsize'
      else
        estfilmaxsize[i]=0
      fi

      fbgimage=${monofback[i]}'/'${measuremtclone[i]}'.bg.s'${filmaxsize[i]/./p}'as.n'
      \cp -f $fbgimage'.fits' $components'/'${measuremtclone[i]}'.fbackground'${zfilmaxsize[i]}'.fits' #2>$hell
      \cp -f ${imagepath[i]}'/'${obsimage[i]}'.fits' $components'/'${measuremtclone[i]}'.fits' #2>$hell

      if [[ -e $separated'/'${detectionclone[i]}'.filaments'${zfilmaxsize[i]}'.fits' ]]
      then
        \cp -f $separated'/'${detectionclone[i]}'.filaments'${zfilmaxsize[i]}'.fits' \
               $components'/'${detectionclone[i]}'.filaments'${zfilmaxsize[i]}'.fits' #2>$hell
      fi
      \cp -f $separated'/'${measuremtclone[i]}'.filaments.n'${zfilmaxsize[i]}'.fits' \
             $components'/'${measuremtclone[i]}'.filaments'${zfilmaxsize[i]}'.fits' #2>$hell

      if [[ -e $srcvisuals'/'${obsfootprints[i]}'.fits' && -e $components'/'${detectionclone[i]}'.filaments' ]]
      then 
        ($path'/expanda' 1 $components'/'${detectionclone[i]}'.filaments' ${imageomask[i]} \
                        -o $components'/'${detectionclone[i]}'.filaments.ea' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/cleanbg' ${npradmf[i]} $components'/'${detectionclone[i]}'.filaments.ea' $srcvisuals'/'${obsfootprints[i]} \
                        -o $components'/'${detectionclone[i]}'.filaments' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        \rm -f $components'/'${detectionclone[i]}'.filaments.ea.fits' 2>$hell
      fi
    done

    for (( i=1; i <= $nwaves; i++ ))
    do
      if [[ $nwaves -eq 1 ]]; then iw=''; else iw=$i; fi
      
      if [[ ${estfilmaxsize[i]} != '0' ]]
      then
        obsfilamentsbs=$components'/'${measuremtclone[i]}'.filaments'${zfilmaxsize[i]}
        obsfilamen=$prefix$dotfw'.'${wave[i]}'.obs'
        detfilamen=$prefix$dotfw'.det'
##        detskeletons=$skeletons'/'$detfilamen'.ske'

# Measure filaments using the accurate scale-dependent skeletons.

##        \rm -R ${filmeasure[i]}
##        \mkdir -p ${filmeasure[i]} 2>$hell

        for (( k=1; k <= $nsfils; k++ ))
        do
          if [[ $verb == "-verb0" ]]
          then 'PROGRESS_BAR' "MEASURING FILAMENTS $iw" $k 1 $nsfils 79 "·"; outsameline='yes'
          fi                                                               
          if [[ $k -lt $nsfils ]]
          then sign='-'
          else sign=''
          fi
          zk=${zfilscale[k]}'as'

          for (( kk=1; kk <= $nsklevs; kk++ ))
          do
            zkk=${zsklev[kk]}
            outskels=$skeletons'/+globals/'$detfilamen'.skeletons.'$zk'.s'$zkk

            if [[ -e $outskels'.fits' ]]
            then
              ($path'/imgstat' savein -nomed $outskels ${imageomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
              read -r min max mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
              'CHECK_IMGSTAT' $min $max '' $script $fun $funo '1'
              'COMPARE_FLOATS' $max '>' '0.0' rcnonzero
              if [[ $rcnonzero -eq 1 ]]
              then
                ($path'/fmeasure' $obsfilamentsbs $outskels $distancepc $sign$npxstep ${regcolx[i]} \
                                  ${filmeasure[i]}'/~'${wave[i]} -o $obsfilamen'.ske.'$zk'.s'$zkk $verb; \
                                  echo $? > '.rc'$cwavenum) | 'tehi'
              else
                \rm -f $outskels'.fits' 2>$hell
              fi
            fi
          done
        done

        if [[ $verb == "-verb0" ]]
        then 'PROGRESS_BAR' 'complete' $nsfils 1 $nsfils 79 "·"; outsameline='no'
        fi
      fi
    done

##    if [[ $verb == "-verb0" ]]
##    then 'PROGRESS_BAR' 'complete' $nwaves 1 $nwaves 79 "·"; outsameline='no'
##    fi
  fi

  measure_end=`date +%s`; measure_time=$(( measure_end - measure_beg ))
  'CALCULATE' measure_minutes "$measure_time/60" 3
  printlh; printlh ' '$script': '$measure_minutes' MINUTES'
  fun=$funo
}

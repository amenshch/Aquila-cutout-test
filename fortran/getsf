DECOMPOSE_IMAGES ()
{
  local funo=$fun; fun='DECOMPOSE_IMAGES'; local title=$script': => ('$istep') '\'$fun\'
  local decomposedir; local maskimage; local i; local j; local zj; local nparams=${#*}; local nmust=3
  local i=$1; local what=$2; local imagetodecompose=$3

  if [[ $nparams -lt $nmust ]]  ## && $istep -ge 2
  then 'ERROR' 'Too few parameters: "'$1'" "'$2'" "'$3'"'
  fi
  de_beg=`date +%s`; cdate=`date +%d\ %b\ %Y\ %a\ %H:%M:%S\ %Z`

# Decompose all images in spatial scales.
  
  if [[ $extractiondir != ${dirmono[i]} ]]
  then decomposedir=${dirmono[i]}
  else decomposedir='.'
  fi
  nsbeg=1

  if [[ $what == 'skeletons' ]]
  then 
    decomposedir=$skeletons'/globals'$dotfw
    nskelglob=0
    for (( j=$nsbeg; j <= $nsbeams; j++ ))
    do 
      'COMPARE_FLOATS' ${sbeam[j]} '>=' $beammincombofil rcs1
      'COMPARE_FLOATS' ${sbeam[j]} '<=' $globscalemax rcs2
      nskelglob=$(( nskelglob + 1 ))
      if [[ $rcs2 -eq 0 ]]
      then break
      fi
    done                               
    maskimage=$filcoaddedomask
    filedecomposing=$decomposedir'/'$prefix$dotfw'.skeletons.decompose'
  else
    maskimage=${imageomask[i]}
    filedecomposing=${decompose[i]}
  fi

  image=$imagetodecompose
  imagexpa=$decomposedir'/'$image'.xpa'
  imagexpacon=$imagexpa'.con'
  imagexpacono=$imagexpa'.con.o'

  if [[ $istep -le 1 || $what == 'skeletons' ]]
  then imagetodecompose=$image
  else 
    if [[ $what == 'sources' ]]
    then imagetodecompose=$separated'/'$image'.'$what''${zsrcmaxsize[i]}
    fi
    if [[ $what == 'filaments' ]]
    then imagetodecompose=$separated'/'$image'.'$what''${zfilmaxsize[i]}
    fi
  fi
  ($path'/expanda' 1 $imagetodecompose $maskimage -o $imagexpa $verb; echo $? > '.rc'$cwavenum) | 'tehi'

  \cp -f $imagexpa'.fits' $imagexpacono'.fits' #2>$hell

  print '#'"${headerinfo[1]:3}" > $filedecomposing
  for (( v=2; v <= 4; v++ ))
  do print '#'"${headerinfo[v]:3}" >> $filedecomposing
  done
  print '#' >> $filedecomposing
  print '#' $cdate >> $filedecomposing
  print '#' >> $filedecomposing
  print '# Decomposed image: '$imagetodecompose >> $filedecomposing
  print '#' >> $filedecomposing
  print '# List of the single-scale images: istep = '$istep', '$what', sfactor = '$sfactor >> $filedecomposing
  print '#' >> $filedecomposing
  
  if [[ $nwaves -eq 1 ]]; then iw=''; else iw=$i; fi

# Perform image decomposition.

  for (( j=$nsbeg; j <= $nsbeams; j++ ))
  do 
    if [[ $verb == "-verb0" ]]
    then 
      outsameline='yes'
      if [[ $istep -eq 0 ]]
      then 
        if [[ $istr -le 2 ]]
        then 'PROGRESS_BAR' "DECOMPOSING OBSIMAGE $iw" $j $nsbeg $nsbeams 79 "·"
        else 'PROGRESS_BAR' "DECOMPOSING STDIMAGE $iw" $j $nsbeg $nsbeams 79 "·"
        fi
      elif [[ $istep -ge 1 ]]
      then 
        if [[ $what == 'sources'   ]]; then 'PROGRESS_BAR' "DECOMPOSING SRCIMAGE $iw" $j $nsbeg $nsbeams 79 "·"; fi
        if [[ $what == 'filaments' ]]; then 'PROGRESS_BAR' "DECOMPOSING FILIMAGE $iw" $j $nsbeg $nsbeams 79 "·"; fi
        if [[ $what == 'skeletons' ]]; then 'PROGRESS_BAR' "DECOMPOSING GLOBALS" $j $nsbeg $nskelglob 79 "·"; fi
      fi
    fi
    jm1=$(( j - 1 ))
    'LEADZEROS' 1 $j zj; 'LEADZEROS' 1 $jm1 zjm1
    imagessc=$image'.'$zj'.c'${sbeam[j]}'as'        #<-- single-scale image
    imagesmallr=$image'.sm.'$zj'.c'${sbeam[j]}'as'  #<-- image of all smaller scales
    imagelarger=$image'.la.'$zj'.c'${sbeam[j]}'as'  #<-- image of all larger scales
    imagebig=$image'.c'${sbeam[j]}'as'              #<-- largest convolved image

# Convolve incrementally to save memory and minimize border effects.
                                                                                     
    'CALCULATE' xaddb "4*$dxas" 20
    'COMPARE_FLOATS' ${addbeam[j]} '<=' $xaddb rslt
    
    if [[ $rslt -eq 1 ]]
    then 
      'CALCULATE' addpx "1.5*${sbeam[j]}/$dxas" 20
      'ROUND_FLOAT' 0 $addpx addpx
      'CONVOLVE_IMAGE' expand border 0 $addpx ${sbeam[j]} $imagexpa $imagexpacon $maskimage; chk_rc
    else 
      'CALCULATE' addpx "1.5*${addbeam[j]}/$dxas" 20
      'ROUND_FLOAT' 0 $addpx addpx
      'CONVOLVE_IMAGE' expand border 0 $addpx ${addbeam[j]} $imagexpacono $imagexpacon $maskimage; chk_rc
    fi
    
# Determine the single-scale images.

    if [[ $j -eq $nsbeg ]]
    then ($path'/operate' $imagexpa - $imagexpacon -o $decomposedir'/'$imagessc $verb; echo $? > '.rc'$cwavenum) | 'tehi'
    else ($path'/operate' $imagexpacono - $imagexpacon -o $decomposedir'/'$imagessc $verb; echo $? > '.rc'$cwavenum) | 'tehi'
    fi
    \mv -f $imagexpacon'.fits' $imagexpacono'.fits' #2>$hell
    print \'${decomposedir/$currentroot/..}'/'$imagessc'.fits'\' >> $filedecomposing

    if [[ $what == 'skeletons' ]]
    then 
      'COMPARE_FLOATS' ${sbeam[j]} '>=' $globscalemin rcs1
      'COMPARE_FLOATS' ${sbeam[j]} '<=' $globscalemax rcs2
      if [[ $rcs1 -eq 1 && $rcs2 -eq 1 ]]
      then ($path'/operate' $decomposedir'/'$imagessc + $globalskeleton -o $globalskeleton $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      fi
      if [[ $rcs2 -eq 0 ]]
      then break
      fi
    fi
  done                               

  if [[ $verb == "-verb0" ]]
  then 
    if [[ $what != 'skeletons' ]]
    then 
      if [[ $what != 'visorigin' ]]
      then
        'PROGRESS_BAR' 'complete' $nsbeams $nsbeg $nsbeams 79 "·"; outsameline='no'
      fi
    else 
      'PROGRESS_BAR' 'complete' $nskelglob $nsbeg $nskelglob 79 "·"; outsameline='no'
    fi
  fi
  
  if [[ $what != 'skeletons' ]]
  then
    \mkdir -p ${monobkups[i]} 2>$hell
    \cp -f $filedecomposing ${monobkups[i]} #2>$hell
  fi
    
# What remains is a smoothed image containing all largest scales.
                        
  \mv -f $imagexpacono'.fits' $decomposedir'/'$imagebig'.fits' #2>$hell
  if [[ $decomposedir != "." ]]
  then \cp -f $maskimage'.fits' $decomposedir #2>$hell
  fi
  \rm -f $imagexpa'.fits' 2>$hell

  de_end=`date +%s`; de_time=$(( de_end - de_beg ))
  fun=$funo
} 

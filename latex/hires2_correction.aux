\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The correction tested on 1815 radiative transfer models that were not used to fit the relation of Eq.~(\ref {eq:law}). \emph  {Left}: the relative residual of the surface density, the reconstructed minus the true value divided by the true value, against the distance from the center of the core, as the median over the models. The dashed line marks half the beam of $13.5{\ensuremath  {^{\prime \prime }}}$. \emph  {Right}: the mass of the core, divided by the true mass, when the footprint within which it is measured is too small (negative abscissa) or too large (positive abscissa) by the given fraction of its equivalent radius. The background is always taken in a ring just outside the footprint used. The lines are medians over the models, and the band marks the 16th to 84th percentiles for the factor evaluated at $36.3{\ensuremath  {^{\prime \prime }}}$.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:valgrid}{{5}{8}{The correction tested on 1815 radiative transfer models that were not used to fit the relation of Eq.~(\ref {eq:law}). \emph {Left}: the relative residual of the surface density, the reconstructed minus the true value divided by the true value, against the distance from the center of the core, as the median over the models. The dashed line marks half the beam of $13.5{\arcsec }$. \emph {Right}: the mass of the core, divided by the true mass, when the footprint within which it is measured is too small (negative abscissa) or too large (positive abscissa) by the given fraction of its equivalent radius. The background is always taken in a ring just outside the footprint used. The lines are medians over the models, and the band marks the 16th to 84th percentiles for the factor evaluated at $36.3{\arcsec }$}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces The isolated radiative transfer cylinders at $13.5{\ensuremath  {^{\prime \prime }}}$. $\Sigma _0$: the true surface density on the axis. Crest: the reconstructed over the true surface density on the axis, before and after the correction. $\Lambda $: the linear density within $\pm 300{\ensuremath  {^{\prime \prime }}}$, before and after. $H$: the half-maximum width of the true, the uncorrected and the corrected profile. $\alpha $: the slope of $\log \Sigma $ against $\log r$ between 20 and $120{\ensuremath  {^{\prime \prime }}}$ from the crest, for the same three profiles.}}{8}{table.3}\protected@file@percent }
\newlabel{tab:cyl}{{3}{8}{The isolated radiative transfer cylinders at $13.5{\arcsec }$. $\Sig _0$: the true surface density on the axis. Crest: the reconstructed over the true surface density on the axis, before and after the correction. $\Lambda $: the linear density within $\pm 300{\arcsec }$, before and after. $H$: the half-maximum width of the true, the uncorrected and the corrected profile. $\alpha $: the slope of $\log \Sig $ against $\log r$ between 20 and $120{\arcsec }$ from the crest, for the same three profiles}{table.3}{}}

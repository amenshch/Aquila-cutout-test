GET_VERSION ()
{
  local funo='NO_FUN'; fun='GET_VERSION'
  revision=$1
           
  if [[ "$1" == 'help' ]]
  then 'USAGE'; printlh; exit 0
  fi

  if [[ $GETSF_BIN == "" ]]
  then
    'USAGE'
    printlh ' Executing: '"$executing"
    printlh ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
    printlh ' ERROR: Environment variable '$script'_BIN not set;'
    printlh '        it must point to the binary directory (bin/+'$script')'
    printlh ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
    printlh '  HINT: Make sure that your ~/.bashrc file contains a line like this:'
    printlh '        export '$script'_BIN=/some/path/to/bin/+'$script
    printlh '        and ask your computer sysadmin for help if necessary'
    printlh ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
    printlh
    return 99
  fi
  getdefault="$GETSF_BIN/getsf"                                              
  getrevision="$GETSF_BIN/v$revision/getsf"
                                                                                        
  if [[ $GETSF_DEV != "" ]]
  then getdefault="$GETSF_DEV/getsf"
  fi
  if [[ $GETSF_REL != "" ]]
  then getrevision="$GETSF_REL/v$revision/getsf"
  fi
  
  if [[ "$revision" == "" ]]
  then 
    if [[ ! -e $getdefault ]]
    then 'USAGE'; printlh; printlh ' Executing: '"$executing"
      'ERROR' 'Default installation of '$script': file not found: '$getdefault
    fi
  else 
    if [[ -e $getrevision ]]
    then $getrevision; exit $?
    else 'USAGE'; printlh; printlh ' Executing: '"$executing"
      'ERROR' 'Revision '$revision' of '$script': file not found: '$getrevision
    fi
  fi

  fun=$funo
}

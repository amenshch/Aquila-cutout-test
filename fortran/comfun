SCIENTIFIC2FIXED ()
{
  local funo=$fun; fun='SCIENTIFIC2FIXED'
  if [[ $2 == "" ]]
  then 'ERROR' 'Too few parameters: "'$1'" "'$2'"'
  fi
  local valuexxx=$1; local lenval; local expo; local y; local nE; local ne; local nD; local nd
  
  'POSITION' 'E' $valuexxx nE; 'POSITION' 'e' $valuexxx ne
  'POSITION' 'D' $valuexxx nD; 'POSITION' 'd' $valuexxx nd
  nexp=0
  if   [[ $nE -gt 0 ]]; then nexp=$nE
  elif [[ $ne -gt 0 ]]; then nexp=$ne
  elif [[ $nD -gt 0 ]]; then nexp=$nD
  elif [[ $nd -gt 0 ]]; then nexp=$nd
  fi
  if [[ $nexp -gt 0 ]]
  then
    expo=${valuexxx:nexp}                                  ##; lenexp=${#expo}
    if [[ ${expo:0:1} == '+' ]]; then expo=${expo:1}; fi
                                                           ## if [[ ${expo:0:1} == '0' && $lenexp -gt 1 ]]; then expo=${expo:1}; fi
    if [[ ${expo:0:1} == '-' ]]
    then expo='-'$(echo "${expo:1}" | sed 's/^0*//')
    else expo=$(echo "$expo" | sed 's/^0*//'); [[ -z "$expo" ]] && expo='0'
    fi
    valuexxx=$(echo "scale=40; ${valuexxx:0:(nexp-1)}*10^$expo" | bc)
    if [[ ${valuexxx:0:1} == '.' ]]
    then valuexxx='0'${valuexxx:0}
    fi
  fi
  y=\$"$2"; eval "$2=$valuexxx"

  fun=$funo
}

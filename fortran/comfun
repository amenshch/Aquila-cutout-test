  fun1b=$(echo "scale=25; $cm2pc*$cs15K^2/($xgrav*$xmuH2)/($xmH*$arg1)" | bc); if [[ ${fun1b:0:1} == '.' ]]; then fun1b='0'${fun1b}; fi
  fun2b=$(echo "scale=25; $cm2pc*$cs15K^2/($xgrav*$xmuH2)/($xmH*$arg2)" | bc); if [[ ${fun2b:0:1} == '.' ]]; then fun2b='0'${fun2b}; fi
  echo ";"                                                        > $jeansdata
  echo "; Thermal Jeans length = cs^2 / (G * Sigma)"             >> $jeansdata
  echo "; cs = 0.2 km/s (at Tgas = 10 K) = 200 m/s = 20000 cm/s" >> $jeansdata
  echo "; G = 6.67259E-11 m^3/kg/s^2 = 6.67259E-8 cm^3/g/s^2"    >> $jeansdata
  echo "; Sigma = xmuH2 * mH * NH2 = 2.8 * 1.6726E-24 * NH2"     >> $jeansdata
  echo "; pc = 3.08572e18 cm; cm2pc = 3.240734739E-19"           >> $jeansdata
  echo ";"                                                       >> $jeansdata
  echo "; SURFDENSITY                JEANSLENGTH1  JEANSLENGTH2" >> $jeansdata
  echo ";  cm^-2                        10K pc        15K pc"    >> $jeansdata
  echo " $arg1  ${fun1a:0:12}  ${fun1b:0:12}"                    >> $jeansdata
  echo " $arg2  ${fun2a:0:12}  ${fun2b:0:12}"                    >> $jeansdata
}

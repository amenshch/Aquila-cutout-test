ITERATE_THRESHOLDS ()
{
  local funo=$fun; fun='ITERATE_THRESHOLDS'; local title=$script': => '\'$fun\'
  if [[ $5 == "" ]]
  then 'ERROR' 'Too few parameters: "'$1'" "'$2'" "'$3'" "'$4'" "'$5'"'
  fi
  if [[ $verb != "-verb0" ]]
  then printlh; printlh ' '$title
  fi
  local it; local itm1; local itm2; local ratio; local converged=''; local cdate
  local relcorrit; local relcorrito
  local iwave=$1; local jscale=$2; local imagein=$3; local nsigmacut=$4; local obsmask=$5

  'LEADZEROS' 1 $jscale zjscale

  print >> $logit
  cdate=`date +%d\ %b\ %Y\ %a\ %H:%M:%S\ %Z`
  print \'$imagein\'':' $cdate': iterating thresholds to a relative accuracy of '$relcorrmin'  cleanminpix '${cleanminpix[jscale]} >> $logit
  print >> $logit

# Define initial threshold (note that generally it's not good to define it as level=0 for the images themselves).
  
  ($path'/imgstat' savein -nomed $imagein $obsmask $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
  read -r min max mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
  'CHECK_IMGSTAT' $min $max $sig $script $fun $funo '7'
  if [[ ${max:0:1} == "-" ]]
  then 
    print ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~' >> $logit
    print ' INFO: Maximum is negative: '$max                   >> $logit
    print ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~' >> $logit
    toofewbgpixels=$jscale; toofewbgpixscale=${sbeam[jscale]}
    fun=$funo; return 212
  else \rm -f '.+imgstat2'$cwavenum 2>$hell
  fi
  if [[ ${sig:0:1} == "." ]]; then sig='0'$sig; fi

  'CALCULATE' firstcut "$nsigmacut*$sig" 20
  actualnsigma=$nsigmacut
  sigma[0]=$sig

  'COMPARE_FLOATS' $firstcut '>=' $max rslt
  if [[ $rslt -eq 1 ]]
  then
    'CALCULATE' firstcut "0.9*$max" 20
    'CALCULATE' actualnsigma "$firstcut/$sig" 20
  fi
  if [[ ${firstcut:0:1} == "." ]]
  then sigmas='0'$firstcut
  else sigmas=$firstcut
  fi
  relcorrito=''

  print ' iter: 00  meanbg:' ${mea:0:26} ' sigma:' ${sig:0:26} ' sigma*'${actualnsigma:0:7}':' ${sigmas:0:26} >> $logit

# Get new intensity threshold from only pixels outside the mask. Those pixels have values closer to 0 (from both positive
# and negative sides) than the threshold from the previous iteration. This is kind of a clipping procedure: we clip off
# pixels with values exceeding (in absolute value) a given threshold and consider only remaining pixels when computing
# stdev value for the background.

  for (( it=1; it <= $nthreshmax; it++ ))
  do
    'LEADZEROS' 1 $it zit
    itm1=$(( it - 1 )); itm2=$(( it - 2 ))
    if [[ $itm2 -lt 0 ]]
    then itm2=0
    fi

# Compute statistical quantities (sigma) within the limits +/-sigmas at current iteration, produce background mask image.

    ($path'/imgstat' maxmin $sigmas -$sigmas $imagein $obsmask \
                  -o $imagein'.mask.'$zit'.bg' $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
    read -r min max mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
    'COMPARE_FLOATS' $min '=' $max rcminmax
    'COMPARE_FLOATS' $min '=' '0.0' rcminzero

    if [[ $rcminmax -eq 1 && $rcminzero -eq 1 ]]
    then 
      \rm -f '.+imgstat2'$cwavenum 2>$hell
      allbgpixelszero=$jscale
      fun=$funo; return 200
    fi
    'CHECK_IMGSTAT' $min $max $sig $script $fun $funo '8'

# Store the sigma value at current iteration.

    meanbg=$mea
    if [[ ${meanbg:0:1} == "." ]]
    then meanbg='0'$meanbg
    fi
    if [[ ${sig:0:1} == "." ]]
    then sig='0'$sig
    fi
    sigma[it]=$sig

# Verify that the background mask has large enough number of pixels for statistical values to be meaningful.

    ($path'/imgstat' savein -nomed $imagein'.mask.'$zit'.bg' $imagein'.mask.'$zit'.bg' $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
    read -r min max mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
    'ROUND_FLOAT' 0 $totsum nbgpixels
    nbeams=20
    'CALCULATE' numpixmin "$nbeams*3.14159*(${sbeam[jscale]}/2)^2/$sqpixas" 20
    'ROUND_FLOAT' 0 $numpixmin numpixmin
    
    if [[ $nbgpixels -lt $numpixmin ]]
    then 
      print >> $logit
      print ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~' >> $logit
      print ' INFO: Too few pixels remain in background: '$nbgpixels' < '$numpixmin' ('$nbeams' beams)'  >> $logit
      print ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~' >> $logit
      \rm -f $imagein'.mask.'$zit'.bg.fits' 2>$hell
      toofewbgpixels=$jscale; toofewbgpixscale=${sbeam[jscale]}
      fun=$funo; return 212
    else \rm -f '.+imgstat2'$cwavenum 2>$hell
    fi

    if [[ ${sigma[it]:0:1} == "." ]]
    then sigma[it]='0'${sigma[it]}
    fi

# Check whether iterations converge (ratio < 1) or diverge (ratio > 1)

    'CALCULATE' sigratio "${sigma[it]}/${sigma[itm1]}" 20
    'COMPARE_FLOATS' $sigratio '<' '1.0' rsltconv
    if [[ $rsltconv -eq 1 ]]
    then sigconverging='yes'
    else sigconverging='no'
    fi

# Compute convergence criterion based on relative correction.

    'CALCULATE' relcorrit "${sigma[it]}/${sigma[itm1]}-1" 20
    if [[ ${relcorrit:0:1} == "-" ]]
    then relcorrit=${relcorrit:1}
    fi
    if [[ ${relcorrit:0:1} == "." ]]
    then relcorrit='0'$relcorrit
    fi
    if [[ $relcorrito != '' ]]
    then
      'COMPARE_FLOATS' $relcorrito '=' '0.0' rslt
      if [[ $rslt -eq 0 ]]
      then 'CALCULATE' relcratio "$relcorrit/$relcorrito" 20
      else relcratio='0.0'
      fi
    else relcratio='0.0'
    fi
    relcorrito=$relcorrit

    'COMPARE_FLOATS' $relcorrit '>' '0.50' rsltcorrit
    'COMPARE_FLOATS' $relcratio '<' '0.99' rsltratio
    if [[ $rsltcorrit -eq 1 || $rsltratio -eq 1 ]]
    then corrconverging='yes'
    else corrconverging='no'
    fi

# Fix the threshold and sigma value if they drop to extremely small values.
# This is sometimes useful when testing simulated images without noise/background fluctuations.

    'COMPARE_FLOATS' ${sigma[it]} '<' '0.0000000000000000001' rslt
    if [[ $rslt -eq 1 ]]
    then sigma[it]='0.0000000000000000001'
    fi

# Final decision on convergence.

    'COMPARE_FLOATS' $relcorrit '<' $relcorrmin rslt
    if [[ $it -ge 2 && $rslt -eq 1 ]]
    then converged='yes'
    fi
    
# Final threshold.

    'CALCULATE' sigmas "$nsigmacut*${sigma[it]}" 20

    print ' iter:' $zit ' meanbg:' ${meanbg:0:26} ' sigma:' ${sigma[it]:0:26} ' sigma*'${nsigmacut:0:7}':' ${sigmas:0:26} \
          ' rcorr:' ${relcorrit:0:7} ' nbgpix:' $nbgpixels >> $logit

# Rename and remove some files when converged or reached maximum number of iterations.

    \rm -f $imagein'.mask.'$zit'.bg.fits' 2>$hell

##    if [[ $converged != "yes" && $it -eq $nthreshmax ]]
##    then ##'ERROR' 'No convergence in '$fun
##      if [[ $threshold != '99999999999999999999999999' ]]
##      then sigmas=$threshold
##      fi
##    fi

    if [[ $converged == "yes" || $it -eq $nthreshmax ]]
    then
      if [[ $verb != "-verb0" ]]
      then
        if [[ $converged == "yes" ]]
        then printlh 
          printlh '-------------------------------------------------------------------------'
          if [[ $jscale == "0" ]]
          then printlh ' Image converged in '$it' iterations with a threshold of '$sigmas
          else printlh ' Scale '$jscale' converged in '$it' iterations with a threshold of '$sigmas; fi
          printlh '-------------------------------------------------------------------------'
          sleep 1
        fi
      fi
      break  
    fi
  done

  fun=$funo
}

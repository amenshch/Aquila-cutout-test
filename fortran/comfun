PROGRESS_BAR ()
{ 
  local funo=$fun; fun='PROGRESS_BAR'
  if [[ $1 != "complete" && $6 == "" ]]
  then 'ERROR' 'Too few parameters: "'$1'" "'$2'" "'$3'" "'$4'" "'$5'" "'$6'"'
  fi
  local i; local nbeg; local nend; local width; local ncur; local sym='•'; local nrange; local iter=0; local nrange
  progresstitle=$1; ncur=$2; nbeg=$3; nend=$4; width=$5; char=$6; iter=$7

  progresstitle=${progresstitle%% }  #<~ remove trailing space if it exists

  if [[ "${progresstitle:0:8}" != "complete" ]]
  then
    if [[ $ncur -eq $nbeg ]]
    then                
      lniter=${#iter}; lnbeg=${#nbeg}; lnend=${#nend}; ltitle=${#progresstitle}
      lbar=$(( width - 3 - ltitle - 1 - lnend - 1 ))
      nrange=$(( nend - nbeg + 1 )) ## + lnend - 1
      if [[ $lbar -gt $nrange ]]
      then lbar=$nrange
      fi
      lbarp1=$(( lbar + 1 + lniter + 1 ))
      lback=$(( lbarp1 + lnend + 1 ))
      if [[ "$char" == "·" ]]
      then
        printlh
        printhn     ' '$progresstitle; printf "%b" $red' ['$coff
        printf "%b" ' '"$progresstitle"' [' >> $logfile
      else 
        printf "%b" "$red]$coff $dgra$nend$coff $iter\033[${lback}D"
        printf "%b" "$sym] $nend [" >> $logfile
      fi
      for (( i=1; i <= $lbar; i++ ))
      do printf "%b" "${char:0:1}"
      done
      printf "%b" "$red]$coff $dgra$nend$coff $iter\033[${lback}D"
      nprogress=1; npos=0; sleep 1
    else
      if [[ $nprogress -eq 0 ]]
      then 'ERROR' 'Initial value /= lower bound: '$ncur' '$nbeg' '$nend' '$width
      fi
    fi
  fi
  nbegm1=$(( nbeg - 1 )); nrange=$(( nend - nbegm1 ))
  ncurm1=$(( ncur - 1 )); lncur=${#ncur}; lncurm1=${#ncurm1}; lncurm1p1=$(( lncurm1 + 1 ))
  lenr=$(print "scale=20; $nbegm1+($ncur-($nbegm1))*($lbar-$nbeg)/$nrange" | bc); chk_rc
  if [[ ${lenr:0:1} != "." && ${lenr:0:1} != "-" && $ncur -gt $nbeg ]]
  then leni=${lenr%.*}
  else leni=0
  fi
  if [[ "${progresstitle:0:8}" == "complete" ]]
  then 
    if [[ $ncur -ge $nend ]]
    then
      many=''
      for (( i=1; i <= $lncur; i++ ))
      do many=$many$sym
      done
      printf "%b" "\033[${lncur}D$many"
      printf "%b" "$sym" >> $logfile
      printf "%b" "] $nend $iter" >> $logfile
    else
      ladd=$(( lbar - npos + 1 ))
      many=''
      for (( i=1; i <= $ladd; i++ ))
      do many=$many"·"
      done
      printf "%b" "$many] $nend $iter" >> $logfile
    fi
    if [[ "$progresstitle" == "complete" ]]
    then printlh
    fi
    fun=$funo
    return 0
  fi
  if [[ $leni -lt $nprogress ]]
  then
    if [[ $ncur -eq $nbeg ]]
    then 
      npos=$(( npos + lncur ))
      printf "%b" "$gre$ncur$coff"; sleep 1
    else 
      npos=$(( npos - lncurm1 + lncur ))
      if [[ $npos -gt $lbar ]]
      then 
        lncorr=$(( npos - lbar ))
        npos=$(( npos - lncorr ))
        printf "%b" "\033[${lncorr}D"
      fi
      printf "%b" "\033[${lncurm1}D$gre$ncur$coff"
    fi
  else
    nprogress=$(( nprogress + 1 ))
    many=''
    for (( i=1; i <= $lncurm1p1; i++ ))
    do many=$many$sym
    done
    if [[ $npos -lt $lbar ]]
    then
      npos=$(( npos + 1 ))
      printf "%b" "$sym" | 'tee' -a $logfile
    fi
    printf "%b" "\033[${lncurm1p1}D$many\033[${lncur}D$gre$ncur$coff"
  fi

  fun=$funo
}

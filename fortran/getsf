CLEAR_IMAGE_BORDERS ()
{
  local funo=$fun; fun='CLEAR_IMAGE_BORDERS'
  local clrtype=$1; local width=$2; local imagenamein=$3; local imagenameout=$4
  if [[ $4 == "" ]]
  then 'ERROR' 'Too few parameters: "'$1'" "'$2'" "'$3'" "'$4'"'
  fi
  if [[ $verb != "-verb0" ]]
  then printlh; printlh ' '$fun': '$clrtype' '$width' '$imagenamein
  fi
  if [[ ! -e $imagenamein && ! -e $imagenamein'.fits' ]]
  then 'ERROR' 'File not found: '$imagenamein
  fi

# Clean several-pixel border around the image to clean it of border effects.

  ($path'/modfits' border   -$width $imagenamein  -o $imagenameout $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  ($path'/modfits' $clrtype  $width $imagenameout -o $imagenameout $verb; echo $? > '.rc'$cwavenum) | 'tehi'

  fun=$funo
}

READ_CONFIG ()
{
  local funo=$fun; fun='READ_CONFIG'

  printlh; printlh ' Reading input parameters from '$configfile'...'
  {
  while read -r -a v
  do
    if [[ "${v[0]:0:1}" != "#" ]]
    then 
      if [[ "${v[0]}" == "" ]]
      then 'ERROR' 'Line #1 of the file '$configfile' is empty.' \
                   'Remove empty line(s) from the beginning of '$configfile
      fi
      l=$(( l + 1 ))
      if [[ $l -eq 1 ]]
      then prefix=${v[0]}; distancepc=${v[1]}
      fi
      if [[ $distancepc == "|" ]]
      then 'ERROR' 'Invalid parameter DISTANCEPC = '\'$distancepc\'' in '$configfile \
                   'Make sure that it has a numerical value >= 100 before running '$script \
                   'Save default configuration file to see valid options.'
      fi
      if [[ $l -eq 2 ]]
      then 
        nwmax=${v[0]}
        for (( i=1; i <= $nwmax; i++ ))
        do usefordetsrc[i]='yes'; usefordetfil[i]='yes'
        done
      fi
      if [[ $l -eq 3 ]]
      then 
        nwaves=${v[0]}; nb=$(( l + 1 ))
        for (( i=1; i <= $nwaves; i++ ))
        do
          nw[i]=${v[i]}
          if [[ ${nw[i]:0:1} == "." || ${nw[i]:0:1} == "|" ]]
          then 'ERROR' 'Trouble reading line #'$(( nhead + 3 ))' from file '$configfile \
                       'Make sure that the line with numbers of wavelengths is correct.'
          fi
        done
      fi

      if [[ $l -eq 4 ]]
      then
        signbeam=0
        for (( i=1; i <= $nwmax; i++ ))
        do
          read -r vd1 vd2 vd3
          l=$(( l + 1 ))
          read -r vo1 vo2
          l=$(( l + 1 ))
          cfgwave[i]=${v[0]}
          if [[ "${cfgwave[i]:0:1}" == "-" ]]
          then 'ERROR' 'One of the wavelengths is specified as negative in the config.' \
                       'Verify parameters in '$configfile' before running '$script'.'
          fi
          cfgbeam[i]=${v[1]}
          cfgssize[i]=${v[2]}
          if [[ "${cfgssize[i]:0:1}" == "-" ]]
          then cfgssize[i]=${cfgssize[i]:1}; signsrc=$i
          fi
          cfgfsize[i]=${v[3]}
          if [[ "${cfgfsize[i]:0:1}" == "-" ]]
          then cfgfsize[i]=${cfgfsize[i]:1}; signfil=$i
          fi
          cfgdirp[i]=$vd1
          cfgdirm[i]=$vd2
          if [[ ${v[1]:0:1} == "+" ]]
          then cfgbeam[i]=${v[1]:1}; signbeam=$i
          fi
          if [[ ${cfgdirp[i]:0:2} == "~/" ]]
          then cfgdirp[i]=~/${cfgdirp[i]:2}
          fi
          if [[ ${cfgdirm[i]:0:2} == "~/" ]]
          then cfgdirm[i]=~/${cfgdirm[i]:2}
          fi
          if [[ ! -e ${cfgdirp[i]} ]]
          then 'ERROR' 'Directory not found: '$vd1 \
                       'Verify parameters in '$configfile' before running '$script'.'
          fi
          cfgobsim[i]=${vo1/.fits/}
          cfgdetim[i]=${cfgobsim[i]}
          if [[ $i -eq ${nw[k]} ]]
          then
            nwave[k]=$i
            wave[k]=${v[0]}
            if [[ $signsrc -eq $i ]]
            then usefordetsrc[k]='no'
            fi
            if [[ $signfil -eq $i ]]
            then usefordetfil[k]='no'
            fi
            beam[k]=${cfgbeam[i]}
            srcmaxsize[k]=${cfgssize[i]}
            filmaxsize[k]=${cfgfsize[i]}
            apcorrect[k]=${v[4]}
            regcolorx[k]=${v[5]}
            if [[ ${regcolorx[k]} == 'col' || ${regcolorx[k]} == '|' ]]
            then 
              regcolx[k]=${regcol[i]}
              regcolorx[k]=${regcolor[i]}
              rcolx[k]=${rcol[i]}
            else
##              if [[ "${regcolx[k]}" != 'gre' && "${regcolx[k]}" != "red" && "${regcolx[k]}" != "yel" && "${regcolx[k]}" != "blu" && \
##                    "${regcolx[k]}" != "ora" && "${regcolx[k]}" != "pur" && "${regcolx[k]}" != "cya" && "${regcolx[k]}" != "mag" && \
##                    "${regcolx[k]}" != "lim" && "${regcolx[k]}" != "pin" && "${regcolx[k]}" != "tea" && "${regcolx[k]}" != "lav" && \
##                    "${regcolx[k]}" != "bro" && "${regcolx[k]}" != "bei" && "${regcolx[k]}" != "mar" && "${regcolx[k]}" != "min" && \
##                    "${regcolx[k]}" != "oli" && "${regcolx[k]}" != "apr" && "${regcolx[k]}" != "gra" && "${regcolx[k]}" != "whi" && \
##                    "${regcolx[k]}" != "bla" ]]
##              then 'ERROR' 'Invalid parameter COL = '\'${regcolx[k]}\'' in '$configfile \
##                           'COL takes the following (abbreviated) values:' \
##                           'gre red yel blu ora pur cya mag lim pin tea lav bro bei mar min oli apr gra whi bla'
##              fi
              ncol=0
              for (( ic=1; ic <= $ncolors; ic++ ))
              do
                if [[ ${regcol[ic]} == ${regcolorx[k]} ]]
                then
                  ncol=$(( ncol + 1 ))
                  regcolx[k]=${regcol[ic]}
                  regcolorx[k]=${regcolor[ic]}
                  rcolx[k]=${rcol[ic]}
                fi
              done
              if [[ $ncol -ne 1 ]]
              then 'ERROR' 'Invalid color "'${regcolorx[k]}'" for DS9 region files at wave #'$k' in '$configfile \
                           $script' understands the following (abbreviated) names of colors:' \
                           'gre red yel blu ora pur cya mag lim pin tea lav bro bei mar min oli apr gra whi bla'
              fi
            fi
            directory[k]=$vd1
            dirmon[k]=$vd2
            obsimage[k]=${vo1/.fits/}
            detimage[k]=${obsimage[k]}
            if [[ ${srcmaxsize[k]:0:1} == "s" ]]
            then 'ERROR' 'Invalid maximum size "'${srcmaxsize[k]}'" for sources at wave #'$k' in '$configfile \
                         'Replace the placeholder with an actual value before running '$script'.'
            fi
            if [[ ${filmaxsize[k]:0:1} == "f" ]]
            then 'ERROR' 'Invalid maximum size "'${filmaxsize[k]}'" for filaments at wave #'$k' in '$configfile \
                         'Replace the placeholder with an actual value before running '$script'.'
            fi
            if [[ ${apcorrect[k]} != "y" && ${apcorrect[k]} != "n" ]]
            then 'ERROR' 'Invalid aperture correction "'${apcorrect[k]}'" at wave #'$k' in '$configfile \
                         'Make sure the parameter is "y" or "n" before running '$script'.'
            fi
            if [[ ${apcorrect[k]} == "y" ]]
            then 
              if [[ ${wave[k]} != "070" && ${wave[k]} != "0070" && ${wave[k]} !=  "70" && ${wave[k]} !=  "100" && ${wave[k]} != "0100" && \
                    ${wave[k]} != "071" && ${wave[k]} != "0071" && ${wave[k]} !=  "71" && ${wave[k]} !=  "101" && ${wave[k]} != "0101" && \
                    ${wave[k]} != "072" && ${wave[k]} != "0072" && ${wave[k]} !=  "72" && ${wave[k]} !=  "102" && ${wave[k]} != "0102" && \
                    ${wave[k]} != "073" && ${wave[k]} != "0073" && ${wave[k]} !=  "73" && ${wave[k]} !=  "103" && ${wave[k]} != "0103" && \
                    ${wave[k]} != "074" && ${wave[k]} != "0074" && ${wave[k]} !=  "74" && ${wave[k]} !=  "104" && ${wave[k]} != "0104" && \
                    ${wave[k]} != "160" && ${wave[k]} != "0160" && ${wave[k]} != "161" && ${wave[k]} != "0161" && \
                    ${wave[k]} != "162" && ${wave[k]} != "0162" && ${wave[k]} != "163" && ${wave[k]} != "0163" && \
                    ${wave[k]} != "164" && ${wave[k]} != "0164" && ${wave[k]} != "165" && ${wave[k]} != "0165" && \
                    ${wave[k]} != "166" && ${wave[k]} != "0166" && ${wave[k]} != "167" && ${wave[k]} != "0167" && \
                    ${wave[k]} != "168" && ${wave[k]} != "0168" && ${wave[k]} != "250" && ${wave[k]} != "0250" && \
                    ${wave[k]} != "251" && ${wave[k]} != "0251" && ${wave[k]} != "252" && ${wave[k]} != "0252" && \
                    ${wave[k]} != "253" && ${wave[k]} != "0253" && ${wave[k]} != "254" && ${wave[k]} != "0254" && \
                    ${wave[k]} != "255" && ${wave[k]} != "0255" && ${wave[k]} != "350" && ${wave[k]} != "0350" && \
                    ${wave[k]} != "500" && ${wave[k]} != "0500" ]]
              then 'ERROR' 'Invalid wavelength "'${wave[k]}'" for aperture corrections in '$configfile \
                           'The corrections only valid for PACS & SPIRE: [00]70, [0]100, [0]160, [0]250, [0]350, [0]500;' \
                           'for all other images the aperture correction parameter must be "n"'
              fi
            fi
            k=$(( k + 1 ))
          fi
          read -r -a v
          l=$(( l + 1 ))
        done
      fi
      if [[ $l -gt 4 ]]
      then
        nx=$(( nb + nwmax * 3 - 1 ))
        if [[ ${v[0]} == "y"  ]]; then v[0]='yes'; fi
        if [[ ${v[0]} == "n"  ]]; then v[0]='no'; fi
        if [[ ${v[1]} == "y+" ]]; then v[1]='yes'; smp='+'; fi
        if [[ ${v[1]} == "y"  ]]; then v[1]='yes'; fi
        if [[ ${v[1]} == "n"  ]]; then v[1]='no'; fi
        if [[ ${v[3]} == "y"  ]]; then v[3]='yes'; fi
        if [[ ${v[3]} == "n"  ]]; then v[3]='no'; fi
        if [[ ${v[4]} == "y"  ]]; then v[4]='yes'; fi
        if [[ ${v[4]} == "n"  ]]; then v[4]='no'; fi

        if [[ $l -eq $(( nx +  1 )) ]]; then      sources=${v[0]}; filaments=${v[1]}; fi
        if [[ $l -eq $(( nx +  2 )) ]]; then     separate=${v[0]}; itsrc1=${v[1]}; itfil1=${v[2]}; itbgsmax=${v[3]}; fi
        if [[ $l -eq $(( nx +  3 )) ]]; then      flatten=${v[0]}; itstd1=${v[1]}; itftd1=${v[2]}; fi
        if [[ $l -eq $(( nx +  4 )) ]]; then     complete=${v[0]}; fi  
        if [[ $l -eq $(( nx +  5 )) ]]; then      combine=${v[0]}; fi
        if [[ $l -eq $(( nx +  6 )) ]]; then       detect=${v[0]}; skelsig=${v[1]}; fi
        if [[ $l -eq $(( nx +  7 )) ]]; then      measure=${v[0]}; goodmin=${v[1]}; iterbeg=${v[2]}; itermax=${v[3]}; sproima=${v[4]}; fi
        if [[ $l -eq $(( nx +  8 )) ]]; then    visualize=${v[0]}; fi
        if [[ $l -eq $(( nx +  9 )) ]]; then nsigmacombos=${v[0]}; fi
        if [[ $l -eq $(( nx + 10 )) ]]; then nsigmacombof=${v[0]}; fi
        if [[ $l -eq $(( nx + 11 )) ]]; then nwavesdetect=${v[0]}; fi
        if [[ $l -eq $(( nx + 12 )) ]]; then    savespace=${v[0]}; delete=${v[1]}; fi
        if [[ $l -eq $(( nx + 13 )) ]]; then    verbosity=${v[0]}; fi

        if [[ "$skipstd" == 'no' && "${itstd1:0:1}" == "-" ]]
        then itstd1=${itstd1:1}; skipstd='yes'
        fi
        if [[ "$skipftd" == 'no' && "${itftd1:0:1}" == "-" ]]
        then itftd1=${itftd1:1}; skipftd='yes'
        fi
        if [[ "$sproima" == '|' && "$sproima" != "-" ]]
        then 'ERROR' 'Invalid parameter SPROIMA = '\'$sproima\'' in '$configfile \
                     'Make sure that it has a value "n" or "y" before running '$script \
                     'Save default configuration file to see valid options.'
        fi
        if [[ $delete != "-" && $delete != "?" && $delete != "no" && $delete != "yes" ]]
        then 'ERROR' 'Invalid parameter DELETE = '\'$delete\'' in '$configfile \
                     'Make sure that it has a value "?" or "n" or "y" before running '$script \
                     'Save default configuration file to see valid options.'
        fi
      fi
    else
      nhead=$(( nhead + 1 )) 
    fi
    totalparams=13
    if [[ $l -eq $(( nx + totalparams )) && ${v[0]:0:4} == "#___" ]]
    then lastline='yes'
    fi
  done
  if [[ $lastline == "no" ]]
  then 'ERROR' 'Trouble finding end of the configuration file '$configfile \
               'Make sure that the total number of lines is '$(( nhead + nx + totalparams )) \
               'before running '$script'.'
  fi
  } < $configfile
  
  fun=$funo
}

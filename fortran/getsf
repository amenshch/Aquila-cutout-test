VERIFY_FITS_HEADERS ()
{
  local funo=$fun; fun='VERIFY_FITS_HEADERS'
  if [[ $4 == "" ]]
  then printlh
    'ERROR' 'Too few parameters: "'$1'" "'$2'" "'$3'" "'$4'"'
  fi
  local bunitc; local bzero; local bzeroc; local bscale; local bscalec; local abort
  local fpath=$1; local origimage=$2; local cloneimage=$3; local wavelength=$4

  abort='no'

  if [[ ! -e $fpath'/'$origimage'.fits' ]]
  then printlh; 'ERROR' 'File not found:' '&' $fpath'/'$origimage'.fits'
  fi
    
# Check the image for correctness of the keyword BUNIT.
  
  $path'/readhead' save BUNIT $fpath'/'$origimage $verb$cwavenum &> $hell; rch=$?
  if [[ $rch -eq 0 ]]; then read -r bunitc bunit < '.+readhead'$cwavenum; chk_rc; \rm -f '.+readhead'$cwavenum 2>$hell; fi

  if [[ ${bunit:0:1} == "'" ]]; then bunit=${bunit:1}; fi
  lenbu=${#bunit}; lenbu=$(( lenbu - 1 ))
  if [[ ${bunit:lenbu:1} == "'" ]]; then bunit=${bunit:0:lenbu}; fi
  bunits=`print $bunit | tr a-z A-Z`
  
  if [[ ${bunits:0:7} == '       ' || ${bunits:0:7} == 'UNKNOWN' || $rch -eq 2 ]]
  then printlh
    'ERROR' "Missing/blank/bad value $bunit of BUNIT in '$origimage.fits'" \
            'Use MODFITS to correct the BUNIT keyword and then run '$script
  fi

  if [[ ${bunit:0:6} != "MJy/sr" && ${bunit:0:7} != "H2/cm^2" ]]
  then printlh
    'ERROR' "Invalid BUNIT = '$bunit' in the header of '$origimage.fits'" \

FILAMENT_SCALES ()
{
  local funo=$fun; fun='FILAMENT_SCALES'; local title=$script': => '\'$fun\'
  if [[ $2 == "" ]]
  then 'ERROR' 'Too few parameters: "'$2'"'
  fi
  local firstscale=$1; local filmaxsize=$2; local k; local km1; local rslt; local filmaxsizex; local rslts
  if [[ $verb != "-verb0" ]]
  then printlh; printlh ' '$title
  fi
  factfilscale='1.414213562'; nsfilsp=15; nsfils=1

  'CALCULATE' filscal[1] "$filmaxsize*1" 20      ## $factfilscale
  'ROUND_FLOAT' 0 ${filscal[1]} filscal[1]
  
  for (( k=2; k <= $nsfilsp; k++ ))
  do
    km1=$(( k - 1 ))
    'CALCULATE' filscal[k] "${filscal[km1]}/$factfilscale" 20
    'ROUND_FLOAT' 0 ${filscal[k]} filscal[k]
    'COMPARE_FLOATS' ${filscal[k]} '<' $firstscale rslt
    if [[ $rslt -eq 1 ]]
    then break
    fi
    nsfils=$k
  done

  for (( k=1; k <= $nsfils; k++ ))
  do
    km1=$(( nsfils - k + 1 ))
    filscale[k]=${filscal[km1]}
    'LEADZEROS' 3 ${filscale[k]} zfilscale[k]
##    echo $k ${filscale[k]}
  done
  
  fun=$funo
}

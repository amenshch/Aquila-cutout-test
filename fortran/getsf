    if [[ ! -e ${dirmono[i]} ]]
    then 'ERROR' 'Monochromatic extraction directory not found:' '&' ${dirmono[i]}
    fi
    if [[ ! -e ${imagepath[i]} ]]
    then 'ERROR' 'Directory with input images not found:' '&' ${imagepath[i]}
    fi
    if [[ ! -e ${imagepath[i]}'/'${obsimage[i]}'.fits' ]]
    then 'ERROR' 'Measurement image not found:' '&' ${imagepath[i]}'/'${obsimage[i]}'.fits'
    fi
    if [[ ! -e ${imagepath[i]}'/'${detimage[i]}'.fits' ]]
    then 'ERROR' 'Detection image not found:' '&' ${imagepath[i]}'/'${detimage[i]}'.fits'
    fi
    if [[ ! -e ${imagepath[i]}'/'${detimage[i]}'.omask.fits' ]]
    then 'ERROR' 'Observational mask not found:' '&' ${imagepath[i]}'/'${detimage[i]}'.omask.fits'
    fi
    imagetype[i]='other'
  done

# Copy files to the current directory.
  
  for (( i=1; i <= $nwaves; i++ ))
  do 
    im1=$(( i - 1 ))
    printlh
    printlh ' Images directory:'
    printlh ' '$tilde${imagepath[i]:ihpath}

    printlh ' Copying '${obsimage[i]}'.fits...'
    \cp -f ${imagepath[i]}'/'${obsimage[i]}'.fits' ${measuremtclone[i]}'.fits' #2>$hell
    \cp -f ${imagepath[i]}'/'${obsimage[i]}'.fits' ${detectionclone[i]}'.fits' #2>$hell

    printlh ' Copying '${obsimage[i]}'.omask.fits...'
    \cp -f ${imagepath[i]}'/'${obsimage[i]}'.omask.fits' ${imageomask[i]}'.fits' #2>$hell

    ($path'/imgstat' savein -nomed ${imageomask[i]} ${imageomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
    read -r min max mea med tots sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
    'CHECK_IMGSTAT' $min $max '' $script $fun $funo '1'
    'COMPARE_FLOATS' ${min:0:6} '=' '0.0000' rslt0
    'COMPARE_FLOATS' ${max:0:6} '=' '1.0000' rslt1
    'COMPARE_FLOATS' ${min:0:6} '=' ${max:0:6} rslt2
    if [[ ($rslt0 -eq 0 && $rslt2 -eq 0) || $rslt1 -eq 0 ]]
    then 'ERROR' 'Invalid observational mask: min = '$min', max = '$max'.' \
                 'Mask images have minimum = 0.0000 and maximum = 1.0000.'  
    fi
  done
    
  'VERIFY_INPUT_IMAGES'; chk_rc
  
  'GET_IMAGE_PIXELS'; chk_rc

  answer=''
  
# Determine type of the images.

  for (( i=1; i <= $nwaves; i++ ))
  do
    if [[ ${wave[i]} == "070" || ${wave[i]} == "0070" || ${wave[i]} == "70" ]]
    then       
      if [[ "${beam[i]}" == "${b070s10:1}" || "${beam[i]}" == "${b070s20:1}" || "${beam[i]}" == "${b070s20p:1}" || \
            "${beam[i]}" == "${b070s60:1}" || "${beam[i]}" == "${b070s60p:1}" ]]
      then
        imagetype[i]='Herschel'
      fi
    fi
    if [[ ${wave[i]} == "100" || ${wave[i]} == "0100" ]]
    then       
      if [[ "${beam[i]}" == "${b100s10:1}" || "${beam[i]}" == "${b100s20:1}" || "${beam[i]}" == "${b100s20p:1}" || \
            "${beam[i]}" == "${b100s60:1}" || "${beam[i]}" == "${b100s60p:1}" ]]
      then
        imagetype[i]='Herschel'
      fi
    fi
    if [[ ${wave[i]} == "160" || ${wave[i]} == "0160" ]]
    then       
      if [[ "${beam[i]}" == "${b160s10}" || "${beam[i]}" == "${b160s20}" || "${beam[i]}" == "${b160s20p}" || \
            "${beam[i]}" == "${b160s60}" || "${beam[i]}" == "${b160s60p}" ]]
      then
        imagetype[i]='Herschel'
      fi
    fi
    if [[ ${wave[i]} == "250" || ${wave[i]} == "0250" ]]
    then       
      if [[ "${beam[i]}" == "$b250" ]]
      then 
        imagetype[i]='Herschel'
      fi
    fi
    if [[ ${wave[i]} == "350" || ${wave[i]} == "0350" ]]
    then       
      if [[ "${beam[i]}" == "$b350" ]]
      then 
        imagetype[i]='Herschel'
      fi
    fi
    if [[ ${wave[i]} == "500" || ${wave[i]} == "0500" ]]
    then       
      if [[ "${beam[i]}" == "$b500" ]]
      then 
        imagetype[i]='Herschel'
      fi
    fi
    if [[ ${imagetype[i]} == 'Herschel' && ${apcorrect[i]} == "n" ]]
    then imagetype[i]='other'
    fi
  done

# Create total observational mask (an intersection between all observational masks at specific waves).
    
  beamavcombosrc=0; beammincombosrc=9999; beammaxcombosrc=0; nwavesdetectsrc=0; printlhed=''; srcdetectingomask=''
  srccoaddedomask=$prefix$dotsw'.coadded.omask'; filcoaddedomask=$prefix$dotfw'.coadded.omask'
##  if [[ $sources == 'yes' ]]
##  then 
    ($path'/modfits' multiply 0 ${detectionclone[1]} -o $srccoaddedomask $verb; echo $? > '.rc'$cwavenum) | 'tehi'
##  fi
  if [[ $filaments == 'yes' ]]
  then ($path'/modfits' multiply 0 ${detectionclone[1]} -o $filcoaddedomask $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  fi
  
# Create observational masks for combining single scales over wavelengths.

  for (( i=1; i <= $nwaves; i++ ))
  do 
    'CLEAR_IMAGE_BORDERS' border $bpixmsk ${imageomask[i]} ${imageomask[i]}; chk_rc
    combiningomask[i]=$prefix'.combining.'${wave[i]}'.omask.fits'
  done
  
# Combining omask is a special mask can be used to exclude some images or their areas from combining.

##  if [[ $sources == 'yes' ]]  # && ($combine == "yes" || $detect == "yes" || $measure == 'yes')
##  then
    for (( i=1; i <= $nwaves; i++ ))
    do
      if [[ -e ${imagepath[i]}'/combining.'${wave[i]}'.omask.fits' ]]
      then
        if [[ $printlhed == "" ]]; then printlh; printlhed='yes'; fi
        printlh ' Copying mask for combining: '${combiningomask[i]}'...'
        \cp -f ${imagepath[i]}'/combining.'${wave[i]}'.omask.fits' ${combiningomask[i]} #2>$hell
      else
        ($path'/modfits' multiply 0 ${detectionclone[i]} -o ${combiningomask[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/modfits' add 1 ${combiningomask[i]} -o ${combiningomask[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      fi
      ($path'/imgstat' savein -nomed ${combiningomask[i]} ${combiningomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
      read -r min max mea med tots sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
      'CHECK_IMGSTAT' $min $max '' $script $fun $funo '2'
    
      'COMPARE_FLOATS' ${max:0:6} '=' '0.0000' rslt1
      
      if [[ $rslt1 -eq 1 ]]
      then usefordetsrc[i]='no'
      fi
      if [[ ${usefordetsrc[i]} == "yes" ]]
      then 
        'COMPARE_FLOATS' ${beam[i]} '<' $beammincombosrc rslt
        if [[ $rslt -eq 1 ]]
        then beammincombosrc=${beam[i]}
        fi
        'COMPARE_FLOATS' ${beam[i]} '>' $beammaxcombosrc rslt
        if [[ $rslt -eq 1 ]]
        then beammaxcombosrc=${beam[i]}
        fi
        'CALCULATE' beamavcombosrc "$beamavcombosrc+${beam[i]}" 20
        nwavesdetectsrc=$(( nwavesdetectsrc + 1 ))

        ($path'/operate' ${imageomask[i]} + $srccoaddedomask -o $srccoaddedomask $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      fi
    done

    if [[ $nwavesdetectsrc -gt 0 ]]
    then 'CALCULATE' beamavcombosrc "$beamavcombosrc/$nwavesdetectsrc" 20
    fi
##  fi

  if [[ $sources == 'yes' && $nwavesdetectsrc -lt $nwaves ]]
  then
    lfrst=1
    for (( i=1; i <= $nwaves; i++ ))
    do
      if [[ ${usefordetsrc[i]} == "no" ]]
      then 
        if [[ $lfrst -eq 1 ]]
        then printlh; lfrst=2
        fi
        printlh ' The '${wave[i]}' µm image will not be used to detect sources: only for measurements.'
      fi
    done
    sleep 2
  fi
  
  beamavcombofil=0; beammincombofil=9999; beammaxcombofil=0; nwavesdetectfil=0
  
  if [[ $filaments == 'yes' ]]  # && ($combine == "yes" || $detect == "yes" || $measure == 'yes' || $visualize == 'yes')
  then
    for (( i=1; i <= $nwaves; i++ ))
    do
      ($path'/imgstat' savein -nomed ${combiningomask[i]} ${combiningomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
      read -r min max mea med tots sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
      'CHECK_IMGSTAT' $min $max '' $script $fun $funo '2'
    
      'COMPARE_FLOATS' ${max:0:6} '=' '0.0000' rslt1
      
      if [[ $rslt1 -eq 1 ]]
      then usefordetfil[i]='no'
      fi
      if [[ ${usefordetfil[i]} == "yes" ]]
      then 
        'COMPARE_FLOATS' ${beam[i]} '<' $beammincombofil rslt
        if [[ $rslt -eq 1 ]]
        then beammincombofil=${beam[i]}
        fi
        'COMPARE_FLOATS' ${beam[i]} '>' $beammaxcombofil rslt
        if [[ $rslt -eq 1 ]]
        then beammaxcombofil=${beam[i]}
        fi
        'CALCULATE' beamavcombofil "$beamavcombofil+${beam[i]}" 20
        nwavesdetectfil=$(( nwavesdetectfil + 1 ))

        ($path'/operate' ${imageomask[i]} + $filcoaddedomask -o $filcoaddedomask $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      fi
    done
  
    if [[ $nwavesdetectfil -gt 0 ]]
    then 'CALCULATE' beamavcombofil "$beamavcombofil/$nwavesdetectfil" 20
    fi
  fi
  
  if [[ $filaments == 'yes' && $nwavesdetectfil -lt $nwaves ]]
  then
    lfrst=1
    for (( i=1; i <= $nwaves; i++ ))
    do
      if [[ ${usefordetfil[i]} == "no" ]]
      then 
        if [[ $lfrst -eq 1 ]]
        then printlh; lfrst=2
        fi
        printlh ' The '${wave[i]}' µm image will not be used to detect filaments: only for measurements.'
      fi
    done
    sleep 2
  fi
  
# Create and intersect a special detecting omask.

  for (( i=1; i <= $nwaves; i++ ))
  do
    if [[ -e ${imagepath[i]}'/detecting.omask.fits' ]]
    then
      if [[ $srcdetectingomask == "" ]]
      then
        srcdetectingomask=$prefix'.src.detecting.omask.fits'
        printlh; printlh ' Making a special mask for detecting: '$srcdetectingomask'...'
        ($path'/modfits' multiply 0 ${detectionclone[i]} -o $srcdetectingomask $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/modfits' add 1 $srcdetectingomask -o $srcdetectingomask $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      fi
      ($path'/operate' ${imagepath[i]}'/detecting.omask.fits' x $srcdetectingomask -o $srcdetectingomask $verb \
       echo $? > '.rc'$cwavenum) | 'tehi'
  
      ($path'/imgstat' savein -nomed $srcdetectingomask $srcdetectingomask $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
      read -r min max mea med tots sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
      'CHECK_IMGSTAT' $min $max '' $script $fun $funo '3'
                                                 
      'COMPARE_FLOATS' ${min:0:6} '=' ${max:0:6} rslt1
      'COMPARE_FLOATS' ${max:0:6} '=' '1.0000' rslt2
      if [[ $rslt1 -eq 0 || $rslt2 -eq 0 ]]
      then 'ERROR' 'Invalid '\''detecting.omask.fits'\'': min = '$min', max = '$max'.' \
                   'Mask images have minimum = 0.0000 and maximum = 1.0000'
      fi
    fi
  done
  
  if [[ $sources == 'yes' ]]
  then ($path'/modfits' maximum 1 n $srccoaddedomask -o $srccoaddedomask $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  fi
  if [[ $filaments == 'yes' ]]
  then ($path'/modfits' maximum 1 n $filcoaddedomask -o $filcoaddedomask $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  fi

  if [[ $srcdetectingomask == "" ]]
  then srcdetectingomask=$srccoaddedomask
  fi

  for (( i=1; i <= $nwaves; i++ ))
  do
    if [[ -e ${dirmono[i]}'/'${detectionclone[i]}'.thresholds.(+)' ]]
    then enforcedthresh[i]='(+)'
    else enforcedthresh[i]=''
    fi
  done
    
  fileswcombining='./'$prefix$dotsw'.det.combine'
  filefwcombining='./'$prefix$dotfw'.det.combine'

# Define some names that will be used in the measurement phase.

  for (( i=1; i <= $nwaves; i++ ))
  do
    wavecatname[i]='sm.'${measuremtclone[i]}'.cat'
    smfcatname[i]=${wavecatname[i]/.cat/.smf.cat}
    detfootprints[i]='sm.'${detectionclone[i]}'.foots'
    obsfootprints[i]=${wavecatname[i]/.cat/.foots}
    obsfootprinta[i]=${wavecatname[i]/.cat/.foota}
    subsfootprints[i]=${wavecatname[i]/.cat/.subsfp}
    maskscalesfinalsum[i]=$prefix'.mask.s~max.w'${wave[i]}'.sum'
  done
  maskscaleswavesfinalsum=$prefix'.mask.s~max.w'${wave[1]}'~'${wave[nwaves]}'.sum'
#___________________________________________________________________________________________________________________________________

# Cut off the '.fits' name extension, if present.

  image=${image/.fits/}
  prefix=${prefix/.fits/}

  if [[ $nsigmacombof != $def_nsigmacombof ]]
  then nsigmacombofmess=' <~ default value: '$def_nsigmacombof
  else nsigmacombofmess=''
  fi
  if [[ $nsigmacombos != $def_nsigmacombos ]]
  then nsigmacombosmess=' <~ default value: '$def_nsigmacombos
  else nsigmacombosmess=''
  fi
  if [[ $itbgsmax != $def_itbgsmax ]]
  then itbgsmaxmess=' <~ default value: '$def_itbgsmax
  else itbgsmaxmess=''
  fi
  nwavesdetectmess=''
  nwavesdetectmin=$nwavesdetect
  if [[ $sources == 'yes' ]]
  then
    if [[ $nwavesdetect -lt $nwavesdetectsrc ]]
    then nwavesdetectmin=$nwavesdetect
    else nwavesdetectmin=$nwavesdetectsrc
    fi
  fi
  if [[ $nwavesdetect -gt $nwavesdetectmin ]]
  then 
    if [[ $measure == "yes" ]]
    then nwavesdetectmess='<~ down from '$nwavesdetect; nwavesdetect=$nwavesdetectmin
#    else nwavesdetect=0
    fi
  fi
  
  'CLEAR_STDIN'
  printlh '_______________________________________________________________________________'
  printlh
  printlh '              '$script' PARAMETERS'
  printlh  
  printlh '      nsigmacombos:' $nsigmacombos $nsigmacombosmess; if [[ "$nsigmacombosmess" != '' ]]; then read -r -s answer; fi
  printlh '      nsigmacombof:' $nsigmacombof $nsigmacombofmess; if [[ "$nsigmacombofmess" != '' ]]; then read -r -s answer; fi
  printlh '      nwavesdetect:' $nwavesdetect $nwavesdetectmess; if [[ $nwavesdetect -le 0 ]]; then read -r -s answer; fi
  printlh '         savespace:' $savespace    $delete
  printlh '         verbosity:' ${verb:5:1}
  printlh '          distance:' $distancepc' pc'
  for (( i=1; i <= $nwaves; i++ ))
  do 'LEADZEROS' 1 $i zi
    printlh "       obsimage $zi: "${obsimage[i]}' ~> type: '"${imagetype[i]}"
  done
  for (( i=1; i <= $nwaves; i++ ))
  do 'LEADZEROS' 1 $i zi
    printlh "     imageomask $zi: ./"${imageomask[i]} '~> apcorr: '"${apcorrect[i]}"' color: '"${rcolx[i]}"
  done
  for (( i=1; i <= $nwaves; i++ ))
  do 'LEADZEROS' 1 $i zi
    if [[ ${usefordetsrc[i]} == 'yes' ]]; then sign=''; else sign='-'; fi
    srcmaxsizeout[i]="$sign${srcmaxsize[i]}"
    if [[ ${usefordetfil[i]} == 'yes' ]]; then sign=''; else sign='-'; fi
    filmaxsizeout[i]="$sign${filmaxsize[i]}"
    printlh " measuremtclone $zi: ./"${measuremtclone[i]} '~> obsbeam: '"${beam[i]}" \
                                 '~> maxsizes: '"${srcmaxsizeout[i]}"' '"${filmaxsizeout[i]}"' '"${enforcedthresh[i]}"
  done
  if [[ $skipstd == 'yes' ]]; then ssign='-'; else ssign=''; fi
  if [[ $skipftd == 'yes' ]]; then fsign='-'; else fsign=''; fi
  printlh '            srcfil:' $sources  $filaments
  printlh '          separate:' $separate $itsrc1 $itfil1 $itbgsmax $itbgsmaxmess; if [[ "$itbgsmaxmess" != '' ]]; then read -r -s answer; fi
  printlh '           flatten:' $flatten  $ssign$itstd1 $fsign$itftd1
  printlh '          complete:' $complete
  printlh '           combine:' $combine                     
  printlh '            detect:' $detect   $skelsig
  printlh '           measure:' $measure  $smp $goodmin $iterbeg $itermax $sproima
  printlh '         visualize:' $visualize
  printlh '_______________________________________________________________________________'
  printlh
  waitingforinput='yes'
  printhn     ' QQQ: Are the above parameters correct (Y/n)?: '
  printf "%b" ' QQQ: Are the above parameters correct (Y/n)?: ' >> $logfile
  answer=''; read -r -s -t 30 answer; rc=$?
  waitingforinput='no'
  
  if [[ ${answer:0:1} != "n" && ${answer:0:1} != "N" && ${answer:0:1} != "y" && ${answer:0:1} != "Y" && $answer != "" ]]
  then answer='n'; printl 'assuming '
  fi
  if [[ ${answer:0:1} == "n" || ${answer:0:1} == "N" ]]
  then answer='n'; printlh 'no!'; printlh; printlh ' Answer '$answer' received - '$script' aborted.'; printlh; exit 99
  fi
  if [[ ${answer:0:1} == "y" || ${answer:0:1} == "Y" || $answer == "" ]]
  then printlh 'yes!'
  fi

  if [[ $separate == 'yes' && ($itsrc1 -eq 1 || $itfil1 -eq 1) ]]
  then printlh
    printlh ' The maximum sizes of sources and filaments need to be manually (visually)   '
    printlh ' estimated from prepared images before an extraction, for each waveband      '
    printlh ' independently. This can be done by opening an image in DS9 and placing a    '
    printlh ' circular region with a certain angular radius over the largest structure.   '
    printlh
    printlh ' The maximum sizes are defined as the footprint radii of the largest source  '
    printlh ' and the widest filament of interest. A footprint is defined as the full     ' 
    printlh ' width of a structure at zero (background) level, i.e., the largest extent   '
    printlh ' on both sides from the source peak or filament crest, where that structure  '
    printlh ' is still visible against its background.                                    '
    printlh
    printlh ' Separated background of the filamentary component must be inspected to      '
    printlh ' verify that there are no residuals. If residuals of the filaments appear    '
    printlh ' clearly visible, the background is not accurate for filament measurements.  '
    printlh ' The maximum size of the filaments of interest in the config file must be    '
    printlh ' increased and a new extraction of the filaments must be started.            '
    printlh
    waitingforinput='yes'
    printhn     ' [20s] Press Enter to acknowledge...'
    printf "%b" ' [20s] Press Enter to acknowledge...' >> $logfile
    read -r -s -t 20 answer; printlh ' OK'
    waitingforinput='no'
  fi
  
##  allapertures=''
##  for (( i=1; i <= $nwaves; i++ ))
##  do allapertures=$allapertures' '${aperture[i]}
##  done
##  if [[ $apertures == "y" ]]
##  then printlh
##    printlh ' WARNING: MEASUREMENT APERTURES:'$allapertures' ARCSEC'
##    printlh '  __________________________________________________________________ '
##    printlh ' |                                                                  |'
##    printlh ' |  You have chosen to apply user-defined MEASUREMENT APERTURES in  |'
##    printlh ' |  this extraction. Note that indiscriminate use of the apertures  |'
##    printlh ' |  may easily lead to meaningless results, as they can strongly    |'
##    printlh ' |  influence the background subtraction and deblending. Since the  |'
##    printlh ' |  observed astrophysical backgrounds are highly-variable on all   |'
##    printlh ' |  scales, the fixed apertures may result in overestimating the    |'
##    printlh ' |  fluxes (or sizes) for some sources and in underestimating them  |'
##    printlh ' |  for other sources. All this may introduce biases, depending on  |'
##    printlh ' |  the actual size and location of a source, that are impossible   |'
##    printlh ' |  to predict in a general case.                                   |'
##    printlh ' |                                                                  |'
##    printlh ' |  THE AUTHOR DOES NOT GUARANTEE CORRECT RESULTS WHEN ARBITRARY    |'
##    printlh ' |  APERTURES ARE USED FOR BACKGROUND SUBTRACTION AND MEASUREMENTS. |'
##    printlh ' |  THIS IS *NOT* A STANDARD WAY OF SOURCE EXTRACTION; ONE HAS TO   |'
##    printlh ' |  TEST THE EFFECTS EXTENSIVELY BEFORE PUBLISHING ANY RESULTS.     |'
##    printlh ' |                                                                  |'
##    printlh ' |  THE USER SHOULD KNOW EXACTLY WHAT IS BEING DONE AND WILL TAKE   |'
##    printlh ' |  FULL RESPONSIBILITY FOR ACTIVATING THIS FEATURE OF '$script'.  |'
##    printlh ' |__________________________________________________________________|'
##    printlh
##    printl "%s" '~> PRESS '$lred'ENTER'$gra' TO AGREE: '
##    read -r -s answer; printlh
##  fi

  printlh '_______________________________________________________________________________'

  'GET_IMAGE_SCALES'; chk_rc

  fun=$funo
}

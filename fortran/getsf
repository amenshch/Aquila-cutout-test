            'Use MODFITS to set BZERO to 0.0 and then run '$script
  fi

# Check the image for correctness of the keyword BSCALE.

  $path'/readhead' save BSCALE $fpath'/'$origimage $verb$cwavenum &> $hell; rch=$?
  if [[ $rch -eq 0 ]]; then read -r bscalec bscale < '.+readhead'$cwavenum; chk_rc; \rm -f '.+readhead'$cwavenum 2>$hell; fi

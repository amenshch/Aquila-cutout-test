POWERLAW ()
{
  maxlines=10
  local plawdata="$1"; local exp="$2"; local arg0="$3"; local arg1="$4"; local arg2="$5"; local scale="$6"
  for (( i=1; i <= $maxlines; i++ )); do fun0[i]="$7"; shift; done
  scale=${scale/1e/}
  for (( i=1; i <= $maxlines; i++ ))
  do
    fun1[i]=$(echo "scale=10; ${fun0[i]}*e(l($arg1/$arg0)*$exp)" | bc -l)
    fun2[i]=$(echo "scale=10; ${fun0[i]}*e(l($arg2/$arg0)*$exp)" | bc -l)
    if [[ ${fun1[i]:0:1} == '.' ]]; then fun1[i]='0'${fun1[i]}; fi; fun1[i]=${fun1[i]:0:7}
    if [[ ${fun2[i]:0:1} == '.' ]]; then fun2[i]='0'${fun2[i]}; fi; fun2[i]=${fun2[i]:0:7}
    if [[ ${arg1:0:1} == '.' ]]; then arg1='0'$arg1; fi; arg1=$arg1'000000000'; arg1=${arg1:0:9}
    if [[ ${arg2:0:1} == '.' ]]; then arg2='0'$arg2; fi; arg2=$arg2'000000000'; arg2=${arg2:0:9}
    fun1[i]=${fun1[i]}'e'$scale
    fun2[i]=${fun2[i]}'e'$scale
  done
  echo ";"                                                                                                                         > $plawdata
  echo "; Helper power-law lines (exponent = $exp)"                                                                               >> $plawdata
  echo ";"                                                                                                                        >> $plawdata
  echo "; ARGUMENT  FUNCTION1  FUNCTION2  FUNCTION3  FUNCTION4  FUNCTION5  FUNCTION6  FUNCTION7  FUNCTION8  FUNCTION9 FUNCTION10" >> $plawdata
  echo ";"                                                                                                                        >> $plawdata
  echo " $arg1 ${fun1[1]} ${fun1[2]} ${fun1[3]} ${fun1[4]} ${fun1[5]} ${fun1[6]} ${fun1[7]} ${fun1[8]} ${fun1[9]} ${fun1[10]}"    >> $plawdata
  echo " $arg2 ${fun2[1]} ${fun2[2]} ${fun2[3]} ${fun2[4]} ${fun2[5]} ${fun2[6]} ${fun2[7]} ${fun2[8]} ${fun2[9]} ${fun2[10]}"    >> $plawdata
}

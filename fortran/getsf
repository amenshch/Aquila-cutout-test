VISUALIZE_RESULTS ()
{
  local funo=$fun; fun='VISUALIZE_RESULTS'; local title=$script': => ('$istep') '\'$fun\'
  local whatvis="$1"

  if [[ $visualize == "no" || ($sources == 'no' && $filaments == 'no') || \
       ($sources == 'no' && $whatvis == 'sources') || ($filaments == 'no' && $whatvis == 'filaments') ]]
  then 
    if [[ $sources == 'yes' && $whatvis == 'sources' || $sources == 'no' && $whatvis == 'filaments' ]]
    then printlh; printlh ' '"$title"' ~~~> skipping...'
    fi
    fun=$funo; return 0
  else printlh; printlh ' '"$title"' '$whatvis
  fi
  visual_beg=`date +%s`; cdate=`date +%d\ %b\ %Y\ %a\ %H:%M:%S\ %Z`

##  catname=$catalogs'/'$prefix$dotsw'.sources.cat'
  catokname=$catalogs'/'$prefix$dotsw'.sources.ok.cat'
  finellname=$srcvisuals'/'$prefix$dotsw'.sources.ell'
  findotname=$srcvisuals'/'$prefix$dotsw'.sources.dot'
  finfooname=$srcvisuals'/'$prefix$dotsw'.sources.foo'
  finallname=$srcvisuals'/'$prefix$dotsw'.sources.foo.all'
  
  peaksnratmin=$snratio1min
  'CALCULATE' thickell2 "$thickell/2" 2

  if [[ $whatvis == 'sources' ]]
  then
    'READ_COMBINATION_FILE' $fileswcombining

    \mkdir -p $srcvisuals 2>$hell

    ($path'/modfits' multiply 0 ${measuremtclone[1]} -o $finallname $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  
    for (( i=1; i <= $nwaves; i++ ))
    do
##      if [[ $nwaves -eq 1 ]]; then iw=''; else iw=$i; fi
      if [[ $verb == "-verb0" ]]
      then 'PROGRESS_BAR' "PLOTTING SOURCES" $i 1 $nwaves 79 "·"; outsameline='yes'
      fi                                                               
  
# Overlay ellipses onto input image in places where the sources were found. Create a sub-directory first.
  
      partdet=${wave[i]}'.det'
      partobs=${wave[i]}'.obs'
      partdetss=${wave[i]}'.det.src'
      partobsss=${wave[i]}'.obs.src'
      partobsso=${wave[i]}'.obs.src.n'
      partobsfo=${wave[i]}'.obs.fil'
      origimage=${imagepath[i]}'/'${obsimage[i]}
      detsimage=$separated'/'${detectionclone[i]}'.sources'${zsrcmaxsize[i]}
      obssimage=$separated'/'${measuremtclone[i]}'.sources'${zsrcmaxsize[i]}
      obssimagen=$separated'/'${measuremtclone[i]}'.sources.n'${zsrcmaxsize[i]}
      obsfoots=$srcvisuals'/'${obsfootprints[i]}
##      ogsfoota=$srcvisuals'/'${obsfootprinta[i]}

      if [[ -e $obsfoots'.fits' ]]
      then ($path'/operate' ${imagebsomask[i]} x $obsfoots -o $obsfoots $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      fi
##      if [[ -e $obsfoota'.fits' && (${aperture[i]:0:1} == "+" || ${aperture[i]:0:1} == "-") ]]
##      then ($path'/operate' ${imagebsomask[i]} x $ofsfoota -o $srcvisuals'/'$obsfoota $verb; echo $? > '.rc'$cwavenum) | 'tehi'
##      fi

      ($path'/ellipses' getsf $i ${beam[i]} $goodmin $sigmamin $peaksnratmin $snratio2min $catokname $origimage \
                        1.0 1.1 $thickell ${rcolx[i]} -o $finellname'.'$partobs $verb; echo $? > '.rc'$cwavenum) | 'tehi'

      \mv -f $catokname'.ell.phy.reg' $catokname'.'${wave[i]}'.ell.phy.reg' #2>$hell
      \mv -f $catokname'.ell.fk5.reg' $catokname'.'${wave[i]}'.ell.fk5.reg' #2>$hell
      \mv -f $catokname'.good' $catokname'.'${wave[i]}'.good' #2>$hell
  
      ($path'/ellipses' getsf $i ${beam[i]} $goodmin $sigmamin $peaksnratmin $snratio2min $catokname $origimage \
                        1.0 1.1 '+'$thickell ${rcolx[i]} -o $finfooname'.'$partobs $verb; echo $? > '.rc'$cwavenum) | 'tehi'

      \mv -f $catokname'.foo.phy.reg' $catokname'.'${wave[i]}'.foo.phy.reg' #2>$hell
      \mv -f $catokname'.foo.fk5.reg' $catokname'.'${wave[i]}'.foo.fk5.reg' #2>$hell
      \mv -f $catokname'.good' $catokname'.'${wave[i]}'.good' #2>$hell
  
      ($path'/ellipses' getsf $i ${beam[i]} $goodmin $sigmamin $peaksnratmin $snratio2min $catokname $detsimage \
                        1.0 1.1 $thickell -o $finellname'.'$partdetss $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  
      ($path'/ellipses' getsf $i ${beam[i]} $goodmin $sigmamin $peaksnratmin $snratio2min $catokname $obssimage \
                        1.0 1.1 $thickell -o $finellname'.'$partobsss $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  
      ($path'/ellipses' getsf $i ${beam[i]} $goodmin $sigmamin $peaksnratmin $snratio2min $catokname $detsimage \
                        1.0 1.1 '+'$thickell -o $finfooname'.'$partdetss $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  
      ($path'/ellipses' getsf $i ${beam[i]} $goodmin $sigmamin $peaksnratmin $snratio2min $catokname $obssimage \
                        1.0 1.1 '+'$thickell -o $finfooname'.'$partobsss $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  
      ($path'/ellipses' getsf $i ${beam[i]} $goodmin $sigmamin $peaksnratmin $snratio2min $catokname $obssimagen \
                        1.0 1.1 $thickell -o $finellname'.'$partobsso $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  
      ($path'/ellipses' getsf $i ${beam[i]} $goodmin $sigmamin $peaksnratmin $snratio2min $catokname $obssimagen \
                        1.0 1.1 '+'$thickell -o $finfooname'.'$partobsso $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  
      ($path'/ellipses' getsf $i ${beam[i]} $goodmin $sigmamin $peaksnratmin $snratio2min $catokname $finallname \
                        1.0 '+'$i '+'$thickell2 -o $finallname $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      
      ($path'/operate' ${imageomask[i]} x $finellname'.'$partdetss -o $finellname'.'$partdetss $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/operate' ${imageomask[i]} x $finfooname'.'$partdetss -o $finfooname'.'$partdetss $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/operate' ${imageomask[i]} x $finellname'.'$partobsss -o $finellname'.'$partobsss $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/operate' ${imageomask[i]} x $finfooname'.'$partobsss -o $finfooname'.'$partobsss $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/operate' ${imageomask[i]} x $finellname'.'$partobsso -o $finellname'.'$partobsso $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/operate' ${imageomask[i]} x $finfooname'.'$partobsso -o $finfooname'.'$partobsso $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  
      if [[ -e $components'/'${measuremtclone[i]}'.filaments.fits' ]]
      then
        ($path'/ellipses' getsf $i ${beam[i]} $goodmin $sigmamin $peaksnratmin $snratio2min $catokname \
                          $components'/'${measuremtclone[i]}'.filaments' 1.0 1.1 $thickell ${regcolx[i]} \
                          -o $finellname'.'$partobsfo $verb; echo $? > '.rc'$cwavenum) | 'tehi'

        ($path'/ellipses' getsf $i ${beam[i]} $goodmin $sigmamin $peaksnratmin $snratio2min $catokname \
                          $components'/'${measuremtclone[i]}'.filaments' 1.0 1.1 '+'$thickell ${regcolx[i]} \
                          -o $finfooname'.'$partobsfo $verb; echo $? > '.rc'$cwavenum) | 'tehi'

        ($path'/operate' ${imageomask[i]} x $finellname'.'$partobsfo -o $finellname'.'$partobsfo $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/operate' ${imageomask[i]} x $finfooname'.'$partobsfo -o $finfooname'.'$partobsfo $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      fi
    done
    
    \rm -f $catokname'.ell.'*'.reg' 2>$hell
    \rm -f $catokname'.foo.'*'.reg' 2>$hell
    \rm -f $catokname'.good' 2>$hell

    if [[ $verb == "-verb0" ]]
    then 'PROGRESS_BAR' 'complete' $nwaves 1 $nwaves 79 "·"; outsameline='no'
    fi
  fi

  if [[ $whatvis == 'filaments' ]]
  then
    'READ_COMBINATION_FILE' $filefwcombining
    'SKELETON_LEVELS'
    'FILAMENT_SCALES' $beammincombofil $filmaxsizemax

# Visualize scale-dependent filaments without smaller scales.

    for (( i=1; i <= $nwaves; i++ ))
    do
      if [[ $nwaves -eq 1 ]]; then iw=''; else iw=$i; fi
      \mkdir -p ${filvisuals[i]} 2>$hell
      obsfilamentsbs=$components'/'${measuremtclone[i]}'.filaments'${zfilmaxsize[i]}
      detfilamen=$prefix$dotfw'.det'
      obsfilamen=$prefix$dotfw'.'${wave[i]}'.obs'

      nprogbar=$(( nsklevs + nsfils * nsklevs + 1 ))
      nt=0

# Overlay the global skeletons on the filament images for illustrations.

      for (( kk=1; kk <= $nsklevs; kk++ ))
      do
        nt=$(( nt + 1 ))
        if [[ $verb == "-verb0" ]]
        then 'PROGRESS_BAR' "VISUALIZING FILAMENTS $iw" $nt 1 $nprogbar 79 "·"; outsameline='yes'
        fi                                                               
        zkk=${zsklev[kk]}
        globskels=$skeletons'/+globals/'$detfilamen'.skeletons.global.s'$zkk
    
        ($path'/imgstat' savein -nomed $globskels ${imageomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
        read -r min max mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
        'CHECK_IMGSTAT' $min $max '' $script $fun $funo '1'
        'COMPARE_FLOATS' $max '>' '0.0' rcnonzero
    
        if [[ $rcnonzero -eq 1 ]]
        then
          ($path'/modfits' maximum 1 n $globskels -o $globskels'.m1' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          \cp -f $globskels'.m1.fits' $globskels'.m2.fits'
          for (( it=1; it <= $thickske; it++ ))
          do ($path'/modfits' thicken $globskels'.m1' -o $globskels'.m1' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          done
          for (( it=1; it <= $thickske2; it++ ))
          do ($path'/modfits' thicken $globskels'.m2' -o $globskels'.m2' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          done

          ($path'/operate' $obsfilamentsbs x $globskels'.m1' -o $globskels'.m3' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/operate' $obsfilamentsbs x $globskels'.m2' -o $globskels'.m4' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/modfits' multiply 2 $globskels'.m3' -o $globskels'.m3' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/operate' $obsfilamentsbs - $globskels'.m4' -o $globskels'.m5' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/operate' $globskels'.m5' + $globskels'.m3' \
                        -o ${filvisuals[i]}'/'$obsfilamen'.filaments+ske.global.s'$zkk \
                           $verb; echo $? > '.rc'$cwavenum) | 'tehi'

# Apply observational mask to the filament images to clean up.

          ($path'/operate' ${imageomask[i]} x ${filvisuals[i]}'/'$obsfilamen'.filaments+ske.global.s'$zkk \
                        -o ${filvisuals[i]}'/'$obsfilamen'.filaments+ske.global.s'$zkk \
                           $verb; echo $? > '.rc'$cwavenum) | 'tehi'

          \cp $globskels'.reg' ${filvisuals[i]}'/'$obsfilamen'.filaments+ske.global.s'$zkk'.reg' 2>$hell
          \rm -f $globskels'.m'?'.fits' 2>$hell
        fi
      done

      \mkdir -p ${filvisuals[i]}'/+nosmall' 2>$hell
      decompose[i]=${dirmono[i]}'/'${measuremtclone[i]}'.decompose'

      nt=$(( nt + 1 ))
      if [[ $verb == "-verb0" ]]
      then 'PROGRESS_BAR' "VISUALIZING FILAMENTS $iw" $nt 1 $nprogbar 79 "·"; outsameline='yes'
      fi                                                               
      'DECOMPOSE_IMAGES' $i 'visorigin' ${measuremtclone[i]}; chk_rc
      'READ_DECOMPOSE_FILE' ${decompose[i]}

# Determine if the current run is an additional for measurements of smaller scales.
      
      nsf=0
      for fname in $skeletons'/'$detfilamen'.ske.'????'as.fits'
      do
        nsf=$(( nsf + 1 ))
        skelsmax="${fname/as.fits/}"
        skelsmax=${skelsmax/$skeletons\/$detfilamen'.ske.'/}
      done
      zfilmaxs=${zfilmaxsize[i]/.s/}
      zfilmaxs=${zfilmaxs/as/}
      'LEADZEROS' 3 $zfilmaxs zfilmaxs
      if [[ $zfilmaxs -lt $skelsmax ]]
      then additionalscale='yes'
      else additionalscale='no'
      fi

# Overlay the accurate scale-dependent skeletons on the filament images for an illustration.

      for (( k=1; k <= $nsfils; k++ ))
      do
        zk=${zfilscale[k]}'as'

        for (( kk=1; kk <= $nsklevs; kk++ ))
        do
          nt=$(( nt + 1 ))
          if [[ $verb == "-verb0" ]]
          then 'PROGRESS_BAR' "VISUALIZING FILAMENTS $iw" $nt 1 $nprogbar 79 "·"; outsameline='yes'
          fi                                                               
          if [[ $additionalscale == 'no' ]]
          then
            zkk=${zsklev[kk]}
            outskels=$skeletons'/+globals/'$detfilamen'.skeletons.'$zk'.s'$zkk
        
            if [[ -e $outskels'.fits' ]]
            then
              ($path'/imgstat' savein -nomed $outskels ${imageomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
              read -r min max mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
              'CHECK_IMGSTAT' $min $max '' $script $fun $funo '1'
              'COMPARE_FLOATS' $max '>' '0.0' rcnonzero
              if [[ $rcnonzero -eq 1 ]]
              then
                ($path'/modfits' maximum 1 n $outskels -o $outskels'.m1' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
                \cp -f $outskels'.m1.fits' $outskels'.m2.fits'
                for (( it=1; it <= $thickske; it++ ))
                do ($path'/modfits' thicken $outskels'.m1' -o $outskels'.m1' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
                done
                for (( it=1; it <= $thickske2; it++ ))
                do ($path'/modfits' thicken $outskels'.m2' -o $outskels'.m2' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
                done
          
                ($path'/operate' $obsfilamentsbs x $outskels'.m1' -o $outskels'.m3' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
                ($path'/operate' $obsfilamentsbs x $outskels'.m2' -o $outskels'.m4' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
                ($path'/modfits' multiply 2 $outskels'.m3' -o $outskels'.m3' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
                ($path'/operate' $obsfilamentsbs - $outskels'.m4' -o $outskels'.m5' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
                ($path'/operate' $outskels'.m5' + $outskels'.m3' -o ${filvisuals[i]}'/'$obsfilamen'.filaments+ske.'$zk'.s'$zkk \
                                 $verb; echo $? > '.rc'$cwavenum) | 'tehi'

# Apply observational mask to the filament images to clean up.

                ($path'/operate' ${imageomask[i]} x ${filvisuals[i]}'/'$obsfilamen'.filaments+ske.'$zk'.s'$zkk \
                              -o ${filvisuals[i]}'/'$obsfilamen'.filaments+ske.'$zk'.s'$zkk $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          
                ds9regskels=${filmeasure[i]}'/+profiles/'${wave[i]}'/'$obsfilamen'.ske.'$zk'.s'$zkk'~coords.reg'
                \cp $ds9regskels ${filvisuals[i]}'/'$obsfilamen'.filaments+ske.'$zk'.s'$zkk'.reg' 2>$hell
                \rm -f $outskels'.m'?'.fits' 2>$hell
              fi
            fi
          fi
        done

# Remove scales larger than the current one from a filament component image, for an illustration.

        imagebig=${dirmono[i]}'/'${measuremtclone[i]}'.c'${sbeam[nsbeams]}'as'
        obsfilamentzz=${filvisuals[i]}'/+nosmall/'$prefix$dotfw'.'${wave[i]}'.obs.filaments.a'$zk

        ($path'/modfits' multiply 0 ${measuremtclone[i]} -o $obsfilamentzz $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/operate' $obsfilamentzz + $imagebig -o $obsfilamentzz $verb; echo $? > '.rc'$cwavenum) | 'tehi'

        'CALCULATE' scalemin "0.999*${filscale[k]}/$factfilscale" 20
  
        for (( j=$nsbeams; j >= $nsbeg; j-- ))
        do
          sscimage=${dirmono[i]}'/'${measuremtclone[i]}'.'${nscbeam[j]}
          if [[ -e $sscimage'.fits' ]]
          then
            'COMPARE_FLOATS' ${sbeam[j]} '>=' $scalemin rslt1
            if [[ $rslt1 -eq 1 ]]
            then
              ($path'/operate' $filcoaddedomask x $sscimage -o $sscimagefil'.fi' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
              ($path'/operate' $obsfilamentzz + $sscimagefil'.fi' -o $obsfilamentzz $verb; echo $? > '.rc'$cwavenum) | 'tehi'
              \rm -f $sscimagefil'.fi.fits' 2>$hell
            fi  
          fi
        done
        ($path'/operate' ${imageomask[i]} x $obsfilamentzz -o $obsfilamentzz $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      done

      if [[ $verb == "-verb0" ]]
      then 'PROGRESS_BAR' 'complete' $nprogbar 1 $nprogbar 79 "·"; outsameline='no'
      fi
      \rmdir ${filvisuals[i]} 2>$hell
    done
  fi

  visual_end=`date +%s`; visual_time=$(( visual_end - visual_beg ))
  'CALCULATE' visual_minutes "$visual_time/60" 3
  printlh; printlh ' '$script': '$visual_minutes' MINUTES'
  fun=$funo
}

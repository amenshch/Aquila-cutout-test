
 nphot = 2000000000    ! Number of photons
 setthreads = 4        ! number of threads used for thermal Monte Carlo computation

 distpc = 260.0         ! Distance (pc) to model
 dust2gas = 0.01        ! Dust-to-gas mass ratio
 external = 1           ! External ISRF (1) or none (0)
 hbbfac = 6.19e-16      ! ISRF hot BB dilution factor (= 6.19e-16 for G0 = 10)
                        
 cylinder = 1           ! Cylinder model (1) or the spherical models (0)
 cylembsd = 0.0         ! Surface density of the embedding envelope
 cylrenv = 0.0          ! Cyliner envelope radius (pc)
 cylsd = 3.0e22         ! Surface density of H2 on the axis (cm^-2), through the axis perpendicular to it
 cylfwhm = 80.0         ! Half-maximum width of the surface density across the axis (arcsec)
 cylpind = 1.75         ! Index p of the density profile n(R) = n_c [1 + (R/R_flat)^2]^(-p/2)
 cylrout = 0.5          ! Outer radius of the cylinder (pc)
 cyllen = 7.234         ! Length of the cylinder (pc), equal to the side of the simsky4 images
 nrcyl = 400            ! Grid cells in r
 nthcyl = 240           ! Grid cells in theta, from 0 to pi/2 (mirrored in the equatorial plane)
                        
 Rinner = 0.0           ! Inner radius (AU) of model space (if 0.0 then chosen automatically)
 Router = 0.0           ! Outer radius (AU) of model space (if 0.0 then chosen automatically)
 nzones = 50            ! Total number of radial zones (entire model space)
 fgeom = 10.0           ! Geometric grid factor
 nzembc = 15            ! Number of radial zones in embedding cloud
 ftrans = 1.3           ! Coarser grid of cloud (0.0 for none): fractional transition radius (1.3)
                        
 Rgauss = 0.0           ! Radius (AU) of Gaussian sphere (or 0.0 if no Gaussian sphere)
 gfwhm = 100.0          ! Full width at half maximum (AU) of Gaussian sphere
 gplaw = 2.0            ! Exponent of power law attached to Gaussian sphere
                        
 Rbesph = 1.0           ! BE sphere (1.0) or no BE sphere (0.0)
 besden = 1.224900e-17  ! Density (g/cm^3) of BE sphere
 bestem = 6.750000      ! Temperature (K) of BE sphere
 ximax = 52.2973        ! xi_max of BE sphere (6.451 for critical)
                        
 Rplawx = 0.0           ! Radius (AU) of power-law envelope (or 0.0 if no envelope)
 dplawx = 0.0           ! Power-law exponent of the envelope density distribution
                        
 rhofac = 0.0           ! Density jump factor at inner edge of embedding cloud
 dplout = 0.0           ! Power-law exponent of embedding cloud densities
 embden = 1.920000e+23  ! Embedding cloud surface density
                        
 masstot = 0.0          ! Model mass (Msun)
 lumstar = 0.0          ! Stellar luminosity (Lsun)
 temstar = 5778.0       ! Effective temperature (K)
                        
 mcrscale = 1.0         ! Model scaling factor (radii)
 radscale = 1.0         ! Global scaling factor (radii)
 denscale = 1.0         ! Global scaling factor (densities)
                        
 fracaper = 1.0         ! Observational aperture as fraction of Rbesph or Rplawx

 scattering_mode_max = 1    ! Isotropic scattering (1) or no scattering (0)
 modified_random_walk = 1   ! Мodified random walk method (1) or not (0)

               "fix is to multiply the image by 1 using MODFITS: modfits multiply 1 $origimage -o $origimage"
  fi
  if [[ $crval2 != $declin ]]
  then printlh 
    'ERROR' "The keywords CRVAL2: $crval2 and DEC: $declin do not match in $fpath'/'$origimage'.fits'" \
            "Use READHEAD, MODFITS to correct the header and then run $script. The easiest" \
            "fix is to multiply the image by 1 using MODFITS: modfits multiply 1 $origimage -o $origimage"
  fi
  if [[ ${ctype1:1:5} != "RA---" ]]
  then printlh 
    'ERROR' "Invalid value of CTYPE1: $ctype1 in" $fpath'/'$origimage'.fits' \
            "Use MODFITS to make equatorial CTYPE1 = RA---???."
  fi
  if [[ ${ctype2:1:5} != "DEC--" ]]
  then printlh 
    'ERROR' "Invalid value of CTYPE2: $ctype2 in" $fpath'/'$origimage'.fits' \
            "Use MODFITS to make equatorial CTYPE2 = DEC--???."
  fi

  if [[ $abort == "yes" ]]
  then printlh; fun=$funo; return 99
  fi

  $path'/readhead' save WAVE $fpath'/'$origimage $verb$cwavenum &> $hell; rch=$?; \rm -f '.+readhead'$cwavenum 2>$hell
 
  if [[ $rch -eq 2 ]]
  then printlh
    printlh ' '$script': '$fun': WARNING: Inserting missing WAVE keyword...'
    ($path'/modfits' keyword WAVE $wavelength $fpath'/'$origimage -o $cloneimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  fi

  fun=$funo
}

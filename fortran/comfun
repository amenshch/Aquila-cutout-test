chk_rc ()
{ 
  rc=$?
  if [[ $rc -eq 0 && "$1" != "" ]]; then rc=$1; fi
  if [[ $rc -gt 0 ]]
  then 
    where=$script
    if [[ $fun != "" ]]
    then where="$where: '$fun'"; fi
    printlh " $where: ERROR (RC=$rc)"
    kill -SIGTERM $top_pid
  fi
  return $rc
}

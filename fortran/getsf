GET_SMOOTHING_BEAMS ()
{          
  local funo=$fun; fun='GET_SMOOTHING_BEAMS'; local title=$script': => ('$istep') '\'$fun\'
  local i; local j; local hibound; local lobound; local scalemaxsize
  local firstscaleminimum; local cfgbeamminm; local bigbeam; local dxasm

# Define default (automatic, optimal) values for the first (smallest) scale.

  'CALCULATE' dxasm "2*$dxas" 20
  'CALCULATE' cfgbeamminm "$fsbelowbeam*$cfgbeammin" 20
  'COMPARE_FLOATS' $dxasm '<' $cfgbeamminm rslt
  
  if [[ $rslt -eq 1 ]]
  then firstscaleminimum=$cfgbeamminm
  else firstscaleminimum=$dxasm
  fi
  if [[ $scale1 == "0" ]]
  then scale1=$firstscaleminimum
  fi
  if [[ ${scale1:0:1} == "." ]]
  then scale1='0'$scale1
  fi

# Limit the largest smoothing beam.

  'COMPARE_FLOATS' $sidexas '<=' $sideyas rslt
  if [[ $rslt -eq 1 ]]
  then sizeimage=$sidexas
  else sizeimage=$sideyas
  fi

  'CALCULATE' scalemaxstruc "$xscalestruc*$cfgmaxstrucsize" 20
  'CALCULATE' scalemaxffact "$xscaleffact*$cfgmaxstrucsize" 20

  'COMPARE_FLOATS' $scalemaxstruc '>' $scalemaxffact rslt
  if [[ $rslt -eq 1 ]]
  then scalemaxsize=$scalemaxstruc
  else scalemaxsize=$scalemaxffact
  fi

  'CALCULATE' sfactor "1.00001*e(l($scalemaxsize/$scale1)/($nscales))" 20

  'COMPARE_FLOATS' $sfactor '<' $sfactormin rslt
  if [[ $rslt -eq 1 ]]
  then sfactor=$sfactormin
  fi

  'CALCULATE' scale1 "$scale1/$sfactor" 20
  'POSITION' '.' $scale1 ndot
  ndig=$(( 6 - ndot ))
  'ROUND_FLOAT' $ndig $scale1 scale1
  'CALCULATE' sfactor "1.00001*e(l($scalemaxsize/$scale1)/($nscales))" 20

  'COMPARE_FLOATS' $sfactor '<' $sfactormin rslt
  if [[ $rslt -eq 1 ]]
  then sfactor=$sfactormin
  fi
  'CALCULATE' hibound "$scalemaxsize*$sfactor" 20
  lobound=$scalemaxsize
  'CALCULATE' firstscaleminimumx "$firstscaleminimum/$sfactor" 20
  'ROUND_FLOAT' $ndig $firstscaleminimumx firstscaleminimumx
  'COMPARE_FLOATS' $scale1 '<' $firstscaleminimumx rslt

  if [[ $rslt -eq 1 ]]
  then printlh
    printlh ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
    printlh ' '$script': WARNING: First scale too small for a beam of '$cfgbeammin' arcsec'
    printlh ' '$script': WARNING: Scale1: '$scale1' arcsec < First scale: '${firstscaleminimumx:0:11}' arcsec'
    printlh ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
    printlh ' '$script':  ADVICE: Change scale1 to '${firstscaleminimumx:0:11}' arcsec (timeout 1 min)...'
    printlh ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
    waitingforinput='yes'
    read -r -s -t 60 answer; rc=$?
    waitingforinput='no'
  fi

  'COMPARE_FLOATS' $sizeimage '<' $scalemaxsize rslt
  if [[ $rslt -eq 1 ]]
  then printlh
    printlh ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
    printlh ' '$script': WARNING: Image too small for largest scales of '$scalemaxsize' arcsec'
    printlh ' '$script': Full image: '${sizeimage:0:6}' arcsec < Required size: '$scalemaxsize' arcsec'
    printlh ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
    printlh ' '$script':  ADVICE: If the extraction is done on a sub-field of a large'
    printlh ' '$script':          field, think about cutting out a larger sub-field with a'
    printlh ' '$script':          size of at least '$scalemaxsize' arcsec (timeout 1 min)...'
    printlh ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
    waitingforinput='yes'
    read -r -s -t 60 answer; rc=$?
    waitingforinput='no'
  fi
  if [[ $verb != "-verb0" ]]; then printlh; fi

# Initialize variables and starting scale.

  j=0; sbeam[0]=0; nb1=0
  if [[ $nscales -gt 0 ]]
  then nscalesmax=$(( nscales + 1 ))
  else nscalesmax=100
  fi
  'CALCULATE' scale "$scale1*1.00000001" 20
  scaleo=$scale
  
# Define beams for smoothing to different scales, as well as additional beams and pixels.
# Compute scale (in arcseconds) between the beam size and the entire image scale.

  'COMPARE_FLOATS' $scale '<=' $hibound rslthi

  while [[ $rslthi -eq 1 ]]
  do
    jm1=$j; j=$(( j + 1 )); 'LEADZEROS' 1 $j zj

    'CALCULATE' scale "$scale*$sfactor" 20
    sbeam[j]=$scale
    'POSITION' '.' ${sbeam[j]} ndot
    ndig=$(( 6 - ndot ))
    'ROUND_FLOAT' $ndig ${sbeam[j]} sbeam[j]
    
    'COMPARE_FLOATS' ${sbeam[j]} '<=' $hibound rslthi
    'COMPARE_FLOATS' ${sbeam[j]} '>=' $lobound rsltlo
    'COMPARE_FLOATS' ${sbeam[j]} '>=' $scale1 rslt

    if [[ $rslt -eq 1 ]]
    then
      if [[ $nb1 -eq 0 ]]; then nb1=$j; fi

# Additional beams to convolve to next resolution (incrementally).

      if [[ $j -eq 1 ]]
      then addbeam[j]=$scale
      else 'CALCULATE' addbeam[j] "sqrt(${sbeam[j]}^2-${sbeam[jm1]}^2)" 20
      fi
      'ROUND_FLOAT' $ndig ${addbeam[j]} addbeam[j]

      if [[ $j -ge $nscalesmax && $rsltlo -eq 0 ]]
      then printlh
        if [[ $nscales -eq 0 ]]
        then
          printlh ' '$script': '$fun': WARNING:'; printlh
          printlh '   Could not reach maximum range of' $lobound'~'$hibound 'arcsec'
          printlh '   One can reduce image size or increase sfactor'; sleep 3
        fi
        break
      fi
      if [[ $j -lt $nscalesmax ]]
      then 
        nsbeams=$j
        'CALCULATE' ratio "$scale/$scaleo" 20

# Some informational output.

        if [[ $verb != "-verb0" ]]
        then printlh ' smobeam' $zj':' ${sbeam[j]} 'ratio:' ${ratio:0:8} 'addbeam:' ${addbeam[j]}
        fi
      fi
      if [[ ($separate == 'yes' || $flatten == 'yes' || $complete == 'yes') && $rsltlo -eq 1 && $rslthi -eq 1 ]]
      then printlh
        printlh ' '$script': Scale sizes reached maximum range of' ${lobound:0:6}'~'${hibound:0:6} 'arcsec'; break
      fi
    fi
    scaleo=$scale
  done
  nums=$(( nsbeams + 1 - nb1 ))
  bigbeam=${sbeam[nsbeams]}
  nscalesmax=$nsbeams

  if [[ ($separate == 'yes' || $flatten == 'yes' || $complete == 'yes') ]]
  then
    printlh ' '$script': Total of '$nums' scales between '${sbeam[nb1]}' and '${sbeam[nsbeams]}' arcsec'
    printlh ' '$script': Scale factor used: '$sfactor
  fi

  if [[ ${bigbeam%.*} -lt ${scalemaxsize%.*} ]]
  then 'ERROR' 'Scales could not reach SCALEMAXSIZE ('${scalemaxsize%.*}' arcsec)'
  fi

  if [[ $nsdet1 -lt 1 || ($nscales -gt 0 && $nsdet1 -gt $nscales) ]]
  then nsdet1=1; printlh
    printlh ' '$script': '$fun': WARNING: Parameter nsdet1 has been reset to 1.'
  fi
  
  fun=$funo
}

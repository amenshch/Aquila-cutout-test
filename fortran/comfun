GAUSSIAN ()
{
  local gausdata="$1"; local fwhm="$2"; local scale="$3"; local arg1="$4"; local arg2="$5"; local fun0="$6"
  npts=50; delta=$(echo "scale=7; ($arg2-$arg1)/$npts" | bc)
  echo ";"                                        > $gausdata
  echo "; Helper Gaussian (FWHM = $fwhm arcsec)" >> $gausdata
  echo ";"                                       >> $gausdata
  echo "; ARGUMENT  GAUSSIAN"                    >> $gausdata
  echo ";"                                       >> $gausdata
  for (( i=1; i <= $npts; i++ ))
  do
    arg[i]=$(echo "scale=10; $arg1+($i-1)*$delta" | bc)
    fun[i]=$(echo "scale=10; $scale*$fun0/e(${arg[i]}^2/(2*($fwhm/2)^2/l(4)))" | bc -l)
    if [[ ${arg[i]:0:1} == '.' ]]; then arg[i]='0'${arg[i]}; fi; arg[i]=${arg[i]}'00000000'; arg[i]=${arg[i]:0:9}
    if [[ ${fun[i]:0:1} == '.' ]]; then fun[i]='0'${fun[i]}; fi; fun[i]=${fun[i]:0:30}
    echo " ${arg[i]}  ${fun[i]}" >> $gausdata
  done
}

GET_BACK_FLATTEN ()
{                          
  local funo=$fun; fun='GET_BACK_FLATTEN'; local title=$script': => ('$istep') '\'$fun\'; local i

  if [[ ($sources == 'no' && $filaments == 'no') || \
       (($separate == "no" || ($itsrc1 -eq 0 && $itfil1 -eq 0)) && \
        ($flatten  == "no" || ($itstd1 -eq 0 && $itftd1 -eq 0))) ]]
  then printlh; printlh ' '"$title"' ~~~~> skipping...'; fun=$funo; return 0
  fi
  flatten_beg=`date +%s`; cdate=`date +%d\ %b\ %Y\ %a\ %H:%M:%S\ %Z`

  for (( istr=1; istr <= 4; istr++ ))
  do
    if [[ ($istr -eq 1 && ($sources   == 'no' || $separate == 'no' || $itsrc1 -eq 0)) || \
          ($istr -eq 2 && ($filaments == 'no' || $separate == 'no' || $itfil1 -eq 0)) || \
          ($istr -eq 3 && ($sources   == 'no' || $flatten  == 'no' || $itstd1 -le 0)) || \
          ($istr -eq 4 && ($filaments == 'no' || $flatten  == 'no' || $itftd1 -le 0)) ]]
    then continue                                                           # ^^^^^: "-le 0" for a trick with constant flattening image
    fi
    
    for (( i=$nwc1; i <= $nwaves; i++ ))
    do
      if [[ $istr -eq 1 ]]; then monoback[i]=${monosback[i]}; fi
      if [[ $istr -eq 2 ]]; then monoback[i]=${monofback[i]}; fi
      if [[ $istr -eq 3 ]]; then monoback[i]=${monosback[i]}; monofact[i]=${monosfact[i]}; fi
      if [[ $istr -eq 4 ]]; then monoback[i]=${monofback[i]}; monofact[i]=${monoffact[i]}; fi
      'CALCULATE' radstd[i] "1*${beam[i]}/$dxas" 2
    done

# Iterate background and create background-subtracted images.
  
    if [[ $istr -eq 1 || $istr -eq 2 ]]
    then
      printlh
      if [[ $istr -eq 1 ]]
      then
        itbgs1=$itsrc1
        if [[ $itbgs1 -eq 1 ]]
        then printlh ' '"$title"' sources'; printlh
        else printlh ' '"$title"' sources (restart iter '$itbgs1')'; printlh
        fi
      fi
      if [[ $istr -eq 2 ]]
      then 
        itbgs1=$itfil1
        if [[ $itbgs1 -eq 1 ]]
        then printlh ' '"$title"' filaments'; printlh
        else printlh ' '"$title"' filaments (restart iter '$itbgs1')'; printlh
        fi
      fi

# Copy the original (unprocessed) images to process them.

      for (( i=$nwc1; i <= $nwaves; i++ ))
      do  
        if [[ $itbgs1 -eq 1 ]]
        then 
          \mkdir -p ${monoback[i]} 2>$hell
          sourcesback=${monosback[i]}'/'${detectionclone[i]}'.bg'

          if [[ $istr -eq 1 || ($sources == 'no' && ! -e $sourcesback'.fits') ]]
          then
            subdirname='…/'`basename "${imagepath[i]}"`
            printlh ' Copying '$subdirname'/'${obsimage[i]}'.fits...'
            if [[ ! -e ${imagepath[i]}'/'${obsimage[i]}'.fits' ]]
            then 'ERROR' 'Detection image not found: '\'$subdirname'/'${obsimage[i]}'.fits'\'
            fi
            originalimage=${imagepath[i]}'/'${obsimage[i]}'.fits'
            \cp -f $originalimage ${detectionclone[i]}'.fits' #2>$hell
            \cp -f $originalimage ${monoback[i]}'/'${measuremtclone[i]}'.fits' #2>$hell
          fi          
          if [[ $istr -eq 2 && ($sources == 'yes' || -e $sourcesback'.fits') ]]
          then
            subdirname='…/'`basename "${monosback[i]}"`
            printlh ' Copying '$subdirname'/'${detectionclone[i]}'.bg.fits...'
            if [[ ! -e $sourcesback'.fits' ]]
            then 'ERROR' 'Detection image not found: '\'$subdirname'/'${detectionclone[i]}'.bg.fits'\'
            fi
            \cp -f $sourcesback'.fits' ${detectionclone[i]}'.fits' #2>$hell
            \cp -f $sourcesback'.fits' ${monoback[i]}'/'${measuremtclone[i]}'.fits' #2>$hell
          fi          
        else
          ns1m1=$(( itbgs1 - 1 ))
          'LEADZEROS' 1 $ns1m1 zns1m1
          subdirname='…/'`basename "${monoback[i]}"`
          printlh ' Copying '$subdirname'/'${detectionclone[i]}'.bg.'$zns1m1'.fits...'
          if [[ ! -e ${monoback[i]}'/'${detectionclone[i]}'.bg.'$zns1m1'.fits' ]]
          then 'ERROR' 'Detection image not found: '\'${monoback[i]}'/'${detectionclone[i]}'.bg.'$zns1m1'.fits'\'
          fi
          \cp -f ${monoback[i]}'/'${detectionclone[i]}'.bg.'$zns1m1'.fits' ${detectionclone[i]}'.fits' #2>$hell
        fi
        if [[ $istr -eq 2 ]]
        then 
          oimage=${monosback[i]}'/'${measuremtclone[i]}'.bg.s'${srcmaxsize[i]/./p}'as'
          if [[ $sources == 'no' && ! -e $oimage'.fits' ]]
          then 'ERROR' 'Original image not found: '\'$oimage'.fits'\'
          fi
        fi
        ($path'/expanda' 1 ${detectionclone[i]} ${imageomask[i]} -o ${detectionclone[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      done
      
      'SEPARATE_COMPONENTS' 'original'; chk_rc
  
      for (( i=$nwc1; i <= $nwaves; i++ ))
      do    
        \rm -f ${detectionclone[i]}'.fits' 2>$hell
        \rm -f ${detectionclone[i]}'.'*'as.fits' 2>$hell
        \cp -f ${decompose[i]} ${monoback[i]} #2>$hell
##        if [[ $istr -eq 1 ]]
##        then justname=`basename "${separatebg[i]}"`'.src'
##        fi
##        if [[ $istr -eq 2 ]]
##        then justname=`basename "${separatebg[i]}"`'.fil'
##        fi
##        \mv -f ${separatebg[i]} ${monoback[i]}'/'$justname 2>$hell

        if [[ $istr -eq 1 ]]; then namesuff=${srcmaxsize[i]/./p}; fi
        if [[ $istr -eq 2 ]]; then namesuff=${filmaxsize[i]/./p}; fi
  
        background=${monoback[i]}'/'${detectionclone[i]}'.bg'
        bgimage=${monoback[i]}'/'${measuremtclone[i]}'.bg.s'$namesuff'as'
        bgsimage=${monoback[i]}'/'${measuremtclone[i]}'.bgs.s'$namesuff'as'

# The backgrounds are smoothed to obtain full noise and background fluctuations on a beam scale.

        'CALCULATE' addpx "2*${beam[i]}/$dxas" 20
        'ROUND_FLOAT' 0 $addpx addpx
        'CALCULATE' radmedian "2*${beam[i]}/$dxas" 2
        
        if [[ $istr -eq 1 ]]
        then 
          oimage=${monoback[i]}'/'${measuremtclone[i]}
        fi
        if [[ $istr -eq 2 ]]
        then 
          oimage=${monosback[i]}'/'${measuremtclone[i]}'.bg.s'${srcmaxsize[i]/./p}'as'
        fi
        
        ($path'/expanda' 1 $background ${imageomask[i]} -o $bgimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/operate' $oimage - $bgimage -o $bgsimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/expanda' 1 $bgsimage ${imageomask[i]} -o $bgsimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        
        ($path'/imgstat' median $radmedian $bgimage ${imageomask[i]} -o $bgimage'.n' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        'CONVOLVE_IMAGE' expand border 0 $addpx ${beam[i]} $bgimage'.n' $bgimage'.n' ${imageomask[i]}; chk_rc
        
        ($path'/operate' $oimage - $bgimage'.n' -o $bgsimage'.n' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/expanda' 1 $bgsimage'.n' ${imageomask[i]} -o $bgsimage'.n' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        
# Separated sources.

        if [[ $istr -eq 1 ]]
        then
          \mkdir -p $separated 2>$hell
          sbgimage=${monosback[i]}'/'${measuremtclone[i]}'.bg.s'${srcmaxsize[i]/./p}'as'
          sbgsimage=${monosback[i]}'/'${measuremtclone[i]}'.bgs.s'${srcmaxsize[i]/./p}'as'

          if [[ "$workingpath" != "${dirmono[i]}" ]]
          then 
            \cp -f $sbgimage'.fits'    ${dirmono[i]}'/'${measuremtclone[i]}'.sbackground.fits' #2>$hell
            \cp -f $sbgsimage'.fits'   ${dirmono[i]}'/'${measuremtclone[i]}'.sources.fits' #2>$hell
            \cp -f $sbgsimage'.n.fits' ${dirmono[i]}'/'${measuremtclone[i]}'.sources.n.fits' #2>$hell
          fi
          \cp -f $sbgimage'.fits'    $separated'/'${measuremtclone[i]}'.sbackground'${zsrcmaxsize[i]}'.fits' #2>$hell
          \cp -f $sbgsimage'.fits'   $separated'/'${measuremtclone[i]}'.sources'${zsrcmaxsize[i]}'.fits' #2>$hell
          \cp -f $sbgsimage'.n.fits' $separated'/'${measuremtclone[i]}'.sources.n'${zsrcmaxsize[i]}'.fits' #2>$hell
        
          ($path'/operate' $separated'/'${measuremtclone[i]}'.sbackground'${zsrcmaxsize[i]} + \
                           $separated'/'${measuremtclone[i]}'.sources'${zsrcmaxsize[i]} \
                        -o $separated'/'${measuremtclone[i]}'.sbackground'${zsrcmaxsize[i]}'+sources'${zsrcmaxsize[i]} \
                           $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        fi
        
# Separated filaments.

        if [[ $istr -eq 2 ]]
        then 
          \mkdir -p $separated 2>$hell
          fbgimage=${monofback[i]}'/'${measuremtclone[i]}'.bg.s'${filmaxsize[i]/./p}'as'
          fbgsimage=${monofback[i]}'/'${measuremtclone[i]}'.bgs.s'${filmaxsize[i]/./p}'as'
          \cp -f $fbgsimage'.n.fits' ${measuremtclone[i]}'.filaments.n.fits' #2>$hell

          if [[ "$workingpath" != "${dirmono[i]}" ]]
          then 
            \cp -f $fbgimage'.fits'    ${dirmono[i]}'/'${measuremtclone[i]}'.fbackground.fits' #2>$hell
            \cp -f $fbgsimage'.fits'   ${dirmono[i]}'/'${measuremtclone[i]}'.filaments.fits' #2>$hell
            \cp -f $fbgsimage'.n.fits' ${dirmono[i]}'/'${measuremtclone[i]}'.filaments.n.fits' #2>$hell
          fi
          \cp -f $fbgimage'.fits'    $separated'/'${measuremtclone[i]}'.fbackground'${zfilmaxsize[i]}'.fits' #2>$hell
          \cp -f $fbgsimage'.fits'   $separated'/'${measuremtclone[i]}'.filaments'${zfilmaxsize[i]}'.fits' #2>$hell
          \cp -f $fbgsimage'.n.fits' $separated'/'${measuremtclone[i]}'.filaments.n'${zfilmaxsize[i]}'.fits' #2>$hell
        
          ($path'/operate' $separated'/'${measuremtclone[i]}'.fbackground'${zfilmaxsize[i]} + \
                           $separated'/'${measuremtclone[i]}'.filaments'${zfilmaxsize[i]} \
                        -o $separated'/'${measuremtclone[i]}'.fbackground'${zfilmaxsize[i]}'+filaments'${zfilmaxsize[i]} \
                           $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        
          if [[ -e ${measuremtclone[i]}'.sources.fits' ]]
          then
            ($path'/operate' $separated'/'${measuremtclone[i]}'.filaments'${zfilmaxsize[i]} + \
                             $separated'/'${measuremtclone[i]}'.sources'${zsrcmaxsize[i]} \
                          -o $separated'/'${measuremtclone[i]}'.filaments'${zfilmaxsize[i]}'+sources'${zsrcmaxsize[i]} \
                             $verb; echo $? > '.rc'$cwavenum) | 'tehi'
            ($path'/operate' $separated'/'${measuremtclone[i]}'.fbackground'${zfilmaxsize[i]} + \
                             $separated'/'${measuremtclone[i]}'.sources'${zsrcmaxsize[i]} \
                          -o $separated'/'${measuremtclone[i]}'.fbackground'${zfilmaxsize[i]}'+sources'${zsrcmaxsize[i]} \
                             $verb; echo $? > '.rc'$cwavenum) | 'tehi'
            ($path'/operate' $separated'/'${measuremtclone[i]}'.fbackground'${zfilmaxsize[i]}'+filaments'${zfilmaxsize[i]} + \
                             $separated'/'${measuremtclone[i]}'.sources'${zsrcmaxsize[i]} \
                          -o $separated'/'${measuremtclone[i]}'.fbackground'${zfilmaxsize[i]}'+filaments'${zfilmaxsize[i]}'+sources'${zsrcmaxsize[i]} \
                             $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          fi
        fi
      done
    fi

    if [[ $istr -le 2 ]]
    then continue
    fi

# Create flattening factor images.
# 2020-04-13: Interferometry ALMA image of W43 suggest that the 1-pixel (3x3) window may be too small: the interferometric noise seems to 
# have variable properties (characteristic scales?) and the smallest window does not sample them correctly. This leads to the flattening
# image that does not flatten the field well enough: an eye inspection shows not very good flattening quality across the image. At the 
# same time, the larger windows (5x5, 7x7, 9x9 pixels) sample the noise increasingly better. It seems that a BEAM radius window may be
# applied by default, instead of the 3x3 window used before.
    
    if [[ $istr -eq 3 ]]
    then 
      itdev1=$itstd1
      if [[ $itdev1 -eq 1 ]]
      then printlh; printlh ' '"$title"' srcfactor'; printlh
      else printlh; printlh ' '"$title"' srcfactor (restart iter '$itdev1')'; printlh
      fi
    else
      itdev1=$itftd1
      if [[ $itdev1 -eq 1 ]]
      then printlh; printlh ' '"$title"' filfactor'; printlh
      else printlh; printlh ' '"$title"' filfactor (restart iter '$itdev1')'; printlh
      fi
    fi

    for (( i=$nwc1; i <= $nwaves; i++ ))
    do
      \mkdir -p ${monofact[i]} 2>$hell

      if [[ $istr -eq 3 ]]
      then namesuff=${srcmaxsize[i]/./p}
      else namesuff=${filmaxsize[i]/./p}
      fi
      if [[ $itdev1 -eq 1 ]]
      then
        bgsimagen=${monoback[i]}'/'${measuremtclone[i]}'.bgs.s'$namesuff'as.n'
        stdimage=${monoback[i]}'/'${measuremtclone[i]}'.bgs.s'$namesuff'as.std'
        ($path'/imgstat' stdev ${radstd[i]} 1 $bgsimagen ${imageomask[i]} -o $stdimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/expanda' 1 $stdimage ${imageomask[i]} -o $stdimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        subdirname='…/'`basename "${monoback[i]}"`
        stdname=`basename "$stdimage"`
        printlh ' Copying '$subdirname'/'$stdname'.fits...'
        if [[ ! -e $stdimage'.fits' ]]
        then 'ERROR' 'Image not found: '$stdimage'.fits'
        fi
        \cp -f $stdimage'.fits' ${detectionclone[i]}'.fits' #2>$hell
        \cp -f $stdimage'.fits' ${monofact[i]}'/'${measuremtclone[i]}'.fits' #2>$hell
      else
        itdev1m1=$(( itdev1 - 1 ))
        'LEADZEROS' 1 $itdev1m1 zitdev1m1
        subdirname='…/'`basename "${monofact[i]}"`
        printlh ' Copying '$subdirname'/'${detectionclone[i]}'.bg.'$zitdev1m1'.fits...'
        if [[ ! -e ${monofact[i]}'/'${detectionclone[i]}'.bg.'$zitdev1m1'.fits' ]]
        then 'ERROR' 'Iterated image not found: '${monofact[i]}'/'${detectionclone[i]}'.bg.'$zitdev1m1'.fits'
        fi
        \cp -f ${monofact[i]}'/'${detectionclone[i]}'.bg.'$zitdev1m1'.fits' ${detectionclone[i]}'.fits' #2>$hell
      fi
      ($path'/expanda' 1 ${detectionclone[i]} ${imageomask[i]} -o ${detectionclone[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
    done

    if [[ $skipstd == 'no' ]]
    then
      'SEPARATE_COMPONENTS' 'stdimage'; chk_rc
  
      for (( i=$nwc1; i <= $nwaves; i++ ))
      do    
        \cp -f ${decompose[i]} ${monofact[i]} #2>$hell
        \rm -f ${detectionclone[i]}'.'*'as.fits' 2>$hell
        \rm -f ${detectionclone[i]}'.fits' 2>$hell
      done
    fi
    
    for (( i=$nwc1; i <= $nwaves; i++ ))
    do
      if [[ $istr -eq 3 ]]
      then namesuff=${srcmaxsize[i]/./p}; 'CALCULATE' radmedian "2*${beam[i]}/$dxas" 2
      else namesuff=${filmaxsize[i]/./p}; 'CALCULATE' radmedian "5*${beam[i]}/$dxas" 2
      fi
      image=${measuremtclone[i]}'.bgs.s'$namesuff'as'
      bgsimage=${monoback[i]}'/'$image
      bgsimagen=${monoback[i]}'/'$image'.n'
      bgsiflat=${monoback[i]}'/'$image'.flat'
      bgsiflatn=${monoback[i]}'/'$image'.n.flat'
      stdbgimage=${monofact[i]}'/'${measuremtclone[i]}'.bgs.s'$namesuff'as.std.bg.s'${beam[i]/./p}'as'

# If no flatfactor iterations were requested, make uniform flatfactor images.

      if [[ ($istr -eq 3 && $skipstd == 'no') || ($istr -eq 4 && $skipftd == 'no') ]]
      then
        ($path'/expanda' 1 ${monofact[i]}'/'${detectionclone[i]}'.bg' ${imageomask[i]} \
                      -o $stdbgimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/imgstat' median $radmedian $stdbgimage ${imageomask[i]} -o $stdbgimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      else
        if [[ $istr -eq 3 && $skipstd == 'yes' ]]
        then 
          printlh; printlh ' MAKING A CONSTANT FLATTENING IMAGE AS REQUESTED...'
          ($path'/modfits' multiply 0 ${detectionclone[i]} -o $stdbgimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/modfits' add 1 $stdbgimage -o $stdbgimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        fi
        if [[ $istr -eq 4 && $skipftd == 'yes' ]]
        then 
          printlh; printlh ' MAKING A CONSTANT FLATTENING IMAGE AS REQUESTED...'
          ($path'/modfits' multiply 0 ${detectionclone[i]} -o $stdbgimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/modfits' add 1 $stdbgimage -o $stdbgimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        fi
      fi
      if [[ $istr -eq 3 ]]
      then \cp -f $stdbgimage'.fits' ${sflatfactor[i]}'.fits' #2>$hell
      fi
      if [[ $istr -eq 4 ]]
      then \cp -f $stdbgimage'.fits' ${fflatfactor[i]}'.fits' #2>$hell
      fi

      ($path'/operate' $bgsimage % $stdbgimage -o $bgsiflat $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/operate' $bgsimagen % $stdbgimage -o $bgsiflatn $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/expanda' 1 $bgsiflat ${imageomask[i]} -o $bgsiflat $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/expanda' 1 $bgsiflatn ${imageomask[i]} -o $bgsiflatn $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      
      ($path'/imgstat' stdev ${radstd[i]} 1 $bgsiflat ${imageomask[i]} -o $bgsiflat'.std' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/imgstat' stdev ${radstd[i]} 1 $bgsiflatn ${imageomask[i]} -o $bgsiflatn'.std' $verb; echo $? > '.rc'$cwavenum) | 'tehi'

      if [[ $istr -eq 3 ]]
      then
        \mkdir -p $separated 2>$hell
        \cp -f ${sflatfactor[i]}'.fits' $separated'/'${sflatfactor[i]}''${zsrcmaxsize[i]}'.fits' #2>$hell
        sbgsflat=${monosback[i]}'/'${measuremtclone[i]}'.bgs.s'${srcmaxsize[i]/./p}'as.flat'
    
        if [[ "$workingpath" != "${dirmono[i]}" ]]
        then \cp -f $sbgsflat'.fits' ${dirmono[i]}'/'${detectionclone[i]}'.sources.fits' #2>$hell
        fi
        \cp -f $sbgsflat'.fits' $separated'/'${detectionclone[i]}'.sources'${zsrcmaxsize[i]}'.fits' #2>$hell
      fi

      if [[ $istr -eq 4 ]]
      then 
        \mkdir -p $separated 2>$hell
        \cp -f ${fflatfactor[i]}'.fits' $separated'/'${fflatfactor[i]}''${zfilmaxsize[i]}'.fits' #2>$hell
        fbgsflat=${monofback[i]}'/'${measuremtclone[i]}'.bgs.s'${filmaxsize[i]/./p}'as.flat'

        if [[ "$workingpath" != "${dirmono[i]}" ]]
        then \cp -f $fbgsflat'.fits' ${dirmono[i]}'/'${detectionclone[i]}'.filaments.fits' #2>$hell
        fi
        \cp -f $fbgsflat'.fits' $separated'/'${detectionclone[i]}'.filaments'${zfilmaxsize[i]}'.fits' #2>$hell
      fi
    done
  done
  
  flatten_end=`date +%s`; flatten_time=$(( flatten_end - flatten_beg ))
  'CALCULATE' flatten_minutes "$flatten_time/60" 3
  printlh; printlh ' '$script': '$flatten_minutes' MINUTES'
  fun=$funo
} 
#___________________________________________________________________________________________________________________________________

SEPARATE_COMPONENTS ()
{                          
  local funo=$fun; fun='SEPARATE_COMPONENTS'; funn=$fun; local title=$script': => ('$istep') '\'$fun\'
  local image; local sscimagej; local ssglobalmaximum; local j
  local whatsep="$1"

  if [[ $istep -eq 1 ]]
  then
    if [[ $complete == "no" || ($sources == 'no' && $filaments == 'no') || \
         ($sources == 'no' && $whatsep == 'sources') || ($filaments == 'no' && $whatsep == 'filaments') ]]
    then 
      if [[ $sources == 'yes' && $whatsep == 'sources' || $sources == 'no' && $whatsep == 'filaments' ]]
      then printlh; printlh ' '"$title"' ~> skipping...'
      fi
      fun=$funo; return 0
    else printlh; printlh ' '"$title"' '$whatsep
    fi
  fi
  if [[ $istep -eq 0 ]]
  then
    if [[ $istr -le 2 ]]
    then 
      itclean1=$itbgs1; itcleanmax=$itbgsmax
    else 
      itclean1=$itdev1; itcleanmax=$itbgsmax
      if [[ $istr -eq 3 && $skipstd == 'yes' ]]; then itcleanmax=$itdev1; fi
      if [[ $istr -eq 4 && $skipftd == 'yes' ]]; then itcleanmax=$itdev1; fi
    fi
  else printlh
    itclean1=1; itcleanmax=1
  fi
  itcleanmaxo=$itcleanmax
  'LEADZEROS' 1 $itcleanmax zitcleanmax
  
  for (( i=$nwc1; i <= $nwaves; i++ ))
  do                     
    if [[ $istep -eq 0 ]]
    then 
      decomposeimage[i]=$currentdir'/'${detectionclone[i]}'.fits'
    fi
    if [[ $istep -eq 1 ]]
    then 
      if [[ $whatsep == 'sources' ]]
      then
        subdirname=`basename "${monosback[i]}"`
        sbgsflatnimage=${measuremtclone[i]}'.bgs.s'${srcmaxsize[i]/./p}'as.n.flat'
        decomposeimage[i]=${monosback[i]}'/'$sbgsflatnimage'.fits'
        printlh ' Copying …/'$subdirname'/'$sbgsflatnimage'.fits...'
        if [[ ! -e ${decomposeimage[i]} ]]
        then 'ERROR' 'Detection image not found: …/'$subdirname'/'$sbgsflatnimage'.fits'
        fi
        \cp -f ${decomposeimage[i]} ${detectionclone[i]}'.fits' #2>$hell
      fi
      if [[ $whatsep == 'filaments' ]]
      then
        subdirname=`basename "${monofback[i]}"`
        fbgsflatnimage=${measuremtclone[i]}'.bgs.s'${filmaxsize[i]/./p}'as.n.flat'
        decomposeimage[i]=${monofback[i]}'/'$fbgsflatnimage'.fits'
        printlh ' Copying …/'$subdirname'/'$fbgsflatnimage'.fits...'
        if [[ ! -e ${decomposeimage[i]} ]]
        then 'ERROR' 'Detection image not found: …/'$subdirname'/'$fbgsflatnimage'.fits'
        fi
        \cp -f ${decomposeimage[i]} ${detectionclone[i]}'.fits' #2>$hell
      fi
    fi
  done
  
  for (( i=$nwc1; i <= $nwaves; i++ ))
  do                     
    decl_total=0
    iterationsdone='no'
    itcleanmax=$itcleanmaxo

    if [[ $istep -eq 0 ]]
    then 
      if [[ $istr -le 2 ]]
      then monosep=${monoback[i]}; filesep=${separatebg[i]}
      else monosep=${monofact[i]}; filesep=${separateff[i]}
      fi
    else 
      if [[ $whatsep == 'sources' ]]
      then monosep=${monosrcbg[i]}; filesep=${separateso[i]}
      fi
      if [[ $whatsep == 'filaments' ]]
      then monosep=${monofilbg[i]}; filesep=${separatefi[i]}
      fi
      \mkdir -p $monosep 2>$hell      
    fi

# Background minimum value is required by CONVERGENCE.

    if [[ $istep -eq 0 && $istr -le 2 && ${mfimagemin[i]} == 'undef' ]]
    then 
      origimdir=${imagepath[i]}
      origimagen=${detimage[i]}
      origimage=$origimdir'/'$origimagen
      printlh; printl "%s" 'Applying med filtering to get background minimum...'
      'CALCULATE' radius "4*${beam[i]}/$dxas" 2
      ($path'/imgstat' median $radius $origimage ${imageomask[i]} -o ${detectionclone[i]}'.mf' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/operate' ${detectionclone[i]}'.mf' x ${imageomask[i]} -o ${detectionclone[i]}'.mf' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/imgstat' savein -nomed ${detectionclone[i]}'.mf' ${imageomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
      read -r mfimagemin[i] max mea med totsum sig skew kurt nonzmin edgem < '.+imgstat2'$cwavenum; chk_rc
      printlh ' '${mfimagemin[i]:0:26}
    fi

    for (( itcf=$itclean1; itcf <= $itcleanmax; itcf++ ))
    do
      decompose='yes'

# Trick to make the last iteration repeat the previous one (converged), only with ITCLEANMAX changed to ITCF.
      
      if [[ $iterationsdone == 'yes' ]]
      then decompose='no'; itcleanmax=$itcf
      else
        itcfm1=$(( itcf - 1 )); itcfm2=$(( itcf - 2 ))
        'LEADZEROS' 1 $itcf zitcf; 'LEADZEROS' 1 $itcfm1 zitcfm1; 'LEADZEROS' 1 $itcfm2 zitcfm2
      fi

      if [[ $decompose == 'yes' ]]
      then 
        'DECOMPOSE_IMAGES' $i $whatsep ${detectionclone[i]}; chk_rc
      fi
      cl_beg=`date +%s`; cdate=`date +%d\ %b\ %Y\ %a\ %H:%M:%S\ %Z`
      
      if [[ $itcf -eq 1 && ($istr -le 4 || $istep -eq 1) ]]
      then
        for (( v=1; v <= 4; v++ ))
        do print '#'"${headerinfo[v]:3}" >> $logit
        done
      fi
      print ' ' >> $logit
  
      if [[ $istep -eq 0 ]]
      then 
        if [[ $istr -eq 1 ]]; then print '#' $cdate' • SBACKGROUND ITERATION '$itcf'/'$itcleanmax >> $logit; whatis='sources'; fi
        if [[ $istr -eq 2 ]]; then print '#' $cdate' • FBACKGROUND ITERATION '$itcf'/'$itcleanmax >> $logit; whatis='filaments'; fi
        if [[ $istr -eq 3 ]]; then print '#' $cdate' • SFLATFACTOR ITERATION '$itcf'/'$itcleanmax >> $logit; whatis='srcfactor'; fi
        if [[ $istr -eq 4 ]]; then print '#' $cdate' • FFLATFACTOR ITERATION '$itcf'/'$itcleanmax >> $logit; whatis='filfactor'; fi
      else 
        if [[ $whatsep == 'sources'   ]]; then print '#' $cdate' • DET SOURCES '$itcf'/'$itcleanmax >> $logit; whatis='det sources'; fi
        if [[ $whatsep == 'filaments' ]]; then print '#' $cdate' • DET FILAMENTS '$itcf'/'$itcleanmax >> $logit; whatis='det filaments'; fi
      fi
  
      if [[ $itcf -eq 1 ]]
      then \cp -f ${detectionclone[i]}'.fits' $monosep'/'${detectionclone[i]}'.fits' #2>$hell
      fi
      lastgoodscale[i]='999'; lastbrightscale[i]='999'; foundgoodscales='no'
      thresh='1'; threshold='99999999999999999999999999'; ssglobalmaximum=0
  
      'READ_DECOMPOSE_FILE' ${decompose[i]}
      
      nsbegp1=$(( nsbeg + 1 ))
      sbeam[0]=${sbeam[1]}
      estfilmaxsize[i]=0
      \mkdir -p ${monoworks[i]} 2>$hell
      imagefb[i]=${monoworks[i]}'/'${detectionclone[i]}'.fb'
      imagesa[i]=${monoworks[i]}'/'${detectionclone[i]}'.sa'
      imagefm[i]=${monoworks[i]}'/'${detectionclone[i]}'.fm'
      ($path'/modfits' multiply 0 ${detectionclone[i]} -o ${imagefb[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/modfits' multiply 0 ${detectionclone[i]} -o ${imagesa[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/modfits' multiply 0 ${detectionclone[i]} -o ${imagefm[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  
      nsigmavar=$nsigmacutss
      ssglobalmaximum='0'
      nsbegood=999
      toofewbgpixels=0; toofewbgpixscale=0
  
      print '#'"${headerinfo[1]:3}" > $filesep
      for (( v=2; v <= 4; v++ ))
      do print '#'"${headerinfo[v]:3}" >> $filesep
      done
      print '#' >> $filesep
      print '#' $cdate $whatis 'istep='$istep 'istr='$istr >> $filesep
      print '#' >> $filesep
      print '# Decomposed image: '${decomposeimage[i]} >> $filesep
      print '#' >> $filesep
      print '# List of the single-scale images, onesigma, nsigmavar, thresh, imagemax, and restart data: sfactor = '$sfactor >> $filesep
      print '#' >> $filesep
    
      if [[ $nwaves -eq 1 ]]; then iw=''; else iw=$i; fi
      detsigma[i]=0; threshsum=0; fixedthresh='no'

# Loop over all scales.

      for (( j=$nsbeg; j <= $nsbeams; j++ ))
      do
        'LEADZEROS' 1 $j zj
        jp1=$(( j + 1 ))
        jm1=$(( j - 1 )); if [[ $jm1 -eq 0 ]]; then jm1=1; fi
        jm2=$(( j - 2 )); if [[ $jm2 -le 0 ]]; then jm2=1; fi

        if [[ $verb == "-verb0" ]]
        then 
          outsameline='yes'
          if [[ $istep -eq 0 ]]
          then
            if [[ $istr -eq 1 ]]; then 'PROGRESS_BAR' "DERIVING SBACKGROUND $iw" $j $nsbeg $nsbeams 79 "·"; fi
            if [[ $istr -eq 2 ]]; then 'PROGRESS_BAR' "DERIVING FBACKGROUND $iw" $j $nsbeg $nsbeams 79 "·"; fi
            if [[ $istr -eq 3 ]]; then 'PROGRESS_BAR' "DERIVING SFLATFACTOR $iw" $j $nsbeg $nsbeams 79 "·"; fi
            if [[ $istr -eq 4 ]]; then 'PROGRESS_BAR' "DERIVING FFLATFACTOR $iw" $j $nsbeg $nsbeams 79 "·"; fi
          else 
            if [[ $whatsep == 'sources'   ]]; then 'PROGRESS_BAR' "ITERATING STHRESHOLD $iw" $j $nsbeg $nsbeams 79 "·"; fi
            if [[ $whatsep == 'filaments' ]]; then 'PROGRESS_BAR' "ITERATING FTHRESHOLD $iw" $j $nsbeg $nsbeams 79 "·"; fi
          fi
        fi
        imgmax=${imgmaxxo[j]}; thresh=${threshxo[j]}; onesigma=${onesigxo[j]}
  
        if [[ $itcf -ge 2 ]]   ## || ($istep -eq 0 && $istr -eq 2 && $sources == 'yes')
        then
          if [[ $istr -eq 1 || $istr -eq 3 ]]
          then justname=`basename "$filesep"`'.src'
          fi
          if [[ $istr -eq 2 || $istr -eq 4 ]]
          then justname=`basename "$filesep"`'.fil'
          fi
##          justname=`basename "$filesep"`

          'READ_RESTART_DATA' ${monobkups[i]}'/'$justname

          if [[ $filename == '' || $nsca -ne $j ]]
          then 'ERROR' 'Trouble finding thresholds from the separation step...'
          fi
        fi
  
        if [[ ${enforcedthresh[i]} == '(+)' ]]
        then
          'READ_RESTART_DATA' ${dirmono[i]}'/'${detectionclone[i]}'.thresholds.(+)'

          if [[ $filename == '' || $nsca -ne $j ]]
          then 'ERROR' 'Trouble finding enforced thresholds...'
          fi
        fi
  
        'CALCULATE' beamsratio1 "1.0001*${sbeam[1]}/${beam[i]}" 20
        'CALCULATE' beamsratioj "1.0001*${sbeam[j]}/${beam[i]}" 20
        beamsratok=$fsbelowbeam
        'COMPARE_FLOATS' $beamsratio1 '>' $beamsratok rsltbratok1
        if [[ $rsltbratok1 -eq 1 ]]
        then beamsratok=$beamsratio1
        fi
        'COMPARE_FLOATS' $beamsratioj '>' $beamsratok rsltbratokj

        'CLEANING_MINPIX' ${beam[i]} $j

# Define file names of single-scale images.

        sscimagej=${detectionclone[i]}'.'${nscbeam[j]}
        sscimagejm1=${detectionclone[i]}'.'${nscbeam[jm1]}
        sscimagejfm=${monoworks[i]}'/'$sscimagej'.fm'
        sscimagejfp=${monoworks[i]}'/'$sscimagej'.fp'
        sscimagejfb=${monoworks[i]}'/'$sscimagej'.fb'
        sscimagejsa=${monoworks[i]}'/'$sscimagej'.sa'
        if [[ $extractiondir != ${dirmono[i]} ]]
        then \cp -f ${dirmono[i]}'/'$sscimagej'.fits' '.' #2>$hell
        fi
      
# When restarting from an intermediate scale, skip the scales that are not to be re-cleaned.    

        if [[ $j -ge $nsbeg ]]
        then
          ($path'/imgstat' savein -nomed $sscimagej ${imageomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
          read -r min imgmax mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
          'CHECK_IMGSTAT' $min $imgmax $sig $script $fun $funo '10'
      
          if [[ ${enforcedthresh[i]} == '' && $toofewbgpixels -eq 0 ]]
          then
            iter_time=0

            if [[ $itcf -eq 1 && ${lastbrightscale[i]} -eq 999 ]]  ## && ($istep -eq 1 || $istr -le 2 || $sources == 'no')
            then
              if [[ $nsbegood -eq 999 ]]
              then nsbegood=$j
              fi
              'COMPARE_FLOATS' $imgmax '>' $ssglobalmaximum rslt
              if [[ $rslt -eq 1 && $j -gt $nsbegood ]]
              then ssglobalmaximum=$imgmax
              fi
              
              iter_beg=`date +%s`
              'ITERATE_THRESHOLDS' $i $j $sscimagej $nsigmavar ${imageomask[i]}; rciterate=$?
              iter_end=`date +%s`; iter_time=$(( iter_end - iter_beg ))
              
              if [[ $allbgpixelszero -eq 0 ]]
              then 
                \rm -f $sscimagej'.msk.fits' 2>$hell
                \rm -f $sscimagej'.msks.fits' 2>$hell
              fi
              thresh=$sigmas
              
# If the iterated threshold experiences jumps with respect to the previous one, then keep it unchanged forever.

              if [[ $fixedthresh == 'no' ]]
              then
                'CALCULATE' threshratio "$thresh/$threshold" 20
                'COMPARE_FLOATS' $threshratio '>' '1.3' jumped
                if [[ $jumped -eq 1 ]]
                then fixedthresh='yes'
                fi
              fi
              if [[ $fixedthresh == 'yes' ]]
              then thresh=$threshold
              fi
            else
              if [[ ${lastbrightscale[i]} -lt 999 ]]
              then thresh=$threshold
              fi
            fi
          fi
          if [[ $toofewbgpixels -gt 0 ]]
          then thresh=$threshold
          fi
          if [[ $thresh == '' ]]
          then 'ERROR' 'Abnormal condition: cut-off is empty: thresh = '\'$thresh\''.' \
                       'If this happens after a restart from an intermediate scale, you probably have ' \
                       'to restart with one of the previous scales; look in +log.'$script'.iter to find the scale.'
          fi
          'CALCULATE' onesigma "$thresh/$nsigmavar" 20

# Process decomposed images.

          if [[ $rsltbratokj -eq 1 ]]
          then
            ($path'/imgstat' savein -nomed $sscimagej ${imageomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
            read -r min max mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
            'CHECK_IMGSTAT' $min $max '' $script $fun $funo '15'
            'CALCULATE' maxallowed "$max/1.000001" 20

# Check if the iterated threshold happened to be higher than the maximum allowed threshold.

            'COMPARE_FLOATS' $thresh '>=' $maxallowed rcthreshmax
            if [[ $rcthreshmax -eq 0 && $j -ge $nsbegood ]]
            then foundgoodscales='yes'
            fi

# Do the processing only if the threshold is lower than the maximum value in the image, i.e. if the mask image is not empty.

            if [[ $j -gt ${lastgoodscale[i]} || $j -gt ${lastbrightscale[i]} ]]
            then
              if [[ $foundgoodscales == 'yes' ]]; then print >> $logit; fi
              print ' scale:' $j ' cut-off:' ${thresh:0:26} ' bratio:' ${beamsratioj:0:6} \
                    ' ssglobalmax:' ${ssglobalmaximum:0:9} ' imgmax:' ${imgmax:0:9} >> $logit
            fi
          fi

# It is necessary to limit filament clipping by small scales: SBEAM < MAXCLIPSCALE. 
# SFACTOR is present here to make sure that the last scale is included.
          
          if [[ $istep -eq 0 ]]
          then
            clip_beg=`date +%s`
            if [[ $istr -eq 1 ]]; then 'CALCULATE' maxclipscale "$xscalestruc*${srcmaxsize[i]}*$sfactor" 20; fi
            if [[ $istr -eq 2 ]]; then 'CALCULATE' maxclipscale "$xscalestruc*${filmaxsize[i]}*$sfactor" 20; fi
            if [[ $istr -eq 3 ]]; then 'CALCULATE' maxclipscale "$xscaleffact*${srcmaxsize[i]}*$sfactor" 20; fi
            if [[ $istr -eq 4 ]]; then 'CALCULATE' maxclipscale "$xscaleffact*${filmaxsize[i]}*$sfactor" 20; fi
            'COMPARE_FLOATS' ${sbeam[j]} '<=' $maxclipscale clipscaleok
            
            if [[ $clipscaleok -eq 1 ]]
            then 
              if [[ $istr -eq 1 || $istr -eq 3 || $istr -eq 4 ]]
              then 
                'CALCULATE' xsigmas "$fdepths*$onesigma" 20
                ($path'/modfits' clip4s ${cleanminpix[j]} $xsigmas $sscimagej -o $sscimagejfb $verb; echo $? > '.rc'$cwavenum) | 'tehi'
              else 
                \cp -f $sscimagej'.fits' $sscimagejfb'.fits' #2>$hell
              fi
              if [[ $istr -eq 2 || $istr -eq 3 || $istr -eq 4 ]]
              then 
                'CALCULATE' xsigmaf "$fdepthf*$onesigma" 20
                ($path'/modfits' clip4f 1 $xsigmaf $sscimagejfb -o $sscimagejfb $verb; echo $? > '.rc'$cwavenum) | 'tehi'
              fi
            else
              \cp -f $sscimagej'.fits' $sscimagejfb'.fits' #2>$hell
            fi
            
            clip_end=`date +%s`; clip_time=$(( clip_end - clip_beg ))
            if [[ $itcf -eq 1 ]]
            then print >> $logit
              print ' Threshold iteration: '$iter_time' sec; source clipping: '$clip_time' sec' >> $logit
            fi
          else
            if [[ $itcf -eq 1 ]]
            then print >> $logit
              print ' Threshold iteration: '$iter_time' sec' >> $logit
            fi
          fi

          if [[ $foundgoodscales == 'yes' && ${lastgoodscale[i]} -lt 999 && ${lastbrightscale[i]} -eq 999 ]]
          then
            if [[ $foundgoodscales == 'yes' && ${lastgoodscale[i]} -lt 999 ]]
            then lastbrightscale[i]=${lastgoodscale[i]}
            else lastbrightscale[i]=$j
            fi
            print >> $logit
            print ' INFO: THE LAST BRIGHT SCALE FOUND at scale '${lastbrightscale[i]}':' \
                  $imgmax ${lastgoodscale[i]} $foundgoodscales >> $logit
          fi
          print \'${dirmono[i]/$currentroot/..}'/'$sscimagej'.fits'\' ${onesigma:0:26} $nsigmavar ${thresh:0:26} ${imgmax:0:26} \
                \''restart-data:'\' ${lastgoodscale[i]} ${lastbrightscale[i]} $foundgoodscales ${threshold:0:26} ${ssglobalmaximum:0:26} \
                $nsbegood $toofewbgpixels >> $filesep
  
          threshold=$thresh
        fi

        if [[ $itcf -eq 1 ]]
        then print >> $logit
          print ' scale:' $j ' cut-off:' ${thresh:0:26} ' lastgood:' ${lastgoodscale[i]:0:6} \
                ' lastbright:' ${lastbrightscale[i]:0:6} ' ssglobalmax:' ${ssglobalmaximum:0:26} ' imgmax:' ${imgmax:0:26} >> $logit
          print '             bratio:' ${beamsratioj:0:6} ' ssrzero:' ${ssrzero[j]:0:6} ' clipfil:' ${cleanminpix[j]} >> $logit
        fi
        
# Derive single-scale images of sources by subtracting background.
# Get just a positive part of the structures.
  
        if [[ $istep -eq 0 ]]
        then
          ($path'/modfits' minimum 0 y $sscimagejfb -o $sscimagejfp $verb; echo $? > '.rc'$cwavenum) | 'tehi'

# Get a positive clipped peak including the full negative part of the single scale
# by subtracting just the positive layer of the structures.
  
          ($path'/operate' $sscimagej - $sscimagejfp -o $sscimagejsa $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  
          ($path'/operate' ${imagesa[i]} + $sscimagejsa -o ${imagesa[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/operate' ${imagefb[i]} + $sscimagejfb -o ${imagefb[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  
# To fix deep canyons in flattening factor (stdev) images, compute masks of filaments and sources.

          if [[ $itcf -eq 1 ]]
          then
            'CALCULATE' threshf "$fdepthf*$onesigma" 20
            'CREATE_MASKS' $threshf $sscimagej $sscimagejfm; chk_rc
            ($path'/operate' ${imagefm[i]} + $sscimagejfm -o ${imagefm[i]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          
            ($path'/imgstat' savein -nomed $sscimagejfm ${imageomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
            read -r min max mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
            'CHECK_IMGSTAT' $min $max '' $script $fun $funo '16'
            'COMPARE_FLOATS' $max '>' '0.0' rcpositivesfound
            if [[ $rcpositivesfound -eq 1 ]]
            then 
              estfilmaxsize[i]=${sbeam[j]}
              if [[ ${estfilmaxsize[i]:0:1} == '.' ]]
              then estfilmaxsize[i]='0'${estfilmaxsize[i]}
              fi
              'ROUND_FLOAT' 1 ${estfilmaxsize[i]} estfilmaxsize[i]
            fi
            \rm -f $sscimagejfm'.fits' 2>$hell
          fi
        fi
  
        if [[ $extractiondir != ${dirmono[i]} ]]
        then
##          \mv -f $sscimagej'.'[anr][ne]'.fits' ${dirmono[i]} #2>$hell
          \cp -f $logit ${dirmono[i]} #2>$hell
        fi
        'CALCULATE' detsigma[i] "${detsigma[i]}+$onesigma^2" 20

      done  #<~ scales loop

      'CALCULATE' detsigma[i] "sqrt(${detsigma[i]})" 20

      print >> $logit
      print ' Standard deviation computed from all scales: '${detsigma[i]} >> $logit
      print ${detsigma[i]} > $monosep'/'${detectionclone[i]}'.sigma'
  
      if [[ $itcf -eq 1 ]]
      then
        \mkdir -p ${monobkups[i]} 2>$hell
        backtimestamp=`date +%y%m%d.%H%M%S`
      
        if [[ $istr -eq 1 || $istr -eq 3 ]]
        then justname=`basename "$filesep"`'.src'
        fi
        if [[ $istr -eq 2 || $istr -eq 4 ]]
        then justname=`basename "$filesep"`'.fil'
        fi
        existingfile=${monobkups[i]}'/'$justname
        if [[ -e $existingfile && "$justname" != '' ]]
        then \cp -f $existingfile $existingfile'.'$backtimestamp #2>$hell
        fi
        \cp -f $filesep ${monobkups[i]}'/'$justname #2>$hell
      
        if [[ $istep -eq 0 && $istr -eq 2 ]]
        then
          if [[ ${estfilmaxsize[i]:0:1} == "." ]]
          then estfilmaxsize[i]='0'${estfilmaxsize[i]}
          fi
          print ${estfilmaxsize[i]} > $monosep'/'${detectionclone[i]}'.filmaxsize'
          \cp -f ${imagefm[i]}'.fits' $monosep'/'${detectionclone[i]}'.fm.'$zitcf'.fits' #2>$hell
        fi
      fi
      
      if [[ $istep -eq 0 ]]
      then
        detfilamentz=$monosep'/'${detectionclone[i]}'.bg'
        detsourcesso=$monosep'/'${detectionclone[i]}'.co'
        detfilaments=$monosep'/'${detectionclone[i]}'.b'
        
        'PARTIAL_IMAGES'
      
# Determine the filaments image for current iteration by subtracting remaining peaks from iterated background.

        ($path'/operate' ${detectionclone[i]} - $detsourcesso -o $detfilamentz $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/operate' ${imageomask[i]} x $detfilamentz -o $detfilamentz $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/operate' $monosep'/'${measuremtclone[i]} - $detfilamentz -o $detsourcesso $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/operate' ${imageomask[i]} x $detsourcesso -o $detsourcesso $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        
        \cp -f $detfilamentz'.fits' $monosep'/'${detectionclone[i]}'.bg.'$zitcf'.fits' #2>$hell
        \cp -f $detsourcesso'.fits' $monosep'/'${detectionclone[i]}'.co.'$zitcf'.fits' #2>$hell
        
        iterationsdoneo=$iterationsdone
        if [[ $iterationsdone == 'no' ]]
        then 'CONVERGENCE' $i $monosep; chk_rc
        fi

# ATTENTION! Replacing the original detection image with the current iterated filaments.

        if [[ $iterationsdone == 'no' || $itcf -eq $itcleanmax ]]
        then
          \cp -f $detfilamentz'.fits' ${detectionclone[i]}'.fits' #2>$hell
          if [[ "$workingpath" != "${dirmono[i]}" ]]
          then \cp -f ${detectionclone[i]}'.fits' ${dirmono[i]} #2>$hell
          fi
        fi
      fi
  
      if [[ $verb == "-verb0" ]]
      then 'PROGRESS_BAR' 'complete' $nsbeams $nsbeg $nsbeams 79 "·"; outsameline='no'
      fi
      cl_end=`date +%s`; cl_time=$(( cl_end - cl_beg ))
      
      if [[ $istep -eq 0 ]]
      then 
        decl_time=$(( de_time + cl_time ))
        decl_total=$(( decl_total + decl_time ))
        'CALCULATE' decl_min "$decl_time/60" 3
        'CALCULATE' declt_min "$decl_total/60" 3
        'CALCULATE' maxpercent "$maxcorr*100" 2
        printlh
        if [[ $iterationsdone == 'no' || $iterationsdoneo == 'no' ]]
        then 
          printlh ' '$script': '$decl_min' MINUTES ('${wave[i]}' µm '$whatis' '$zitcf'/'$zitcleanmax' done: maxrd = '$imgmaxdif')'
          itcfdone=$itcf
        else 
          printlh ' '$script': '$declt_min' MINUTES ('${wave[i]}' µm '$whatis' done: ∆p/p≈'${maxpercent:0:3}'% in '$itcfdone' iterations)'
        fi
      fi
      if [[ $itcfm2 -gt 1 ]]
      then 
        \rm -f $monosep'/'${detectionclone[i]}'.bg.'$zitcfm2'.fits' 2>$hell
        \rm -f $monosep'/'${detectionclone[i]}'.co.'$zitcfm2'.fits' 2>$hell
      fi

    done  #<~ iterations loop

    if [[ $savespace -ge 1 ]]
    then 
      \rm -f $prefix'.'${wave[i]}'.det.'??'.c'??????'as.fits' 2>$hell
      \rm -f ${dirmono[i]}'/'*'.c'??????'as.fits' 2>$hell
      \rm -R ${monoworks[i]} 2>$hell
      \rm -f ${detectionclone[i]}'.mf.fits' 2>$hell
    fi

# Remove the following directories (*only if* they are empty).
    
    \rmdir $monosep 2>$hell
  done
  
  fun=$funo
} 
#___________________________________________________________________________________________________________________________________

COMBINE_WAVEBANDS ()
{                          
  local funo=$fun; fun='COMBINE_WAVEBANDS'; local title=$script': => ('$istep') '\'$fun\'
  local image; local sscimagej; local fact; local i; local j; local iw; local nwavesforcombo
  local whatcom="$1"

  if [[ $combine == "no" || ($sources == 'no' && $filaments == 'no') || \
       ($sources == 'no' && $whatcom == 'sources') || ($filaments == 'no' && $whatcom == 'filaments') ]]
  then 
    if [[ $sources == 'yes' && $whatcom == 'sources' || $sources == 'no' && $whatcom == 'filaments' ]]
    then printlh; printlh ' '"$title"' ~~~> skipping...'
    fi
    fun=$funo; return 0
  else printlh; printlh ' '"$title"' '$whatcom
  fi
  combine_beg=`date +%s`; cdate=`date +%d\ %b\ %Y\ %a\ %H:%M:%S\ %Z`

  if [[ $whatcom == 'sources' ]]
  then 
    swfwdet=$dotsw'.det.'
    \rm -f $prefix$dotsw'.det.'??'.c'??????'as.'*'.fits' 2>$hell
    filecombining=$fileswcombining
##    'CALCULATE' scalemaxsize "2*$srcmaxsizemax" 20
    beammaxcombo=$beammaxcombosrc
    beammincombo=$beammincombosrc
    beamavcombo=$beamavcombosrc
    nsigmacom=$nsigmacombos
  fi
  if [[ $whatcom == 'filaments' ]]
  then
    swfwdet=$dotfw'.det.'
    \rm -f $prefix$dotfw'.det.'??'.c'??????'as.'*'.fits' 2>$hell
    filecombining=$filefwcombining
##    'CALCULATE' scalemaxsize "1.5*$filmaxsizemax" 20
    beammaxcombo=$beammaxcombofil
    beammincombo=$beammincombofil    
    beamavcombo=$beamavcombofil
    nsigmacom=$nsigmacombof
  fi
  filecombo=$prefix$swfwdet'combined'
  if [[ $whatcom == 'sources' ]]
  then 
    maskscaleswavesfinalsumx=$maskscaleswavesfinalsum'.hi'
    ($path'/modfits' multiply 0 ${detectionclone[1]} -o $maskscaleswavesfinalsumx $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  fi

  nwavesforcombo=0
  
  for (( j=1; j <= 99; j++ ))
  do wavescombined[j]=''; newthreshsum[j]='0'
  done
##  printlh
  for (( i=1; i <= $nwaves; i++ ))
  do
    if [[ $whatcom == 'sources'   ]]; then justname=`basename "${separateso[i]}"`; usefordetection[i]=${usefordetsrc[i]}; fi
    if [[ $whatcom == 'filaments' ]]; then justname=`basename "${separatefi[i]}"`; usefordetection[i]=${usefordetfil[i]}; fi
##    if [[ ${usefordetection[i]} == "yes" ]]
##    then printlh ' Processing …/'${separated/$currentroot\//}'/'${detectionclone[i]}'.'$whatcom'.fits...'
##    fi
    filesep[i]=${dirmono[i]}'/'$justname
  done
    
  for (( i=1; i <= $nwaves; i++ ))
  do
    if [[ ${usefordetection[i]} == "yes" ]]
    then 
      nsbeamsd=$nsbeams

      'READ_SEPARATION_FILE' ${filesep[i]}
      'READ_DECOMPOSE_FILE' ${decompose[i]}
    
      if [[ $istepo -ne $istep || $whato != $whatcom || $nsbeams -lt $nsbeamsd || $filesexist == 'no' ]]
      then
        nsbeams=$nsbeamsd
        if [[ $whatcom == 'sources' ]]
        then processimage=$separated'/'${detectionclone[i]}'.'$whatcom''${zsrcmaxsize[i]}'.fits'
        fi
        if [[ $whatcom == 'filaments' ]]
        then processimage=$separated'/'${detectionclone[i]}'.'$whatcom''${zfilmaxsize[i]}'.fits'
        fi
        \cp -f $processimage ${detectionclone[i]}'.fits' #2>$hell

        'DECOMPOSE_IMAGES' $i $whatcom ${detectionclone[i]}; chk_rc
      fi
  
      if [[ $nwaves -gt 1 ]]
      then comboexponent[i]=$comboexpo
      else comboexponent[i]='0.0'   
      fi 
      nwavesforcombo=$(( nwavesforcombo + 1 ))
    fi
  done

  if [[ $nwavesforcombo -eq 0 ]]
  then 'ERROR' 'None of the wavelengths selected in the config for combining '$whatcom'...'
  fi

  for (( j=1; j <= 99; j++ ))
  do                        
    if [[ ${nscbeam[j]} != '' ]]
    then
      sscimagecoman[j]=$prefix$swfwdet${nscbeam[j]}'.an'
      ($path'/modfits' multiply 0 ${detectionclone[1]} -o ${sscimagecoman[j]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'

      if [[ $whatcom == 'sources' ]]
      then 
        sscimagecomas[j]=$prefix$swfwdet${nscbeam[j]}'.as'
        ($path'/modfits' multiply 0 ${detectionclone[1]} -o ${sscimagecomas[j]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      fi
    fi
  done

# Combine single scales over all wavelengths.
  
  for (( i=1; i <= $nwaves; i++ ))
  do
    if [[ $nwaves -eq 1 ]]; then iw=''; else iw=$i; fi
    im1=$(( i - 1 ))     
         
    if [[ ${usefordetection[i]} == "yes" ]]
    then
      print >> $logit
      image=${detectionclone[i]}

      'READ_SEPARATION_FILE' ${filesep[i]}

      if [[ $whatcom == 'sources' ]]
      then 
        maskscalesfinalsumx=${maskscalesfinalsum[i]}'.hi'
        ($path'/modfits' multiply 0 ${detectionclone[i]} -o $maskscalesfinalsumx $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      fi
      nsbgoodcom[i]=0

      sscimage1=${dirmono[i]}'/'${detectionclone[i]}'.'${nscbeam[1]}
      ($path'/imgstat' savein -nomed $sscimage1 ${imageomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
      read -r min ssimagemax[1] mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
      'CHECK_IMGSTAT' $min ${ssimagemax[1]} $sig $script $fun $funo '10'

# Co-add images for each scale over waves.

      for (( j=$nsbeg; j <= $nsbeams; j++ ))
      do
        if [[ $verb == "-verb0" ]]
        then 
          outsameline='yes'
          if [[ $whatcom == 'sources'   ]]; then 'PROGRESS_BAR' "COMBINING SRCIMAGE $iw" $j $nsbeg $nsbeams 79 "·"; fi
          if [[ $whatcom == 'filaments' ]]; then 'PROGRESS_BAR' "COMBINING FILIMAGE $iw" $j $nsbeg $nsbeams 79 "·"; fi
        fi 
        'CALCULATE' threshcom "$nsigmacom*${onesigma[j]}" 20
        nsigma=$nsigmacom
    
        sscimagej=${dirmono[i]}'/'${detectionclone[i]}'.'${nscbeam[j]}
        locsscimagejan=${detectionclone[i]}'.'${nscbeam[j]}'.an'

        'CALCULATE' beamsratio1 "1.0001*${sbeam[1]}/${beam[i]}" 20
        'CALCULATE' beamsratioj "1.0001*${sbeam[j]}/${beam[i]}" 20
        beamsratok=$fsbelowbeam
        if [[ ${beamsratok:0:1} == "." ]]
        then beamsratok='0'$beamsratok
        fi
        'COMPARE_FLOATS' $beamsratio1 '>' $beamsratok rsltbratok1
        if [[ $rsltbratok1 -eq 1 ]]
        then beamsratok=$beamsratio1
        fi
        'COMPARE_FLOATS' $beamsratioj '>' $beamsratok rsltbratokj

# Do the scale if there is no gap, i.e. 'an' ("above-noise") image exists.
      
        if [[ $rsltbratokj -eq 1 ]]
        then
          if [[ ${nsbgoodcom[i]} -eq 0 ]]
          then nsbgoodcom[i]=$j
          fi
          wavescombined[j]=${wavescombined[j]}' '${wave[i]}
          
          ($path'/imgstat' savein -nomed $sscimagej ${imageomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
          read -r min ssimagemax[j] mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
          'CHECK_IMGSTAT' $min ${ssimagemax[j]} $sig $script $fun $funo '10'
          
          \cp -f $sscimagej'.fits' $locsscimagejan'.m.fits' #2>$hell

          ($path'/modfits' minimum $threshcom y $locsscimagejan'.m' -o $locsscimagejan'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          
# Additionally remove residual filament-like shapes from sources and source-like shapes from filaments.

          'CALCULATE' threshc "0.99*$threshcom" 20
##          if [[ $whatcom == 'sources' ]]
##          then ($path'/modfits' clip4f 1 $threshc $locsscimagejan'.m' -o $locsscimagejan'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
##          fi

          if [[ $whatcom == 'filaments' ]]
          then 
            'CLEANING_MINPIX' ${beam[i]} $j
            ($path'/modfits' clip4x ${cleanminpix[j]} $threshc $locsscimagejan'.m' \
                             -o $locsscimagejan'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          fi

          if [[ $whatcom == 'sources' ]]
          then 
            'CREATE_MASKS' $threshcom $locsscimagejan'.m' $locsscimagejan'.msk'; chk_rc

            ($path'/operate' $srccoaddedomask x $locsscimagejan'.msk' -o $locsscimagejan'.msk' $verb; echo $? > '.rc'$cwavenum) | 'tehi'

# Sum up the sources in a mask image, only in a limited range of scales!
   
            ($path'/operate' $maskscalesfinalsumx + $locsscimagejan'.msk' -o $maskscalesfinalsumx $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          fi

          ($path'/operate' ${imageomask[i]} x $locsscimagejan'.m' -o $locsscimagejan'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        
# Combining omask can be used to exclude some images or their areas from combining.

          ($path'/operate' ${combiningomask[i]} x $locsscimagejan'.m' -o $locsscimagejan'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
       
          if [[ $whatcom == 'sources' ]]
          then \cp -f $locsscimagejan'.m.fits' $locsscimagejan'.s.fits' #2>$hell
          fi

          ($path'/modfits' minimum $threshcom n $locsscimagejan'.m' -o $locsscimagejan'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'

# It is important to have the new maximum slightly below 1.0 to avoid problems in detecting sources using the TintFill algorithm.
# This avoids any possibility of a pixel value becoming equal to the source number and cures problems.
                                   
          newimagemax='0.99' #<-- IMPORTANT!!!
          newthreshone='1.0'
          'CALCULATE' newthreshsum[j] "${newthreshsum[j]}+$newthreshone" 20

          'CALCULATE' turnonfact "(${sbeam[j]}/${beam[i]})^3" 20
          'COMPARE_FLOATS' $turnonfact '>' '1.0' rsltgt1
          if [[ $rsltgt1 -eq 1 ]]
          then turnonfact='1.0'
          fi

# This factnormthresh normalizes images such that the thresholds are 1.0 on each scale and wavelength.

          'CALCULATE' factnormthresh "$turnonfact*($newthreshone/$threshcom)" 25
          
          ($path'/modfits' multiply $factnormthresh $locsscimagejan'.m' -o $locsscimagejan'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'

          if [[ $whatcom == 'sources' ]]
          then 
            if [[ $j -eq ${nsbgoodcom[i]} ]]
            then 
              'COMPARE_FLOATS' ${ssimagemax[1]} '>' '0.0' rslt
              if [[ $rslt -eq 1 ]]
              then denominator=${ssimagemax[1]}
              else 'ERROR' 'Denominator <= 0.0:' ${ssimagemax[1]}
              fi
            fi
            if [[ $nwaves -gt 1 ]]
            then 'CALCULATE' comboweight[i] "e(l($beamavcombo/${beam[i]})*${comboexponent[i]})" 20
            else comboweight[i]='1.0'
            fi 
            'CALCULATE' factnormcombo "($newimagemax/$denominator)*${comboweight[i]}" 25
            'CALCULATE' newssimagemax "$factnormcombo*${ssimagemax[j]}" 20

            ($path'/modfits' multiply $factnormcombo $locsscimagejan'.s' -o $locsscimagejan'.s' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          else
            factnormcombo='0'
            newssimagemax='0'
          fi
          
          print \'$sscimagej\'': ssmax: '${ssimagemax[j]:0:11} 'newssmax: '${newssimagemax:0:11} 'threshcom: '${threshcom:0:11} \
                              'newthresh: '${newthreshone:0:11} 'comboexp: '${comboexponent[i]:0:6} 'turnonfact: '$turnonfact >> $logit

          print \'$sscimagej\'': factnormcombo: '${factnormcombo:0:11} 'factnormthresh: '${factnormthresh:0:11} \
                              'comboweight: '${comboweight[i]:0:11} >> $logit
          
# Add the current contribution to the sum over all waves.

          if [[ $whatcom == 'sources' ]]
          then 
            ($path'/operate' $locsscimagejan'.s' + ${sscimagecomas[j]} -o ${sscimagecomas[j]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          fi
          ($path'/operate' $locsscimagejan'.m' + ${sscimagecoman[j]} -o ${sscimagecoman[j]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'

          if [[ $savespace -ge 1 ]]
          then
            \rm -f $locsscimagejan'.m.fits' 2>$hell
            \rm -f $locsscimagejan'.msk.fits' 2>$hell
          fi
          jlastexist=$j
        fi

# Avoid abrupt changes in the ".as" combined images when a poorer-resolution image switches on and starts adding 
# single scales to the combined images. Now all poorer-resolution images will have non-zero small-scale images that
# are just copies of their first good single-scale image. This eliminates jumps in the ".as" images used to determine
# the characteristic scales and detection footprints.

        if [[ $whatcom == 'sources' ]]
        then 
          if [[ $j -eq ${nsbgoodcom[i]} && $nsbeg -lt ${nsbgoodcom[i]} ]]
          then 
            jm1=$(( j - 1 ))
            for (( jj=$jm1; jj >= $nsbeg; jj-- ))
            do 
              ($path'/operate' $locsscimagejan'.s' + ${sscimagecomas[jj]} -o ${sscimagecomas[jj]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
            done
          fi
          if [[ $savespace -ge 1 ]]
          then \rm -f $locsscimagejan'.s.fits' 2>$hell
          fi
        fi
      done
    
      if [[ $verb == "-verb0" ]]
      then 'PROGRESS_BAR' 'complete' $nsbeams $nsbeg $nsbeams 79 "·"; outsameline='no'
      fi
      if [[ $whatcom == 'sources' ]]
      then 
        ($path'/operate' $maskscaleswavesfinalsumx + $maskscalesfinalsumx \
                      -o $maskscaleswavesfinalsumx $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      fi
    fi
  done

  if [[ -e $filecombining ]]
  then 
    backtimestamp=`date +%y%m%d.%H%M%S`
    for (( i=1; i <= $nwaves; i++ ))
    do
      \mkdir -p ${monobkups[i]} 2>$hell
      if [[ -e ${monobkups[i]}'/'$filecombining ]]
      then \mv -f ${monobkups[i]}'/'$filecombining ${monobkups[i]}'/'$filecombining'.'$backtimestamp #2>$hell
      fi
      \cp -f $filecombining ${monobkups[i]} #2>$hell
    done
  fi
  
  print '#'"${headerinfo[1]:3}" > $filecombining
  for (( v=2; v <= 4; v++ ))
  do print '#'"${headerinfo[v]:3}" >> $filecombining
  done
  print '#' >> $filecombining
  print '#' $cdate >> $filecombining
  print '#' >> $filecombining
  print '# List of the combined clean detection images, onesigma, etc.: sfactor = '$sfactor >> $filecombining
  print '#' >> $filecombining

# Normalize each and every single-scale detection image to NEWIMAGEMAX (=0.99).

  nsbegood=0
  
  for (( j=$nsbeg; j <= $nsbeams; j++ ))
  do                        
    if [[ $verb == "-verb0" ]]
    then 
      'PROGRESS_BAR' "COMPLETING COMBINATION" $j $nsbeg $nsbeams 79 "·"
    fi
    if [[ -e ${sscimagecoman[j]}'.fits' ]]
    then
      'CALCULATE' threshsum "1.00001*${newthreshsum[j]}" 20
      ($path'/modfits' minimum $threshsum y ${sscimagecoman[j]} -o ${sscimagecoman[j]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'

      ($path'/imgstat' savein -nomed ${sscimagecoman[j]} ${sscimagecoman[j]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
      read -r mino maxo mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
      \rm -f '.+imgstat2'$cwavenum 2>$hell

      'COMPARE_FLOATS' $maxo '=' '0.0' rslt0
      if [[ $rslt0 -eq 0 ]]
      then
        'CALCULATE' factnorm1 "$newimagemax/$maxo" 20
        ($path'/modfits' multiply $factnorm1 ${sscimagecoman[j]} -o ${sscimagecoman[j]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      else
        factnorm1='0.0'
      fi
      'CALCULATE' onesigma "$factnorm1*$threshsum/$nsigmacom" 20

      print \'$extractiondir'/'${sscimagecoman[j]}'.fits'\' $onesigma $factnorm1 ${wavescombined[j]} >> $filecombining      
      if [[ $rslt0 -eq 0 && $nsbegood -eq 0 ]]
      then nsbegood=$j
      fi
    fi
  done

  if [[ $verb == "-verb0" ]]
  then 
    'PROGRESS_BAR' 'complete' $nsbeams $nsbeg $nsbeams 79 "·"; outsameline='no'
  fi

  if [[ -e $filecombo ]]
  then 
    backtimestamp=`date +%y%m%d.%H%M%S`
    for (( i=1; i <= $nwaves; i++ ))
    do
      \mkdir -p ${monobkups[i]} 2>$hell
      if [[ -e ${monobkups[i]}'/'$filecombo ]]
      then \mv -f ${monobkups[i]}'/'$filecombo ${monobkups[i]}'/'$filecombo'.'$backtimestamp #2>$hell
      fi
      \cp -f $filecombo ${monobkups[i]} #2>$hell
    done
  fi

  print '#'"${headerinfo[1]:3}" > $filecombo
  for (( v=2; v <= 4; v++ ))
  do print '#'"${headerinfo[v]:3}" >> $filecombo
  done
  print '#' >> $filecombo
  print '#' $cdate >> $filecombo
  print '#' >> $filecombo
  if [[ $whatcom == 'sources' ]]
  then print '# The combined detection images '\'$prefix$dotsw'.det.*.an.m.fits'\'' were created as follows:' >> $filecombo
  else print '# The combined detection images '\'$prefix$dotfw'.det.*.an.m.fits'\'' were created as follows:' >> $filecombo
  fi
  print '#' >> $filecombo

  ix=0
  
  for (( i=1; i <= $nwaves; i++ ))
  do
    if [[ ${usefordetection[i]} == "yes" ]]
    then
      if [[ $ix -eq 0 ]]
      then ix=i
        print ' combined of '\'$prefix'.'${wave[i]}'.det.*.an.m.fits'\'\
              '(comboexp: '${comboexponent[i]:0:9}', combowei: '${comboweight[i]:0:9}')' >> $filecombo
      else 
        print '      and of '\'$prefix'.'${wave[i]}'.det.*.an.m.fits'\'\
              '(comboexp: '${comboexponent[i]:0:9}', combowei: '${comboweight[i]:0:9}')' >> $filecombo
      fi
    fi
  done

  combine_end=`date +%s`; combine_time=$(( combine_end - combine_beg ))
  'CALCULATE' comb_minutes "$combine_time/60" 3
  printlh; printlh ' '$script': '$comb_minutes' MINUTES'
  fun=$funo
} 
#___________________________________________________________________________________________________________________________________

DETECT_STRUCTURES ()
{                          
  local funo=$fun; fun='DETECT_STRUCTURES'; local title=$script': => ('$istep') '\'$fun\'
  local idetect; local catalog; local image; local jlastfp=999; local i; local j; local isegment; local jnsbm1
  local detwave; local detbeam; local ns1det; local lastscalecat=''
  local whatdet="$1"

  if [[ $detect == "no" || ($sources == 'no' && $filaments == 'no') || \
       ($sources == 'no' && $whatdet == 'sources') || ($filaments == 'no' && $whatdet == 'filaments') ]]
  then 
    if [[ $sources == 'yes' && $whatdet == 'sources' || $sources == 'no' && $whatdet == 'filaments' ]]
    then printlh; printlh ' '"$title"' ~~~> skipping...'
    fi
    fun=$funo; return 0
  else printlh; printlh ' '"$title"' '$whatdet
  fi
  detect_beg=`date +%s`; cdate=`date +%d\ %b\ %Y\ %a\ %H:%M:%S\ %Z`

  if [[ $whatdet == "sources" ]]
  then
    im1=0; allwaves=''  
    for (( i=1; i <= $nwaves; i++ ))
    do
      detwave[i]=${wave[i]}
      detbeam[i]=${beam[i]}
      if [[ ${usefordetsrc[i]} == "yes" ]]
      then allwaves=$allwaves' '${wave[i]}
      fi
    done
  
# Find the number of scales from decomposed file names.

    'READ_COMBINATION_FILE' $fileswcombining

    jnsbm1=$(( nsbeg - 1 ))
    detwave[jnsbm1]='0'
    detbeam[jnsbm1]=$beammincombosrc
    nscbeam[jnsbm1]='00.c0.0000as'
    image[jnsbm1]=$prefix$dotsw'.det'
    accufoots='sm.'${image[jnsbm1]}'.footprints.fits'
    swcatname='sm.'${image[jnsbm1]}'.cat'
    ($path'/modfits' multiply 0 ${detectionclone[1]} -o $accufoots $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          
# Define maximum scale up to which new sources are allowed to appear.

    'COMPARE_FLOATS' $srcmaxsizemax '=' '0.0' rslt

    if [[ $rslt -eq 1 ]]
    then
      nmaxscale4newsrc=$nsbeams
      nmaxscale4sfinder=$nsbeams
    else
      nmaxscale4newsrc=2
      'CALCULATE' srcscalemax "1*$srcmaxsizemax" 2
      for (( j=$nsbeg; j <= $nsbeams; j++ ))
      do
        'COMPARE_FLOATS' ${sbeam[j]} '<=' $srcscalemax rslt
        if [[ $rslt -eq 1 ]]
        then nmaxscale4newsrc=$j
        else break
        fi
      done
      nmaxscale4sfinder=2
      'CALCULATE' srcscalemax "2*$srcmaxsizemax" 2
      for (( j=$nsbeg; j <= $nsbeams; j++ ))
      do
        'COMPARE_FLOATS' ${sbeam[j]} '<=' $srcscalemax rslt
        if [[ $rslt -eq 1 ]]
        then nmaxscale4sfinder=$j
        else break
        fi
      done
    fi
    if [[ $nmaxscale4newsrc -lt 3 ]]
    then
      nmaxscale4newsrc=3
      nmaxscale4sfinder=$nsbeams
    fi
    
    if [[ $verb != "-verb0" ]]
    then
      'LEADZEROS' 1 $nmaxscale4newsrc znmaxscale4newsrc
      printlh; printlh ' '$script': '$fun': Largest scale for new sources: '$znmaxscale4newsrc
    fi
    if [[ $nsdet1 -eq 1 ]]
    then
      ns1det=$nsbeg
      jnsbm1=0
      jnsbm2=0
    else

# Restarting detection from an intermediate scale.

      ns1det=$nsdet1
      jnsbm1=$(( ns1det - 1 ))
      jnsbm2=$(( ns1det - 2 ))
      if [[ $jnsbm2 -le 0 ]]
      then jnsbm2=1
      fi
      detwave[jnsbm1]='0'
      detwave[jnsbm2]='0'
      detbeam[jnsbm1]=$beammincombosrc
      detbeam[jnsbm2]=$beammincombosrc
      image[jnsbm1]=$prefix$dotsw'.det'
      image[jnsbm2]=$prefix$dotsw'.det'
      accufoots='sm.'${image[jnsbm1]}'.footprints.fits'
      swcatname='sm.'${image[jnsbm1]}'.cat'
  
      for (( j=1; j <= $jnsbm1; j++ ))
      do
        if [[ $verb == "-verb0" ]]
        then 'PROGRESS_BAR' "DETECTING SOURCES" $j 1 $nmaxscale4sfinder 79 "·"; outsameline='yes'
        fi
        idetect=${image[jnsbm1]}'.'${nscbeam[j]}'.an'
        isegment='sm.seg.'${image[jnsbm1]}'.'${nscbeam[j]}
        catalog=$isegment'.cat'
        footprint=$isegment'.fp'
        if [[ -e $extractiondir'/'$footprint'.fits' ]]
        then
          ($path'/operate' $extractiondir'/'$footprint + $accufoots -o $accufoots $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          jlastfp=$j
        fi
      done
    fi
    
    zeroimage='no'
    idetecto=${image[jnsbm1]}'.'${nscbeam[jnsbm1]}'.an'
    isegmento='sm.seg.'${image[jnsbm1]}'.'${nscbeam[jnsbm1]}
    idetectoo=${image[jnsbm2]}'.'${nscbeam[jnsbm2]}'.an'
    catalogo=$isegmento'.cat'

    if [[ -e $extractiondir'/'$idetecto'.fits' ]]
    then \cp -f $extractiondir'/'$idetecto'.fits' $idetecto'.m.fits' #2>$hell
    fi
    if [[ -e $extractiondir'/'$idetectoo'.fits' ]]
    then \cp -f $extractiondir'/'$idetectoo'.fits' $idetectoo'.m.fits' #2>$hell
    fi
    if [[ -e $extractiondir'/'${idetecto/.an/.as}'.fits' ]]
    then \cp -f $extractiondir'/'${idetecto/.an/.as}'.fits' ${idetecto/.an/.as}'.m.fits' #2>$hell
    fi
    if [[ -e $extractiondir'/'${idetectoo/.an/.as}'.fits' ]]
    then \cp -f $extractiondir'/'${idetectoo/.an/.as}'.fits' ${idetectoo/.an/.as}'.m.fits' #2>$hell
    fi
  
    for (( j=$ns1det; j <= $nmaxscale4sfinder; j++ ))
    do
      jm1=$(( j - 1 )); if [[ $jm1 -le $ns1det ]]; then jm1=$ns1det; fi
      jm2=$(( j - 2 )); if [[ $jm2 -le $ns1det ]]; then jm2=$ns1det; fi
      idetect=${image[jnsbm1]}'.'${nscbeam[j]}'.an'
      isegment='sm.seg.'${image[jnsbm1]}'.'${nscbeam[j]}
      catalog=$isegment'.cat'
      footprint=$isegment'.fp'
      stdannuli=$isegment'.ra'
      
      if [[ $verb == "-verb0" ]]
      then 'PROGRESS_BAR' "DETECTING SOURCES" $j 1 $nmaxscale4sfinder 79 "·"
      fi
      \cp -f $extractiondir'/'$idetect'.fits' $idetect'.m.fits' #2>$hell
      ($path'/operate' $srcdetectingomask x $idetect'.m' -o $idetect'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/imgstat' savein -nomed $idetect'.m' $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
      read -r min max mea med totsum sig skew kurt nonzmin < '.+imgstat1'$cwavenum; chk_rc; \rm -f '.+imgstat1'$cwavenum 2>$hell
      'COMPARE_FLOATS' $min '=' '0.0' rsltn
      'COMPARE_FLOATS' $max '=' '0.0' rsltx
      'COMPARE_FLOATS' $sig '=' '0.0' rslts
      if [[ $rsltn -eq 1 && $rsltx -eq 1 && $rslts -eq 1 ]]
      then 
        if [[ $verb != "-verb0" ]]
        then printlh; printlh ' '$script': '$fun': WARNING: Zero detection image: skipping...'
        fi
        ns1det=$(( ns1det + 1 ))
        jnsbm1=$(( ns1det - 1 ))
        detwave[jnsbm1]='0'
        detbeam[jnsbm1]=$beammincombosrc
        nscbeam[jnsbm1]='00.c0.0000as'
        image[jnsbm1]=$prefix$dotsw'.det'
        zeroimage='yes'
      else
        zeroimage='no'
      fi
      if [[ $zeroimage == "no" ]]
      then
        \cp -f $extractiondir'/'${idetect/.an/.as}'.fits' ${idetect/.an/.as}'.m.fits' #2>$hell
  
        ($path'/operate' $srcdetectingomask x ${idetect/.an/.as}'.m' -o ${idetect/.an/.as}'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  
        if [[ $verb != "-verb0" ]]
        then
          printlh '_______________________________________________________________________________'
          printlh
          printlh '                                   SFINDER'
          printlh
          if [[ $nwaves -eq 1 ]]
          then printlh ' Extracting sources at wavelength:'$allwaves' µm'
          else printlh ' Extracting sources at wavelengths:'$allwaves' µm'
          fi
          printlh ' Smallest and largest scales to look for new sources: '$ns1det $nmaxscale4newsrc
          printlh ' Minimum intensity contrast for removing noise peaks: '$contranoise
          printlh ' Factor defining total footprint size from FWHM size: '$factortotal
          printlh '  Image at ancient scale: '$idetectoo'.m.fits'
          printlh ' Image at previous scale: '$idetecto'.m.fits'
          printlh '  Image at current scale: '$idetect'.m.fits'
          printlh '   Cat at previous scale: '$catalogo
          printlh '    Cat at current scale: '$catalog
          printlh '_______________________________________________________________________________'
        fi
    
# Delete catalogs and segmentation images left over from previous runs.

        \rm -f $catalog 2>$hell
        \rm -f $isegment'.fits' 2>$hell
        \rm -f $footprint'.fits' 2>$hell
      
# Extract sources.

        ($path'/sfinder' ${detwave[jnsbm1]} ${detbeam[jnsbm1]} $contranoise $factortotal $nmaxscale4newsrc $nmaxscale4sfinder \
                         $srcdetectingomask $idetect'.m' $idetecto'.m' $idetectoo'.m' $isegmento -o $isegment \
                         $verb; echo $? > '.rc'$cwavenum) | 'tehi' nocheck; rc=$?

        rcsfinder=$rc; chk_rc $rcsfinder
        if [[ -e '.allsourcesdone' ]]; then rcsfinder=9 ; \rm -f '.allsourcesdone'; fi
        if [[ -e '.toomanysources' ]]; then rcsfinder=89; \rm -f '.toomanysources'; fi
        if [[ -e '.notenoughmem73' ]]; then rcsfinder=73; \rm -f '.notenoughmem73'; fi
        if [[ -e '.notenoughmem74' ]]; then rcsfinder=74; \rm -f '.notenoughmem74'; fi
  
        if [[ $rcsfinder -eq 89 ]]
        then 'ERROR' 'Number of sources reached a pre-defined maximum NEXTRMAX.' \
                     'Increase the value of NEXTRMAX, recompile SFINDER, and restart ' \
                     'the detection from the current scale # '$j'.'
        elif [[ $rcsfinder -eq 73 || $rcsfinder -eq 74 ]]
        then 'ERROR' 'Trouble allocating memory ('$rcsfinder').' \
                     'Use a more powerful computer or reduce dimensions of arrays, recompile ' \
                     'SFINDER, and restart the detection from the current scale # '$j'.'
        fi
        if [[ $j -le $nmaxscale4newsrc ]]
        then rcsfinder=0
        fi
        if [[ $rcsfinder -ne '0' && $rcsfinder -ne '9' ]]
        then printlh; printlh ' '$script': '$fun': ERROR in SFINDER: rc='"$rcsfinder"; exit "$rcsfinder"
        fi
        
        if [[ -e $isegment'.fits' ]]
        then
          if [[ -e $footprint'.fits' ]]
          then
            ($path'/operate' $footprint + $accufoots -o $accufoots $verb; echo $? > '.rc'$cwavenum) | 'tehi'
            jlastfp=$j
          fi
          lastscalecat=$isegment'.cat'

# For scales which do not produce footprints it's not necessary to keep the files.
            
          if [[ $savespace -gt 1 ]]
          then
            if [[ ($jm1 -gt $jlastfp || $jlastfp -eq 999) && $j -gt $ns1det ]]
            then 
              \rm -f $isegmento'.fits' 2>$hell
              \rm -f $footprint'.fits' 2>$hell
              \rm -f $catalogo 2>$hell
            fi
          fi
          \rm -f $idetectoo'.m.fits' 2>$hell
          \rm -f ${idetectoo/.an/.as}'.m.fits' 2>$hell
          idetectoo=$idetecto
          idetecto=$idetect
          isegmento=$isegment
          catalogo=$catalog
        fi
      else
        \rm -f $idetect'.m.fits' 2>$hell
      fi
  
      if [[ $j -gt $nmaxscale4newsrc && $rcsfinder -eq 9 ]]
      then
        if [[ $verb != "-verb0" ]]
        then printlh; printlh ' '$script': '$fun': All sources extracted.'
        fi
        break
      fi
    done
  
    if [[ $verb == "-verb0" ]]
    then 'PROGRESS_BAR' 'complete' $j 1 $nmaxscale4sfinder 79 "·"; outsameline='no'
    fi
  
    if [[ $lastscalecat == "" ]]
    then printlh
      printlh ' '$script': '$fun': NO SOURCES?'
      printlh ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
      printlh ' INFO: Detection catalog not found - it seems no sources have been detected.'
      printlh '       '$script' will create one spurious source to allow further processing.'
      printlh ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
      if [[ $nwaves -eq 1 ]]
      then print 0 > ${dirmono[1]}'/'$prefix'.'${wave[1]}'.srcmaxsize'
      fi
      ($path'/modfits' multiply 0 ${detectionclone[1]} -o $idetect'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/modfits' multiply 0 ${detectionclone[1]} -o ${idetect/.an/.as}'.m' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  
      ($path'/sfinder' ${detwave[nmaxscale4sfinder]} ${detbeam[nmaxscale4sfinder]} 0.0d0 $factortotal $nmaxscale4newsrc \
                       $nmaxscale4sfinder $srcdetectingomask $idetect'.m' $idetecto'.m' $idetectoo'.m' $isegmento -o $isegment \
                       $verb; echo $? > '.rc'$cwavenum) | 'tehi' nocheck; rc=$?
  
      rcsfinder=$rc; chk_rc $rcsfinder
      if [[ -e '.allsourcesdone' ]]; then rcsfinder=9 ; \rm -f '.allsourcesdone'; fi
      if [[ -e '.toomanysources' ]]; then rcsfinder=89; \rm -f '.toomanysources'; fi
      if [[ -e '.notenoughmem73' ]]; then rcsfinder=73; \rm -f '.notenoughmem73'; fi
      if [[ -e '.notenoughmem74' ]]; then rcsfinder=74; \rm -f '.notenoughmem74'; fi
      if [[ $rcsfinder -ne '0' && $rcsfinder -ne '9' ]]
      then printlh
        printlh ' '$script': '$fun': ERROR in SFINDER: rc='"$rcsfinder"
        exit "$rcsfinder"
      fi
      \rm -f $idetect'.m.fits' 2>$hell
      \rm -f ${idetect/.an/.as}'.m.fits' 2>$hell
      lastscalecat=$isegment'.cat'
    fi

# Copy the last-scale catalog as the detection catalog.

    \mkdir -p $catalogs 2>$hell
    \cp -f $lastscalecat $swcatname #2>$hell
    \cp -f $swcatname $catalogs #2>$hell

# Remove remaining temporary images used for sources detection.

    \rm -f $idetecto'.m.fits' 2>$hell
    \rm -f $idetectoo'.m.fits' 2>$hell
    \rm -f ${idetecto/.an/.as}'.m.fits' 2>$hell
    \rm -f ${idetectoo/.an/.as}'.m.fits' 2>$hell

# Correct footprints by clearing them from image edges.

    'CLEAR_IMAGE_BORDERS' border 2 $accufoots $accufoots; chk_rc
  fi
  
# Detect filaments.

  if [[ $whatdet == "filaments" ]]
  then
    'READ_COMBINATION_FILE' $filefwcombining
    'FILAMENT_SCALES' $beammincombofil $filmaxsizemax
    'SKELETON_LEVELS'
    'CALCULATE' maxfilscale "4*$filmaxsizemax" 20
    'CALCULATE' maxglobscale "2*$filmaxsizemax" 20
    'CALCULATE' threepixels "3*sqrt($dxas*$dyas)" 20
    'COMPARE_FLOATS' $threepixels '>' $beammincombofil rcpix1
    'COMPARE_FLOATS' $threepixels '<=' $maxglobscale rcpix2
##    'COMPARE_FLOATS' $threepixels '<=' $filmaxsizemax rcpix2

    globscalemin=$beammincombofil
    globscalemax=$maxglobscale
##    globscalemax=$filmaxsizemax

    if [[ $rcpix1 -eq 1 && $rcpix2 -eq 1 ]]
    then globscalemin=$threepixels
    fi
    if [[ $rcpix2 -eq 0 ]]
    then 'CALCULATE' globscalemax "2*$threepixels" 20
    fi
    
    \mkdir -p $skeletons'/sscales'$dotfw 2>$hell
    \mkdir -p $skeletons'/+sdetect' 2>$hell
    \mkdir -p $skeletons 2>$hell
    
    for (( k=1; k <= $nsfils; k++ ))
    do
      'COMPARE_FLOATS' ${filscale[k]} '>=' $beammincombofil rcscalemin[k]
      'COMPARE_FLOATS' ${filscale[k]} '<=' $maxfilscale rcscalemax[k]
      'CALCULATE' scalemax[k] "1.001*${filscale[k]}*$factfilscale" 20
      'CALCULATE' scalemin[k] "0.999*${filscale[k]}/$factfilscale" 20

      if [[ ${rcscalemin[k]} -eq 1 && ${rcscalemax[k]} -eq 1 ]]
      then
        zk=${zfilscale[k]}'as'
        detfilamentzx[k]=$skeletons'/+sdetect/'$prefix$dotfw'.det.fil.'$zk
        detskeletonzx[k]=$skeletons'/'$prefix$dotfw'.det.ske.'$zk
        ($path'/modfits' multiply 0 ${detectionclone[1]} -o ${detfilamentzx[k]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/modfits' multiply 0 ${detectionclone[1]} -o ${detskeletonzx[k]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      fi
    done

##    obsskeletonall=$skeletons'/'$prefix$dotfw'.det.ske.all'
##    ($path'/modfits' multiply 0 ${detectionclone[1]} -o $obsskeletonall $verb; echo $? > '.rc'$cwavenum) | 'tehi'
    
    cleansk1='12'
    'CALCULATE' cleanskw "$cleansk1*$skeletonpixwidth" 20
    'ROUND_FLOAT' 0 $cleanskw cleanskw
  
    for (( j=$nsbeg; j <= $nsbeams; j++ ))
    do
      if [[ $verb == "-verb0" ]]
      then 'PROGRESS_BAR' "DETECTING FILAMENTS" $j $nsbeg $nsbeams 79 "·"; outsameline='yes'
      fi
      if [[ $j -gt $nsbeg ]]
      then
        sscimagefil=$prefix$dotfw'.det.'${nscbeam[j]}'.an'
##        obsskeleton=$skeletons'/'$prefix$dotfw'.det.ske'

        ($path'/imgstat' savein -nomed $sscimagefil $filcoaddedomask $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
        read -r min max mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
        'CHECK_IMGSTAT' $min $max '' $script $fun $funo '21'
        'COMPARE_FLOATS' $max '>' '0.0' rcnonzero

### Accumulate skeletons over all scales, with values of the combined detection image.
##
##        if [[ $rcnonzero -eq 1 ]]
##        then
##          'COMPARE_FLOATS' ${sbeam[j]} '>=' $globscalemin rslt0
##          'COMPARE_FLOATS' ${sbeam[j]} '<=' $globscalemax rslt1
##          
##          if [[ $rslt0 -eq 1 && $rslt1 -eq 1 ]]
##          then
##            ($path'/operate' $filcoaddedomask x $sscimagefil -o $obsskeleton $verb; echo $? > '.rc'$cwavenum) | 'tehi'
##            ($path'/modfits' skeleton1 1 $obsskeleton -o $obsskeleton $verb; echo $? > '.rc'$cwavenum) | 'tehi'
##            ($path'/modfits' clean8sk $cleansk1 0 $obsskeleton -o $obsskeleton $verb; echo $? > '.rc'$cwavenum) | 'tehi'
####            ($path'/modfits' thicken $obsskeleton -o $obsskeleton $verb; echo $? > '.rc'$cwavenum) | 'tehi'
####            ($path'/operate' $sscimagefil x $obsskeleton -o $obsskeleton $verb; echo $? > '.rc'$cwavenum) | 'tehi'
####            ($path'/operate' $obsskeletonall + $obsskeleton -o $obsskeletonall $verb; echo $? > '.rc'$cwavenum) | 'tehi'
##            \rm -f $obsskeleton'.fits' 2>$hell
##          fi
##        fi

# Shrink filcoaddedomask by a number of pixels equal to obsbeam radius to clean up image edges close to the mask border.

        'CALCULATE' nshrink "${sbeam[j]}/sqrt($dxas*$dyas)" 20
        'ROUND_FLOAT' 0 $nshrink nshrink
        \cp -f $filcoaddedomask'.fits' $filcoaddedomask'.shr.fits'; chk_rc
        filmaskshrunk=$filcoaddedomask'.shr'
        for (( k=1; k <= $nshrink; k++ ))
        do ($path'/modfits' contract $filmaskshrunk -o $filmaskshrunk $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        done
      
# Create scale-dependent skeletons over a range of scales within a factor of two.

        for (( k=1; k <= $nsfils; k++ ))
        do
          if [[ ${rcscalemin[k]} -eq 1 && ${rcscalemax[k]} -eq 1 ]]
          then
            zk=${zfilscale[k]}'as'
            sscimagejzk=$skeletons'/sscales'$dotfw'/'$prefix$dotfw'.det.'${nscbeam[j]}'.ske.'$zk
            'COMPARE_FLOATS' ${sbeam[j]} '<=' ${scalemax[k]} rslt0
            'COMPARE_FLOATS' ${sbeam[j]} '>=' ${scalemin[k]} rslt1
          
            if [[ $rcnonzero -eq 1 && $rslt0 -eq 1 && $rslt1 -eq 1 ]]
            then
              ($path'/operate' $filmaskshrunk x $sscimagefil -o $sscimagefil'.sk' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
              ($path'/operate' ${detfilamentzx[k]} + $sscimagefil'.sk' -o ${detfilamentzx[k]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
              ($path'/modfits' skeleton1 $skeletonpixwidth $sscimagefil'.sk' -o $sscimagejzk $verb; echo $? > '.rc'$cwavenum) | 'tehi'
              ($path'/modfits' clean8 $cleanskw 0 $sscimagejzk -o $sscimagejzk $verb; echo $? > '.rc'$cwavenum) | 'tehi'
              ($path'/operate' ${detskeletonzx[k]} + $sscimagejzk -o ${detskeletonzx[k]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
              \rm -f $sscimagefil'.sk.fits'  #2>$hell
            fi
          fi
        done
        \rm -f $filmaskshrunk'.fits'  #2>$hell
      fi
    done

##    ($path'/modfits' max 1 n $obsskeletonall -o $obsskeletonall'.n' $verb; echo $? > '.rc'$cwavenum) | 'tehi'

##    for (( k=1; k <= $nsfils; k++ ))
##    do
####      if [[ ${rcscalemin[k]} -eq 1 && ${rcscalemax[k]} -eq 1 ]]
####      then
##
##        zk=${zfilscale[k]}'as'
##        detfilamentzz=$skeletons'/'$prefix$dotfw'.det.filaments.'$zk
##        ($path'/modfits' multiply 0 ${detectionclone[1]} -o $detfilamentzz $verb; echo $? > '.rc'$cwavenum) | 'tehi'
##
##        for (( j=$nsbeams; j >= $nsbeg; j-- ))
##        do
##          sscimagefil=$prefix$dotfw'.det.'${nscbeam[j]}'.an'
##          'COMPARE_FLOATS' ${sbeam[j]} '>=' ${filscale[k]} rslt1
##
##          if [[ $rslt1 -eq 1 ]]
##          then
##            ($path'/operate' $filcoaddedomask x $sscimagefil -o $sscimagefil'.sk' $verb; echo $? > '.rc'$cwavenum) | 'tehi'
##            ($path'/operate' $detfilamentzz + $sscimagefil'.sk' -o $detfilamentzz $verb; echo $? > '.rc'$cwavenum) | 'tehi'
##            \rm -f $sscimagefil'.sk.fits' 2>$hell
##          fi  
##        done
####      fi
##    done
  

    if [[ $verb == "-verb0" ]]
    then 'PROGRESS_BAR' 'complete' $nsbeams $nsbeg $nsbeams 79 "·"; outsameline='no'
    fi

# Produce skeletons with increasing significances.
          
    nprogbar=0
    for (( k=1; k <= $nsfils; k++ ))
    do 
      if [[ ${rcscalemin[k]} -eq 1 && ${rcscalemax[k]} -eq 1 && -e ${detskeletonzx[k]}'.fits' ]]
      then 
        for (( kk=1; kk <= $nsklevs; kk++ ))
        do nprogbar=$(( nprogbar + 1 ))
        done
      fi
    done
    nprogbar=$(( nprogbar + 2 * nsklevs * nsfils ))
    nt=0
    for (( k=1; k <= $nsfils; k++ ))
    do 
      if [[ ${rcscalemin[k]} -eq 1 && ${rcscalemax[k]} -eq 1 && -e ${detskeletonzx[k]}'.fits' ]]
      then 
        for (( kk=1; kk <= $nsklevs; kk++ ))
        do
          nt=$(( nt + 1 ))
          if [[ $verb == "-verb0" ]]
          then 'PROGRESS_BAR' "COMPLETING SKELETONS" $nt 1 $nprogbar 79 "·"; outsameline='yes'
          fi
          'CALCULATE' sklevel "0.99*${nsklev[kk]}" 20
          detskelimage=${detskeletonzx[k]}'.s'${zsklev[kk]}
          ($path'/modfits' minimum $sklevel y ${detskeletonzx[k]} -o $detskelimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/modfits' skeleton1 1 $detskelimage -o $detskelimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/modfits' clean8sk $cleansk1 0 $detskelimage -o $detskelimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/modfits' segment8sk $cleansk1 $detskelimage -o $detskelimage $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        done
      fi
    done

    \rm -R $skeletons'/sscales'$dotfw 2>$hell

    cleansk1='12'

    'CALCULATE' imgmaxsizex "${sbeam[nsbeams]}/2" 20
    'COMPARE_FLOATS' $imgmaxsizex '<=' $beammincombofil rslt
    if [[ $rslt -eq 1 ]]
    then imgmaxsizex=$beammincombofil
    fi
    \mkdir -p $components 2>$hell
    \mkdir -p $skeletons'/+globals' 2>$hell
    \mkdir -p $results'/+filaments' 2>$hell
    
    detfilamen=$prefix$dotfw'.det'
    detskeletons=$skeletons'/'$detfilamen'.ske'

# Measure filaments using the preliminary version of scale-dependent skeletons.

    for (( k=1; k <= $nsfils; k++ ))
    do
      sign='-'
      zk=${zfilscale[k]}'as'
      'CALCULATE' nsklevs2 "$nsklevs*2" 0

      for (( kk=1; kk <= $nsklevs; kk++ ))
      do
        nt=$(( nt + 1 ))
        if [[ $verb == "-verb0" ]]
        then 'PROGRESS_BAR' "COMPLETING SKELETONS" $nt 1 $nprogbar 79 "·"; outsameline='yes'
        fi
        zkk=${zsklev[kk]}
        detskelimage=$detskeletons'.'$zk'.s'$zkk

        if [[ -e $detskelimage'.fits' ]]
        then
          ($path'/imgstat' savein -nomed $detskelimage $filcoaddedomask $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
          read -r min max mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
          'CHECK_IMGSTAT' $min $max '' $script $fun $funo '1'
          'COMPARE_FLOATS' $max '>' '0.0' rcnonzero
          if [[ $rcnonzero -eq 1 ]]
          then
            ($path'/fmeasure' $detskelimage $detskelimage $distancepc $sign$npxstep ${regcolx[1]} \
                              $results'/+filaments/~000' -o $detfilamen'.ske.'$zk'.s'$zkk $verb; \
                              echo $? > '.rc'$cwavenum) | 'tehi'
          else
            \rm -f $detskelimage'.fits' 2>$hell
          fi
        fi
      done
    done
    
# Derive accurate scale-dependent and global skeletons.

    fract='0.2'

    for (( kk=1; kk <= $nsklevs; kk++ ))
    do
      zkk=${zsklev[kk]}
      zn=${zfilscale[nsfils]}'as'
      globskels=$skeletons'/+globals/'$detfilamen'.skeletons.global.s'$zkk
      ($path'/modfits' multiply 0 $detskelimage -o $globskels $verb; echo $? > '.rc') | 'tehi'
    
      for (( k=1; k <= $nsfils; k++ ))
      do
        nt=$(( nt + 1 ))
        if [[ $verb == "-verb0" ]]
        then 'PROGRESS_BAR' "COMPLETING SKELETONS" $nt 1 $nprogbar 79 "·"; outsameline='yes'
        fi
        zk=${zfilscale[k]}'as'
        detskelimage=$skeletons'/'$detfilamen'.ske.'$zk'.s'$zkk
        catalog[k]=$results'/+filaments/+profiles/000/'$detfilamen'.ske.'$zk'.s'$zkk'~coords.cat'
        if [[ $k -eq 1 ]]
        then 
          catalog[0]=$results'/+filaments/+profiles/000/'$detfilamen'.ske.0000.s'$zkk'~coords.cat'
          \cp -f ${catalog[k]} ${catalog[0]}
        fi
        outskels[k]=$skeletons'/+globals/'$detfilamen'.skeletons.'$zk'.s'$zkk
        if [[ -e $detskelimage'.fits' ]]
        then
          ($path'/modfits' multiply 0 $detskelimage -o ${outskels[k]} $verb; echo $? > '.rc') | 'tehi'
          ($path'/fixskels' 0.0 ${catalog[k]} ${catalog[0]} ${outskels[k]} -o ${outskels[k]} $verb; echo $? > '.rc') | 'tehi'

          if [[ $k -lt $nsfils ]]
          then
            kp1=$(( k + 1 ))
            for (( m=$kp1; m <= $nsfils; m++ ))
            do
              zm=${zfilscale[m]}'as'
              detskelimage=$detskeletons'.'$zm'.s'$zkk
              catalog[m]=$results'/+filaments/+profiles/000/'$detfilamen'.ske.'$zm'.s'$zkk'~coords.cat'

              if [[ -e $detskelimage'.fits' ]]
              then ($path'/fixskels' $fract ${catalog[k]} ${catalog[m]} ${outskels[k]} -o ${outskels[k]} $verb; echo $? > '.rc') | 'tehi'
              fi
            done
          fi
          ($path'/modfits' clean8sk $cleansk1 0 ${outskels[k]} -o ${outskels[k]} $verb; echo $? > '.rc') | 'tehi'
          ($path'/modfits' segment8sk $cleansk1 ${outskels[k]} -o ${outskels[k]} $verb; echo $? > '.rc') | 'tehi'
          ($path'/fmeasure' ${outskels[k]} ${outskels[k]} 0 -1 ora . -o ${outskels[k]} $verb; echo $? > '.rc') | 'tehi'
          ($path'/operate' $globskels + ${outskels[k]} -o $globskels $verb; echo $? > '.rc') | 'tehi'
        fi
      done
      \rm -f ${catalog[0]} 2>$hell
    
      ($path'/modfits' segment8sk $cleansk1 $globskels -o $globskels $verb; echo $? > '.rc') | 'tehi'
      ($path'/fmeasure' $globskels $globskels 0 -1 ora . -o $globskels $verb; echo $? > '.rc') | 'tehi'
    done

    if [[ $verb == "-verb0" ]]
    then 'PROGRESS_BAR' 'complete' $nt 1 $nprogbar 79 "·"; outsameline='no'
    fi

    \rm -R $results'/+filaments/+profiles' 2>$hell
  
# Remove the following directories (*only if* they are empty).
      
    \rmdir $skeletons 2>$hell
  fi

  detect_end=`date +%s`; detect_time=$((detect_end - detect_beg))
  'CALCULATE' detect_minutes "$detect_time/60" 3
  printlh; printlh ' '$script': '$detect_minutes' MINUTES'
  fun=$funo
}

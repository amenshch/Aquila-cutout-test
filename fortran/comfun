POSITION ()
{
  local funo=$fun; fun='POSITION'
  if [[ $3 == "" ]]
  then 'ERROR' 'Too few parameters: "'$1'" "'$2'" "'$3'"'
  fi
  local substr=$1; local string=$2; local y
  lensub=${#substr}; lenstr=${#string}
  local dlen=$(( lenstr - lensub )); local i
  returnposition=0
  if [[ $lensub -le $lenstr ]]
  then
    for (( i=0; i <= $dlen; i++ ))
    do 
      if [[ "$substr" == "${string:$i:$lensub}" ]]
      then returnposition=$(( i + 1 )); break
      fi
    done
  fi
  y=\$"$3"; eval "$3=$returnposition"

  fun=$funo
}

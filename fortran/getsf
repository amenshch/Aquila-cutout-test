FINISH ()
{                                         
  local funo=$fun; fun='FINISH'; local title=$script': => ('$istep') '\'$fun\'
  printlh; printlh ' '$title
  local i; local j; local noisebgr=0; local position=0; local notdetec=0; local spurious=0; local substruc=0
  local totalbad=0; local totalgod=0; local finish_wait0; local finish_wait1; local finish_wait2
  
  infoline=' '\'$prefix\'' @'
  for (( i=1; i <= $nwaves; i++ ))
  do infoline=$infoline' '${wave[i]}
  done
  infoline=$infoline' µm'

  finish_beg=`date +%s`; finish_wait=0
                  
# Make sure all the files are readable by all (sometimes on some systems they are not).

  chmod a+r * 2>$hell

##  if [[ $measure == 'yes' && $filaments == 'yes' ]]
##  then
##    printlh
##    printlh ' '$script':'$infoline
##    printlh ' '$script':  ________________________________________________________________ '
##    printlh ' '$script': |                                                                |'
##    printlh ' '$script': |  Filaments were measured in all wavebands using the skeletons  |'
##    printlh ' '$script': |  obtained for automatically selected spatial scales.           |'
##    printlh ' '$script': |                                                                |'
##    printlh ' '$script': |  Measurements of filaments with different skeletons (obtained  |'
##    printlh ' '$script': |  on a spatial scale YYYY arcsec) can be added by running       |'
##    printlh ' '$script': |  FMEASURE (a GETSF utility) from your "results" subdirectory,  |'
##    printlh ' '$script': |  for example:                                                  |'
##    printlh ' '$script': |                                                                |'
##    printlh ' '$script': |  fmeasure +components/'$prefix'.WWW.obs.filaments \'
##    printlh ' '$script': |           +skeletons/'$prefix'.*.det.ske.YYYYas.s0'$skelsig' \'
##    printlh ' '$script': |           '$distancepc' 1 '${rcolx[1]}' +filaments'
##    printlh ' '$script': |                                                                |'
##    printlh ' '$script': |  Run FMEASURE without parameters to see the usage information. |'
##    printlh ' '$script': |________________________________________________________________|'
##  fi

# Produce statistics for sources in the semifinal catalog; the summary file should have been created by FINALCAT.

  if [[ -e '+log.SUMMARY' && ($visualize == "yes" && $sources == "yes") ]]
  then
    {
    read -r name totalbad; read -r name noisebgr; read -r name notdetec; read -r name spurious
    read -r name position; read -r name toolarge; read -r name totalgod; read -r name substruc
    for (( i=1; i <= $nwaves; i++ ))
    do read -r name fwhmmax[i]
    done
    } < '+log.SUMMARY'
    
    lenbad=${#totalbad}; lennoi=${#noisebgr}; lenpos=${#position}; lenbig=${#toolarge}
    lendet=${#notdetec}; lenspu=${#spurious}; lensub=${#substruc}; lentot=${#totalgod}
    if [[ $lentot -gt $lenbad ]]; then lenmax=$lentot; else lenmax=$lenbad; fi
    lenbx=$(( lenmax - lenbad )); if [[ $lenbx -gt 0 ]]; then for (( i=1; i <= lenbx; i++ )); do totalbad=' '"$totalbad"; done; fi
    lennx=$(( lenmax - lennoi )); if [[ $lennx -gt 0 ]]; then for (( i=1; i <= lennx; i++ )); do noisebgr=' '"$noisebgr"; done; fi
    lendx=$(( lenmax - lendet )); if [[ $lendx -gt 0 ]]; then for (( i=1; i <= lendx; i++ )); do notdetec=' '"$notdetec"; done; fi
    lensx=$(( lenmax - lenspu )); if [[ $lensx -gt 0 ]]; then for (( i=1; i <= lensx; i++ )); do spurious=' '"$spurious"; done; fi
    lenpx=$(( lenmax - lenpos )); if [[ $lenpx -gt 0 ]]; then for (( i=1; i <= lenpx; i++ )); do position=' '"$position"; done; fi
    lenlx=$(( lenmax - lenbig )); if [[ $lenlx -gt 0 ]]; then for (( i=1; i <= lenlx; i++ )); do toolarge=' '"$toolarge"; done; fi
    lentx=$(( lenmax - lentot )); if [[ $lentx -gt 0 ]]; then for (( i=1; i <= lentx; i++ )); do totalgod=' '"$totalgod"; done; fi
    lenux=$(( lenmax - lensub )); if [[ $lenux -gt 0 ]]; then for (( i=1; i <= lenux; i++ )); do substruc=' '"$substruc"; done; fi
    chorline=''; for (( i=1; i <= lenmax; i++ )); do chorline='_'"$chorline"; done
    cverline=''; for (( i=1; i <= lenmax; i++ )); do cverline=' '"$cverline"; done
    printlh
    printlh ' '$script':'$infoline
    printlh ' '$script':  ____________________________'"$chorline"'__ '
    printlh ' '$script': |                            '"$cverline"'  |'
    printlh ' '$script': |   BAD DETECTIONS EXCLUDED: '"$totalbad"'  |'
    printlh ' '$script': |                            '"$cverline"'  |'
    printlh ' '$script': |       Background or noise: '"$noisebgr"'  |'
    printlh ' '$script': |  Too few detectable waves: '"$notdetec"'  |'
    printlh ' '$script': |    Likely spurious source: '"$spurious"'  |'
    printlh ' '$script': |      Position is occupied: '"$position"'  |'
    printlh ' '$script': |       Larger than desired: '"$toolarge"'  |'
    printlh ' '$script': |                            '"$cverline"'  |'
    printlh ' '$script': |         EXTRACTED SOURCES: '"$totalgod"'  |'
    printlh ' '$script': |                            '"$cverline"'  |'
    printlh ' '$script': |            Sub-structured: '"$substruc"'  |'
    printlh ' '$script': |____________________________'"$chorline"'__|'
    printlh ' '$script':'
    lensizmax=0
    lenfilmax=0
    for (( i=1; i <= $nwaves; i++ ))
    do
      'ROUND_FLOAT' 1 ${fwhmmax[i]} fwhmmax[i]
      print ${fwhmmax[i]} > $prefix'.'${wave[i]}'.srcmaxsize'
      if [[ -e ${monofback[i]}'/'${detectionclone[i]}'.filmaxsize' ]]
      then 
        { read -r filmaxx[i] 
        } < ${monofback[i]}'/'${detectionclone[i]}'.filmaxsize'
      else
        filmaxx[i]=0
      fi
      lensiz=${#fwhmmax[i]}; if [[ $lensiz -gt $lensizmax ]]; then lensizmax=$lensiz; fi
      lenfil=${#filmaxx[i]}; if [[ $lenfil -gt $lenfilmax ]]; then lenfilmax=$lenfil; fi
    done
    for (( i=1; i <= $nwaves; i++ ))
    do
      lensiz=${#fwhmmax[i]}; lens=$(( lensizmax - lensiz ))
      lenfil=${#filmaxx[i]}; lenf=$(( lenfilmax - lenfil ))
      if [[ $lens -gt 0 ]]; then for (( l=1; l <= lens; l++ )); do fwhmmax[i]=' '"${fwhmmax[i]}"; done; fi
      if [[ $lenf -gt 0 ]]; then for (( l=1; l <= lenf; l++ )); do filmaxx[i]=' '"${filmaxx[i]}"; done; fi
      printlh ' '$script': Largest source & filament at '${wave[i]}' µm (FWHM): '"${fwhmmax[i]}"' & '"${filmaxx[i]}"' arcsec'
    done
  fi

  if [[ $sources == 'yes' && $measure == "yes" ]]
  then
    allfootexpanded='yes'
    for (( i=1; i <= $nwaves; i++ ))
    do if [[ ! -e '+wave.'${wave[i]}'.foot' ]]; then allfootexpanded='no'; fi
    done
    if [[ $allfootexpanded == 'no' ]]
    then
      printlh ' '$script':  ________________________________________________________________ '
      printlh ' '$script': |                                                                |'
      printlh ' '$script': | WARNING: EXPANSION/SHRINKAGE OF SOME FOOTPRINTS NOT COMPLETED! |'
      printlh ' '$script': | You might need to increase the maximum number of measurement   |'
      printlh ' '$script': | iterations above the default value in the configuration file.  |'
      printlh ' '$script': |________________________________________________________________|'
    fi
  fi

# Determine if the current run is an additional for measurements of smaller scales.

  maxsz=''; awavz=''
  for (( i=1; i <= $nwaves; i++ ))
  do 
    detfilamen=$prefix$dotfw'.det'
    nsf=0
    for fname in $skeletons'/'$detfilamen'.ske.'????'as.fits'
    do
      nsf=$(( nsf + 1 ))
      skelsmax="${fname/as.fits/}"
      skelsmax=${skelsmax/$skeletons\/$detfilamen'.ske.'/}
    done
    zfilmaxs=${zfilmaxsize[i]/.s/}
    zfilmaxs=${zfilmaxs/as/}
##    'LEADZEROS' 3 $zfilmaxs zfilmaxs
    'COMPARE_FLOATS' $zfilmaxs '<' $skelsmax rslt
    if [[ $rslt -eq 1 ]]
    then additionalscale='yes'
    else additionalscale='no'
    fi
    if [[ $additionalscale == 'yes' ]]
    then maxsz=$maxsz' '${filmaxsize[i]}; awavz=$awavz' '${wave[i]}
    fi
  done

  if [[ $maxsz != '' ]]
  then
    maxsz=$maxsz' arcsec @'
    awavz=$awavz' µm'
    printlh ' '$script':  ________________________________________________________________ '
    printlh ' '$script': |                                                                |'
    if [[ $nwaves -eq 1 ]]
    then 
    printlh ' '$script': | MEASURED BACKGROUND-SUBTRACTED FILAMENTS ON ADDITIONAL SCALE   |'
    printlh ' '$script': | matching maxsize of'$maxsz''$awavz
    else 
    printlh ' '$script': | MEASURED BACKGROUND-SUBTRACTED FILAMENTS ON ADDITIONAL SCALES  |'
    printlh ' '$script': | matching maxsizes of'$maxsz''$awavz
    fi
    printlh ' '$script': |________________________________________________________________|'
  fi

# Clean up to save disk space.
  
  answer=''
  if [[ $savespace -eq 2 && ($measure == "yes" || $visualize == "yes" || \
       ($separate == 'no' && $flatten == 'no' && $complete == "no" && \
        $combine == "no" && $detect == "no" && $measure == "no" && $visualize == "no")) ]]
  then
    finish_wait1=`date +%s`
    waitingforinput='yes'
    'CLEAR_STDIN'
    answer='n'
    if [[ $delete == 'yes' || $delete != 'no' ]]
    then
      printlh ' '$script':  ________________________________________________________________ '
      printlh ' '$script': |                                                                |'
      printlh ' '$script': | In "+getsf.cfg", you have SAVESPACE = 2, which means that you  |'
      printlh ' '$script': | request removal of unnecessary files and directories from this |'
      printlh ' '$script': | extraction.                                                    |'
      printlh ' '$script': |________________________________________________________________|'
      printlh ' '$script':'
    fi
    if [[ $delete == 'yes' ]]
    then
      answer='y'
      printhn     ' '$script': Deleting unnecessary files (you said yes in the config)...'
      printf "%b" ' '$script': Deleting unnecessary files (you said yes in the config)...' >> $logfile
    elif [[ $delete != 'no' ]]
    then
      printhn     ' '$script': Delete unnecessary files (timeout 12 hrs) (y/N)?: '
      printf "%b" ' '$script': Delete unnecessary files (timeout 12 hrs) (y/N)?: ' >> $logfile
      read -r -s -t 43200 answer; rc=$?
      waitingforinput='no'
      if [[ $rc -eq 1 ]]; then answer='?'; fi
      if [[ ${answer:0:1} == "y" || ${answer:0:1} == "Y" ]]
      then answer='y'; printlh 'yes!'; printhn ' '$script': Deleting...'
      elif [[ ${answer:0:1} == "n" || ${answer:0:1} == "N" ]]
      then answer='n'; printlh 'no!'
      else answer='n'; printlh 'assuming no!'
      fi  
    fi
    finish_wait2=`date +%s`
    finish_wait=$(( finish_wait2 - finish_wait1 ))

    \rmdir $separated'/+filaments_partial' 2>$hell   #<-- It will only be removed if empty.

    if [[ $answer == "y" ]]
    then 
      for (( i=1; i <= $nwaves; i++ ))
      do 
        \rm -f ${dirmono[i]}'/'*'.c'??????'as.fits' 2>$hell
        \rm -f ${dirmono[i]}'/'*'.omask.fits' 2>$hell
        \rm -f ${dirmono[i]}'/'*'.obs.fits' 2>$hell
        \rm -f ${monosback[i]}'/'*'.'??.?'.fits' 2>$hell
        \rm -f ${monofback[i]}'/'*'.'??.?'.fits' 2>$hell
        \rm -f ${monoffact[i]}'/'*'.'??.?'.fits' 2>$hell
        \rm -f ${monodetbg[i]}'/'*'.'??.?'.fits' 2>$hell
        \rm -R ${monoworks[i]} 2>$hell
        \rm -f $prefix'.'${wave[i]}'.det.'??'.c'??????'as.fits' 2>$hell
        \rm -f $prefix'.'${wave[i]}'.det.fits' 2>$hell
        \rm -f $prefix'.'${wave[i]}'.omask.fits' 2>$hell
        \rm -f $prefix'.'${wave[i]}'.det.'??'.c'??????'as.'??'.fits' 2>$hell
        \rm -f $prefix'.'${wave[i]}'.det.'??'.c'??????'as.fits' 2>$hell
        \rm -f $srciterate'/'*'.'${wave[i]}'.'*'.fits' 2>$hell
        \rm -f $prefix'.combining.'${wave[i]}'.omask.fits' 2>$hell
      done
      \rm -f $prefix.*'.coadded.omask.fits' 2>$hell
      \rmdir $skeletons'/sscales'$dotfw 2>$hell
      \rm -f $prefix$dotsw'.det.'*'.an.fits' 2>$hell
      \rm -f $prefix$dotsw'.det.'*'.as.fits' 2>$hell
      \rm -f $prefix$dotfw'.det.'*'.an.fits' 2>$hell
      \rm -f 'sm.seg.'$prefix$dotsw'.det.'*'.fits' 2>$hell
      \rm -f *'.subsfp.fits' 2>$hell
      \rm -f *'.sum.hi.fits' 2>$hell
      \rm -f 'bigfoot.'*'.fits' 2>$hell
      \rm -f 'flatfoot.'*'.fits' 2>$hell
      printlh ' done.'
    fi
  fi
    
  finish_end=`date +%s`; finish_time=$(( finish_end - finish_beg - finish_wait ))
  'CALCULATE' finish_minutes "$finish_time/60" 3
  printlh; printlh ' '$script': '$finish_minutes' MINUTES'

  fun=$funo
}

PARTIAL_IMAGES ()
{                          
  local funo=$fun; fun='PARTIAL_IMAGES'; local title=$script': => '\'$fun\'

  if [[ $verb != "-verb0" ]]
  then printlh; printlh ' '$title
  fi

  if [[ $itcf -eq 1 ]]
  then 
    if [[ $istr -eq 1 ]]
    then 
      \mkdir -p $separated'/+obsimage_partial' 2>$hell
      detfullimage=$separated'/+obsimage_partial/'${detectionclone[i]}
    else
      \mkdir -p $separated'/+filaments_partial' 2>$hell
      detfullimage=$separated'/+filaments_partial/'${detectionclone[i]}
    fi
  fi
  ($path'/modfits' multiply 0 ${detectionclone[i]} -o $detfilamentz $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  ($path'/modfits' multiply 0 ${detectionclone[i]} -o $detsourcesso $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  if [[ $itcf -eq $itcleanmax ]]
  then ($path'/modfits' multiply 0 ${detectionclone[i]} -o $detfilaments $verb; echo $? > '.rc'$cwavenum) | 'tehi'
  fi
  
  'FILAMENT_SCALES' ${beam[i]} ${filmaxsize[i]}
  
  if [[ ($istr -le 2) && $itcf -eq 1 ]]      ## || $istep -eq 1
  then
    for (( k=1; k <= $nsfils; k++ ))
    do
      'COMPARE_FLOATS' ${filscale[k]} '<=' ${sbeam[nsbeams]} rslt
      if [[ $rslt -eq 1 ]]
      then 
        detfullimagex[k]=$detfullimage'.'${zfilscale[k]}'as'
        ($path'/modfits' multiply 0 ${detectionclone[i]} -o ${detfullimagex[k]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      fi
    done
  fi

# To properly accumulate reconstructed filaments, one needs a loop backwards (with ), otherwise some faint 
# small-scale filaments may be "eaten" by the negative areas around bright large-scale features.

  if [[ $nwaves -eq 1 ]]; then iw=''; else iw=$i; fi
    
  for (( jx=$nsbeg; jx <= $nsbeams; jx++ ))
  do
    j=$(( nsbeams - jx + nsbeg ))
    
    if [[ $verb == "-verb0" ]]
    then 
      outsameline='yes'
      if [[ $istep -eq 0 ]]
      then 
        if [[ $istr -eq 1 ]]; then 'PROGRESS_BAR' "DERIVING SBACKGROUND $iw" $jx $nsbeg $nsbeams 79 "-"; fi
        if [[ $istr -eq 2 ]]; then 'PROGRESS_BAR' "DERIVING FBACKGROUND $iw" $jx $nsbeg $nsbeams 79 "-"; fi
        if [[ $istr -eq 3 ]]; then 'PROGRESS_BAR' "DERIVING SFLATFACTOR $iw" $jx $nsbeg $nsbeams 79 "-"; fi
        if [[ $istr -eq 4 ]]; then 'PROGRESS_BAR' "DERIVING FFLATFACTOR $iw" $jx $nsbeg $nsbeams 79 "-"; fi
      else 
        'PROGRESS_BAR' "DERIVING FLATSOURCES $iw" $jx $nsbeg $nsbeams 79 "-"
      fi
    fi
    sscimagej=${dirmono[i]}'/'${detectionclone[i]}'.'${nscbeam[j]}
    sscimagejfb=${monoworks[i]}'/'${detectionclone[i]}'.'${nscbeam[j]}'.fb'
    sscimagejsa=${monoworks[i]}'/'${detectionclone[i]}'.'${nscbeam[j]}'.sa'

    if [[ -e $sscimagejfb'.fits' ]]
    then
      ($path'/operate' $detsourcesso + $sscimagejsa -o $detsourcesso $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      ($path'/modfits' minimum 0 y $detsourcesso -o $detsourcesso $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      \rm -f $sscimagejsa'.fits' 2>$hell
  
      if [[ $itcf -eq $itcleanmax ]]
      then
        ($path'/operate' $detfilaments + $sscimagejfb -o $detfilaments $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        ($path'/modfits' minimum 0 y $detfilaments -o $detfilaments $verb; echo $? > '.rc'$cwavenum) | 'tehi'
      fi
    fi

# Accumulate full decomposed images - total and in several limited ranges of scales.

    if [[ ($istr -le 2) && $itcf -eq 1 && -e $sscimagej'.fits' ]]   ## || $istep -eq 1
    then
      for (( k=1; k <= $nsfils; k++ ))
      do
        'CALCULATE' filscalehi "1.001*${filscale[k]}" 20
        'COMPARE_FLOATS' ${sbeam[j]} '<=' $filscalehi rslt1
        'COMPARE_FLOATS' ${filscale[k]} '<=' ${sbeam[nsbeams]} rslt2
        if [[ $rslt1 -eq 1 && $rslt2 -eq 1 ]] 
        then 
          ($path'/operate' ${detfullimagex[k]} + $sscimagej -o ${detfullimagex[k]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
          ($path'/modfits' minimum 0 y ${detfullimagex[k]} -o ${detfullimagex[k]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        fi
      done
    fi

# Some cleaning (removal of irrelevant single-scale images).

    if [[ $j -gt ${lastgoodscale[i]} && $foundgoodscales == 'yes' && $savespace -eq 2 ]]
    then \rm -f $sscimagej'.'[anr][ne]'.fits' 2>$hell
    fi
  done

# Finalize and remove empty images.

  if [[ ($istr -le 2) && $itcf -eq 1 ]]   ## || $istep -eq 1
  then
    for (( k=1; k <= $nsfils; k++ ))
    do
      if [[ -e ${detfullimagex[k]}'.fits' ]]
      then 
        ($path'/imgstat' savein -nomed ${detfullimagex[k]} ${imageomask[i]} $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'
        read -r min maxim mea med totsum sig skew kurt nonzmin edgemean < '.+imgstat2'$cwavenum; chk_rc
        'CHECK_IMGSTAT' $min $maxim '' $script $fun $funo '21'
        'COMPARE_FLOATS' $maxim '>' '0.0' rcnonzero
        if [[ $rcnonzero -eq 1 ]]
        then ($path'/operate' ${imageomask[i]} x ${detfullimagex[k]} -o ${detfullimagex[k]} $verb; echo $? > '.rc'$cwavenum) | 'tehi'
        else \rm -f ${detfullimagex[k]}'.fits' 2>$hell
        fi
      fi
    done
  fi

  fun=$funo
}

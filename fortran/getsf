CLEANING_MINPIX ()
{
  local funo=$fun; fun='CLEANING_MINPIX'
  if [[ $2 == "" ]]
  then 'ERROR' 'Too few parameters: "'$1'" "'$2'"'
  fi
  local beam=$1; local j=$2

  'COMPARE_FLOATS' ${sbeam[j]} '<' $beam rslt

  if [[ $rslt -eq 1 ]]
  then 'CALCULATE' beamsratio "${sbeam[j]}/$beam" 20
  else beamsratio='1'
  fi

# v191122: This is an empirical dependence of the zero-radius (where the positives 
# cross into negatives) found from a single-scale-decomposed Gaussian peak:
# FACTORSB (= SSRZERO / SBEAM) = 0.3 / (SBEAM / BEAM)^1.35 + 0.56

  'CALCULATE' factorsb "0.33/e(l($beamsratio)*1.34)+0.59" 20

# v191126: This is an empirical dependence of the zero1stderivative-radius (where the 
# negatives reach a minimum) found from a single-scale-decomposed Gaussian peak:
# SS1DZERO / SBEAM = SQRT(2) * (SSRZERO / SBEAM)
# For compact sources, it is more efficient to clip into the negative levels as much 
# as possible using the SS1DZERO radius, therefore CLEANMINPIX has a factor of SQRT(2).

##  'CALCULATE' ss1dzero[j] "sqrt(2)*$factorsb*${sbeam[j]}" 20

# v200505: Clipping of negatives is not done anymore. Therefore, the above factor of 
# SQRT(2) is not relevant and is removed. Now the clipping is done even not to zero level,
# but to XLEVEL, so the area is somewhat smaller, hence the (arbitrary) factor of 0.75.

  'CALCULATE' ssrzero[j] "0.75*$factorsb*${sbeam[j]}" 20

  'CALCULATE' cleanminpix[j] "3.14159*${ssrzero[j]}^2/$sqpixas" 20
  'ROUND_FLOAT' 0 ${cleanminpix[j]} cleanminpix[j]
  
  fun=$funo
}

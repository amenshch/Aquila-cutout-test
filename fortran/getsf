GET_IMAGE_PIXELS ()
{
  local funo=$fun; fun='GET_IMAGE_PIXELS'; local title=$script': => '\'$fun\'
  local image=${detectionclone[1]}

# Get the numbers of pixels in both dimensions (from sky at the 1st wavelength).
  
  ($path'/readhead' save NAXIS1 NAXIS2 $image $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'

  read -r naxis1 nx naxis2 ny < '.+readhead'$cwavenum; chk_rc; \rm -f '.+readhead'$cwavenum 2>$hell

  if [[ $nx -le $ny ]]; then pixmin=$nx; else pixmin=$ny; fi             
  if [[ $nx -ge $ny ]]; then pixmax=$nx; else pixmax=$ny; fi             

  'CALCULATE' thickell "$pixmax/200" 2
  'COMPARE_FLOATS' $thickell '<' '2.0' rslt
  if [[ $rslt -eq 1 ]]
  then thickell='2.0'
  fi
  'ROUND_FLOAT' 0 $thickell thickell

  'CALCULATE' thickske "$pixmax/800/3" 2
##  'COMPARE_FLOATS' $thickske '<' '1.0' rslt
##  if [[ $rslt -eq 1 ]]
##  then thickske='1.0'
##  fi
  'CALCULATE' thickske2 "$thickske*2" 2
  'COMPARE_FLOATS' $thickske2 '<' '1.0' rslt
  if [[ $rslt -eq 1 ]]
  then thickske2='1.0'
  fi
  'ROUND_FLOAT' 0 $thickske thickske
  'ROUND_FLOAT' 0 $thickske2 thickske2

# Get the pixel sizes in both dimensions (in degrees).
  
  ($path'/readhead' save CDELT1 CDELT2 $image $verb$cwavenum; echo $? > '.rc'$cwavenum) | 'tehi'

  read -r cdelt1 dx cdelt2 dy < '.+readhead'$cwavenum; chk_rc; \rm -f '.+readhead'$cwavenum 2>$hell
  if [[ ${dx:0:1} == "-" ]]; then dx=${dx:1}; fi                        

  'SCIENTIFIC2FIXED' $dx dx
  'SCIENTIFIC2FIXED' $dy dy

# Convert pixel and image sizes in arcseconds and degrees.

  'CALCULATE' dxas "$dx*3600" 20
  'CALCULATE' dyas "$dy*3600" 20
  'CALCULATE' sidexas "$nx*$dxas" 20
  'CALCULATE' sideyas "$ny*$dyas" 20
  'CALCULATE' sidexdg "$nx*$dx" 20
  'CALCULATE' sideydg "$ny*$dy" 20
  'CALCULATE' sqpixas "$dxas*$dyas" 20
  
  fun=$funo
}

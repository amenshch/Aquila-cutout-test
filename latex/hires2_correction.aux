\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The method step by step. The first group is the calibration, which is done once and yields the temperature relation of Eq.~(\ref {eq:law}). The second is the calculation of Sect.~\ref {sec:factor}, repeated for every trial surface density, which yields the table of the correction factor against the surface density that an observed image actually holds. Its last step calibrates the low surface densities on a radiative transfer model of a diffuse cloud (Sect.~\ref {sec:diffuse}). The third group is what is then done to an image, at any resolution.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:method}{{3}{5}{The method step by step. The first group is the calibration, which is done once and yields the temperature relation of Eq.~(\ref {eq:law}). The second is the calculation of Sect.~\ref {sec:factor}, repeated for every trial surface density, which yields the table of the correction factor against the surface density that an observed image actually holds. Its last step calibrates the low surface densities on a radiative transfer model of a diffuse cloud (Sect.~\ref {sec:diffuse}). The third group is what is then done to an image, at any resolution}{figure.3}{}}
\@LN@col{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The correction factor against the surface density of the uncorrected image, for a uniform plane-parallel layer, for a cube, for a uniform sphere, and for the average of the sphere and the layer. The dotted curve uses the column along the shortest path instead of the angular average (Appendix~\ref {app:shape}). The solid black curve is the adopted relation. Below $10^{21.6}$\,cm$^{-2}$ it replaces the analytic layer by a radiative transfer model of a diffuse cloud (Sect.~\ref {sec:diffuse}).}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:relation}{{4}{5}{The correction factor against the surface density of the uncorrected image, for a uniform plane-parallel layer, for a cube, for a uniform sphere, and for the average of the sphere and the layer. The dotted curve uses the column along the shortest path instead of the angular average (Appendix~\ref {app:shape}). The solid black curve is the adopted relation. Below $10^{21.6}$\,cm$^{-2}$ it replaces the analytic layer by a radiative transfer model of a diffuse cloud (Sect.~\ref {sec:diffuse})}{figure.4}{}}
\@LN@col{2}
\newlabel{eq:invariance}{{11}{5}{Why the shape hardly matters}{equation.11}{}}
